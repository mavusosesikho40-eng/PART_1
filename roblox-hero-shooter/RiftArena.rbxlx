				SpeedBoost = 0.35,
			},
		},
		Bot = { PreferredRange = 6, Ability1 = "Engage", Ability2 = "AttackClose", Ultimate = "AttackClose" },
	},

	----------------------------------------------------------------------------
	Lumen = {
		Id = "Lumen",
		DisplayName = "Lumen",
		Role = "Support",
		Tagline = "No one falls on my watch.",
		Description = "A light-weaver who heals allies with mending bolts and turns fights with a sanctuary of light.",
		Color = Color3.fromRGB(210, 170, 60),
		AccentColor = Color3.fromRGB(255, 235, 140),
		MaxHealth = 275,
		WalkSpeed = 16,
		JumpHeight = 7.2,
		UltCost = 2400,
		Primary = {
			Name = "Mending Bolts",
			Description = "Bolts heal the allies they hit and damage enemies.",
			Kind = "Projectile",
			Damage = 18,
			Heal = 30,
			ProjectileSpeed = 150,
			ProjectileGravity = 0,
			ProjectileRadius = 0.9,
			FireRate = 3,
			Automatic = true,
			Range = 150,
			MagazineSize = 20,
			ReloadTime = 1.6,
			TracerColor = Color3.fromRGB(255, 235, 140),
		},
		Abilities = {
			Ability1 = {
				Name = "Radiant Pulse",
				Icon = "✚",
				Description = "Instantly heal yourself and nearby allies.",
				Cooldown = 9,
				Radius = 20,
				Heal = 80,
			},
			Ability2 = {
				Name = "Tailwind",
				Icon = "»",
				Description = "You and nearby allies move 30% faster for 4 seconds.",
				Cooldown = 14,
				Radius = 22,
				SpeedBoost = 0.3,
				Duration = 4,
			},
			Ultimate = {
				Name = "Sanctuary",
				Icon = "✦",
				Description = "Create a zone of light that rapidly heals allies and reduces the damage they take.",
				Radius = 20,
				Duration = 7,
				HealPerSecond = 55,
				DamageReduction = 0.2,
			},
		},
		Bot = { PreferredRange = 26, Ability1 = "HealAllies", Ability2 = "Travel", Ultimate = "TeamUlt" },
	},
}

-- Order heroes appear on the hero select screen.
Heroes.Order = { "Bulwark", "Kestrel", "Volta", "Kaida", "Lumen" }

-- The three ability slots every hero has, in HUD order.
Heroes.AbilitySlots = { "Ability1", "Ability2", "Ultimate" }

function Heroes.Get(id)
	if typeof(id) ~= "string" then
		return nil
	end
	return Heroes.Definitions[id]
end

function Heroes.GetOrdered()
	local list = {}
	for _, id in Heroes.Order do
		local hero = Heroes.Definitions[id]
		if hero then
			table.insert(list, hero)
		end
	end
	return list
end

return Heroes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">MotionUtil</string>
          <string name="Source"><![CDATA[--[[
	MotionUtil
	==========
	Moves a character for dashes, leaps and knockback.

	Roblox lets each player's own computer simulate their character's physics, so a velocity set by
	the server would simply be overwritten. That is why the server asks the owning client to run
	these (see MotionService and CombatController). Bots are simulated by the server, so the server
	calls these directly for them.
]]

local Debris = game:GetService("Debris")

local MotionUtil = {}

local function getAttachment(root: BasePart): Attachment
	local attachment = root:FindFirstChild("MotionAttachment")
	if not attachment then
		attachment = Instance.new("Attachment")
		attachment.Name = "MotionAttachment"
		attachment.Parent = root
	end
	return attachment
end

-- Drives the character at `velocity` for `duration` seconds, ignoring normal movement.
function MotionUtil.Dash(character: Model, velocity: Vector3, duration: number)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return
	end
	local existing = root:FindFirstChild("DashVelocity")
	if existing then
		existing:Destroy()
	end

	local mover = Instance.new("LinearVelocity")
	mover.Name = "DashVelocity"
	mover.Attachment0 = getAttachment(root)
	mover.RelativeTo = Enum.ActuatorRelativeTo.World
	mover.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	mover.MaxForce = math.huge
	mover.VectorVelocity = velocity
	mover.Parent = root
	Debris:AddItem(mover, duration)
end

-- Sets the velocity once and lets physics take over (good for small upward pops).
function MotionUtil.Impulse(character: Model, velocity: Vector3)
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		root.AssemblyLinearVelocity = velocity
	end
end

return MotionUtil
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--[[
	Remotes
	=======
	All network events in one place. The server creates them; clients wait for them.

	  Client -> Server
	    SelectHero  (heroId)                 pick or swap hero
	    Fire        (shotData)               primary weapon
	    Reload      ()
	    UseAbility  (slot, aim)              "Ability1" | "Ability2" | "Ultimate"

	  Server -> Client
	    FX          (kind, data)             visual effects (tracers, explosions, ...)
	    HitConfirm  (data)                   your damage/healing landed: hit markers, numbers
	    Damaged     (data)                   you took damage: screen flash
	    Notify      (kind, data)             kill feed, banners, messages
	    Motion      (kind, velocity, time)   dash/knockback YOUR character (clients own their physics)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENT_NAMES = {
	"SelectHero",
	"Fire",
	"Reload",
	"UseAbility",
	"FX",
	"HitConfirm",
	"Damaged",
	"Notify",
	"Motion",
}

local Remotes = {}

local folder
if RunService:IsServer() then
	folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	for _, name in EVENT_NAMES do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes")
end

for _, name in EVENT_NAMES do
	Remotes[name] = folder:WaitForChild(name)
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[--[[
	Signal
	======
	A tiny event object for code-to-code communication (like a BindableEvent, but plain Luau).

		local died = Signal.new()
		local connection = died:Connect(function(who) print(who, "died") end)
		died:Fire("Echo")
		connection:Disconnect()
]]

local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ _listeners = {} }, Signal)
end

function Signal:Connect(callback)
	local listeners = self._listeners
	local entry = { Callback = callback, Connected = true }
	table.insert(listeners, entry)

	return {
		Disconnect = function()
			entry.Connected = false
			local index = table.find(listeners, entry)
			if index then
				table.remove(listeners, index)
			end
		end,
	}
end

function Signal:Fire(...)
	-- Copy first so listeners can disconnect themselves while we loop.
	for _, entry in table.clone(self._listeners) do
		if entry.Connected then
			task.spawn(entry.Callback, ...)
		end
	end
end

return Signal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Synergies</string>
          <string name="Source"><![CDATA[--[[
	Synergies (team-ups)
	====================
	When every hero listed in a synergy is on the same team, each of those heroes gets its bonus.
	The HUD shows active synergies, and the hero select screen lists them so players can plan.

	Supported bonus stats:
	  DamageMult, HealingMult, CooldownMult, ProjectileSpeedMult, BarrierHealthMult
	      multipliers: 1.1 = +10%, 0.85 = -15%
	  MaxHealthBonus
	      extra maximum health (added when the hero spawns)
]]

local Synergies = {}

Synergies.List = {
	{
		Id = "RadiantShield",
		Name = "Radiant Shield",
		Heroes = { "Bulwark", "Lumen" },
		Description = "Bulwark's Aegis Wall is 35% tougher and Lumen heals 15% more.",
		Bonuses = {
			Bulwark = { BarrierHealthMult = 1.35 },
			Lumen = { HealingMult = 1.15 },
		},
	},
	{
		Id = "StormCell",
		Name = "Storm Cell",
		Heroes = { "Kestrel", "Volta" },
		Description = "Kestrel and Volta deal 10% more damage, and Volta's orbs fly 20% faster.",
		Bonuses = {
			Kestrel = { DamageMult = 1.1 },
			Volta = { DamageMult = 1.1, ProjectileSpeedMult = 1.2 },
		},
	},
	{
		Id = "GuidingLight",
		Name = "Guiding Light",
		Heroes = { "Kaida", "Lumen" },
		Description = "Kaida gains 50 max health and Lumen's abilities recharge 15% faster.",
		Bonuses = {
			Kaida = { MaxHealthBonus = 50 },
			Lumen = { CooldownMult = 0.85 },
		},
	},
	{
		Id = "IronAndEdge",
		Name = "Iron & Edge",
		Heroes = { "Bulwark", "Kaida" },
		Description = "Bulwark and Kaida recharge their abilities 15% faster.",
		Bonuses = {
			Bulwark = { CooldownMult = 0.85 },
			Kaida = { CooldownMult = 0.85 },
		},
	},
}

-- Every synergy a hero is part of (used by the hero select screen).
function Synergies.ForHero(heroId)
	local results = {}
	for _, synergy in Synergies.List do
		if table.find(synergy.Heroes, heroId) then
			table.insert(results, synergy)
		end
	end
	return results
end

return Synergies
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="13">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="14">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Folder" referent="15">
        <Properties>
          <string name="Name">HeroKits</string>
        </Properties>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Bulwark</string>
            <string name="Source"><![CDATA[--[[
	Bulwark (Tank) — ability code. Numbers live in Shared/Heroes.luau.
	  Ability1  Ram Dash           dash that damages and knocks back enemies
	  Ability2  Aegis Wall         placeable energy barrier with health
	  Ultimate  Fortress Protocol  team-wide shields and damage reduction
]]

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CombatUtil = require(Shared.CombatUtil)

local Services = script.Parent.Parent:WaitForChild("Services")
local CombatService = require(Services.CombatService)
local StatusService = require(Services.StatusService)
local MotionService = require(Services.MotionService)
local SynergyService = require(Services.SynergyService)
local MapService = require(Services.MapService)
local FX = require(Services.FX)
local KitUtil = require(script.Parent.KitUtil)

local Kit = {}

local walls = setmetatable({}, { __mode = "k" }) -- [character] = their current wall (one at a time)

-- Ram Dash: charge forward; every enemy we pass through is hit once and shoved away.
function Kit.Ability1(ctx)
	local ability = ctx.Ability
	local character = ctx.Character
	local direction = CombatUtil.Flatten(ctx.AimDirection)
	MotionService.Dash(character, direction * (ability.Distance / ability.Duration), ability.Duration)
	FX.All("DashTrail", { Character = character, Duration = ability.Duration, Color = ctx.Hero.AccentColor })

	local alreadyHit = {}
	local started = os.clock()
	local connection
	connection = RunService.Heartbeat:Connect(function()
		if os.clock() - started > ability.Duration + 0.15 or not CombatUtil.IsAlive(character) then
			connection:Disconnect()
			return
		end
		for _, enemy in CombatService.GetEnemiesInRadius(character, ctx.Root.Position, ability.HitRadius) do
			if not alreadyHit[enemy] then
				alreadyHit[enemy] = true
				CombatService.Damage(character, enemy, ability.Damage, { Ability = ability.Name })
				MotionService.Knockback(enemy, direction * ability.Knockback + Vector3.new(0, 25, 0))
			end
		end
	end)
end

-- Aegis Wall: a barrier that blocks enemy shots. It is a "Destructible" with a Team, so enemies
-- can shoot it down while allies (see CombatUtil.ShotParams) shoot straight through it.
function Kit.Ability2(ctx)
	local ability = ctx.Ability
	local direction = CombatUtil.Flatten(ctx.AimDirection)
	local center = KitUtil.GroundAt(ctx.Root.Position + direction * ability.PlaceDistance)
	local health = ability.Health * SynergyService.GetBonus(ctx.Character, "BarrierHealthMult", 1)

	local previous = walls[ctx.Character]
	if previous and previous.Parent then
		previous:Destroy()
	end

	local wall = Instance.new("Part")
	wall.Name = "AegisWall"
	wall.Size = Vector3.new(ability.Width, ability.Height, 0.6)
	wall.CFrame = CFrame.lookAt(center, center + direction) + Vector3.new(0, ability.Height / 2, 0)
	wall.Anchored = true
	wall.CanCollide = false -- heroes walk through it, bullets do not
	wall.CanTouch = false
	wall.CastShadow = false
	wall.Material = Enum.Material.ForceField
	wall.Color = ctx.Hero.AccentColor
	wall.Transparency = 0.1
	wall:SetAttribute("Team", ctx.Team)
	wall:SetAttribute("MaxHealth", health)
	wall:SetAttribute("Permanent", true)
	CollectionService:AddTag(wall, "Barrier")
	CollectionService:AddTag(wall, "Destructible")
	wall.Parent = MapService.GetEffectsFolder()
	walls[ctx.Character] = wall
	Debris:AddItem(wall, ability.Duration)

	FX.All("Ring", { Position = center + Vector3.new(0, 0.5, 0), Radius = ability.Width / 2, Color = ctx.Hero.AccentColor })
end

-- Fortress Protocol: shields + damage reduction for everyone nearby on our team.
function Kit.Ultimate(ctx)
	local ability = ctx.Ability
	local color = ctx.Hero.AccentColor
	for _, ally in CombatService.GetAlliesInRadius(ctx.Character, ctx.Root.Position, ability.Radius, true) do
		StatusService.AddShield(ally, ability.Shield, ability.Duration)
		StatusService.Apply(ally, "Fortress", { DamageTaken = 1 - ability.DamageReduction }, ability.Duration)
		FX.All("Aura", { Character = ally, Duration = ability.Duration, Color = color })
	end
	FX.All("Ring", { Position = ctx.Root.Position, Radius = ability.Radius, Color = color, Time = 0.6 })
end

return Kit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Kaida</string>
            <string name="Source"><![CDATA[--[[
	Kaida (Damage) — ability code. Numbers live in Shared/Heroes.luau.
	  Ability1  Phantom Dash   damaging dash; any elimination resets its cooldown
	  Ability2  Guard Stance   brief damage reduction, then a slash all around
	  Ultimate  Blade Tempest  spinning blade storm that damages everything nearby
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CombatUtil = require(Shared.CombatUtil)

local Services = script.Parent.Parent:WaitForChild("Services")
local CombatService = require(Services.CombatService)
local StatusService = require(Services.StatusService)
local MotionService = require(Services.MotionService)
local FX = require(Services.FX)
local KitUtil = require(script.Parent.KitUtil)

local Kit = {}

-- Passive: every elimination Kaida gets refreshes Phantom Dash.
CombatService.Killed:Connect(function(_victim, killer)
	if killer and killer.HeroId == "Kaida" and killer.Character then
		killer.Character:SetAttribute("CD_Ability1", 0)
	end
end)

-- Phantom Dash
function Kit.Ability1(ctx)
	local ability = ctx.Ability
	local character = ctx.Character
	local direction = CombatUtil.Flatten(ctx.AimDirection)
	MotionService.Dash(character, direction * (ability.Distance / ability.Duration), ability.Duration)
	FX.All("DashTrail", { Character = character, Duration = ability.Duration, Color = ctx.Hero.AccentColor })

	local alreadyHit = {}
	local started = os.clock()
	local connection
	connection = RunService.Heartbeat:Connect(function()
		if os.clock() - started > ability.Duration + 0.15 or not CombatUtil.IsAlive(character) then
			connection:Disconnect()
			return
		end
		for _, enemy in CombatService.GetEnemiesInRadius(character, ctx.Root.Position, ability.HitRadius) do
			if not alreadyHit[enemy] then
				alreadyHit[enemy] = true
				CombatService.Damage(character, enemy, ability.Damage, { Ability = ability.Name })
			end
		end
	end)
end

-- Guard Stance
function Kit.Ability2(ctx)
	local ability = ctx.Ability
	local character = ctx.Character
	local color = ctx.Hero.AccentColor
	StatusService.Apply(character, "Guard Stance", { DamageTaken = 1 - ability.DamageReduction }, ability.Duration)
	FX.All("Aura", { Character = character, Duration = ability.Duration, Color = color })

	task.delay(ability.Duration, function()
		local root = CombatUtil.GetRoot(character)
		if not root or not CombatUtil.IsAlive(character) then
			return
		end
		for _, enemy in CombatService.GetEnemiesInRadius(character, root.Position, ability.CounterRadius) do
			CombatService.Damage(character, enemy, ability.CounterDamage, { Ability = ability.Name })
		end
		FX.All("Ring", { Position = root.Position, Radius = ability.CounterRadius, Color = color, Time = 0.3 })
	end)
end

-- Blade Tempest
function Kit.Ultimate(ctx)
	local ability = ctx.Ability
	local character = ctx.Character
	local color = ctx.Hero.AccentColor
	StatusService.Apply(character, "Blade Tempest", { Speed = 1 + ability.SpeedBoost }, ability.Duration)
	FX.All("Aura", { Character = character, Duration = ability.Duration, Color = color, Radius = ability.Radius })

	local ticks = 0
	KitUtil.Repeat(ability.Duration, ability.TickInterval, function()
		local root = CombatUtil.GetRoot(character)
		if not root then
			return
		end
		for _, enemy in CombatService.GetEnemiesInRadius(character, root.Position, ability.Radius) do
			CombatService.Damage(character, enemy, ability.TickDamage, { Ability = ability.Name })
		end
		ticks += 1
		if ticks % 2 == 0 then
			FX.All("Ring", { Position = root.Position, Radius = ability.Radius, Color = color, Time = 0.25 })
		end
	end, function()
		return CombatUtil.IsAlive(character)
	end)
end

return Kit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Kestrel</string>
            <string name="Source"><![CDATA[--[[
	Kestrel (Damage) — ability code. Numbers live in Shared/Heroes.luau.
	  Ability1  Jet Leap       burst of upward + forward movement
	  Ability2  Shock Grenade  arcing grenade: area damage + slow
	  Ultimate  Overdrive      faster fire, more damage, no reloading
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CombatUtil = require(Shared.CombatUtil)

local Services = script.Parent.Parent:WaitForChild("Services")
local CombatService = require(Services.CombatService)
local StatusService = require(Services.StatusService)
local MotionService = require(Services.MotionService)
local ProjectileService = require(Services.ProjectileService)
local WeaponService = require(Services.WeaponService)
local FX = require(Services.FX)

local Kit = {}

-- Jet Leap
function Kit.Ability1(ctx)
	local ability = ctx.Ability
	local forward = CombatUtil.Flatten(ctx.AimDirection)
	local velocity = forward * ability.ForwardSpeed + Vector3.new(0, ability.UpSpeed, 0)
	MotionService.Dash(ctx.Character, velocity, ability.Duration)
	FX.All("Burst", { Position = ctx.Root.Position - Vector3.new(0, 2.5, 0), Color = ctx.Hero.AccentColor })
end

-- Shock Grenade: thrown slightly upward so it arcs, explodes on impact (or when its fuse runs out).
function Kit.Ability2(ctx)
	local ability = ctx.Ability
	local character = ctx.Character
	local direction = (ctx.AimDirection + Vector3.new(0, 0.18, 0)).Unit

	ProjectileService.Fire({
		Owner = character,
		Origin = ctx.AimOrigin,
		Velocity = direction * ability.Speed,
		Gravity = ability.Gravity,
		Radius = 0.7,
		Lifetime = 2.5,
		ExplodeOnExpire = true,
		Color = ctx.Hero.AccentColor,
		Style = "Grenade",
		Impact = "Explosion",
		ImpactRadius = ability.Radius,
		OnHit = function(_, position, normal)
			local center = if normal then position + normal * 0.5 else position
			CombatService.Explode(character, center, ability.Radius, ability.Damage, {
				Ability = ability.Name,
				OnHit = function(target)
					StatusService.Apply(target, "Slowed", { Speed = 1 - ability.SlowAmount }, ability.SlowDuration)
				end,
			})
		end,
	})
end

-- Overdrive
function Kit.Ultimate(ctx)
	local ability = ctx.Ability
	StatusService.Apply(ctx.Character, "Overdrive", {
		FireRate = ability.FireRateMult,
		DamageDealt = ability.DamageMult,
		InfiniteAmmo = 1,
	}, ability.Duration)
	WeaponService.Refill(ctx.Character)
	FX.All("Aura", { Character = ctx.Character, Duration = ability.Duration, Color = ctx.Hero.AccentColor })
end

return Kit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">KitUtil</string>
            <string name="Source"><![CDATA[--[[
	KitUtil
	=======
	Helpers shared by the hero kits: finding the ground, clamping ranges, and drawing area zones.
	(This module has no matching hero, so AbilityService skips it when loading kits.)
]]

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CombatUtil = require(Shared.CombatUtil)

local Services = script.Parent.Parent:WaitForChild("Services")
local MapService = require(Services.MapService)

local KitUtil = {}

-- Raycast params that only see the world (no characters).
function KitUtil.WorldParams(): RaycastParams
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = CombatUtil.GetAllCharacters()
	params.IgnoreWater = true
	return params
end

-- The floor directly below (or slightly above) a point.
function KitUtil.GroundAt(position: Vector3): Vector3
	local result = workspace:Raycast(position + Vector3.new(0, 4, 0), Vector3.new(0, -80, 0), KitUtil.WorldParams())
	return if result then result.Position else position
end

function KitUtil.ClampRange(from: Vector3, to: Vector3, maxRange: number): Vector3
	local offset = to - from
	if offset.Magnitude > maxRange then
		return from + offset.Unit * maxRange
	end
	return to
end

-- A glowing disc on the ground that marks an area effect. Removed after `duration`.
function KitUtil.MakeZone(position: Vector3, radius: number, color: Color3, duration: number, transparency: number?)
	local disc = Instance.new("Part")
	disc.Name = "Zone"
	disc.Shape = Enum.PartType.Cylinder
	disc.Size = Vector3.new(0.4, radius * 2, radius * 2)
	disc.CFrame = CFrame.new(position + Vector3.new(0, 0.25, 0)) * CFrame.Angles(0, 0, math.rad(90))
	disc.Anchored = true
	disc.CanCollide = false
	disc.CanQuery = false
	disc.CanTouch = false
	disc.CastShadow = false
	disc.Material = Enum.Material.Neon
	disc.Color = color
	disc.Transparency = transparency or 0.65
	disc.Parent = MapService.GetEffectsFolder()
	Debris:AddItem(disc, duration)
	return disc
end

-- Runs `onTick` every `interval` seconds for `duration` seconds (stops early if `keepGoing` says so).
function KitUtil.Repeat(duration: number, interval: number, onTick, keepGoing)
	task.spawn(function()
		local elapsed = 0
		while elapsed < duration do
			if keepGoing and not keepGoing() then
				return
			end
			onTick(elapsed)
			task.wait(interval)
			elapsed += interval
		end
	end)
end

return KitUtil
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Lumen</string>
            <string name="Source"><![CDATA[--[[
	Lumen (Support) — ability code. Numbers live in Shared/Heroes.luau.
	  Ability1  Radiant Pulse  instant area heal
	  Ability2  Tailwind       area speed boost
	  Ultimate  Sanctuary      healing zone that also reduces damage taken
]]

local Services = script.Parent.Parent:WaitForChild("Services")
local CombatService = require(Services.CombatService)
local StatusService = require(Services.StatusService)
local FX = require(Services.FX)
local KitUtil = require(script.Parent.KitUtil)

local TAILWIND_COLOR = Color3.fromRGB(150, 255, 200)

local Kit = {}

-- Radiant Pulse
function Kit.Ability1(ctx)
	local ability = ctx.Ability
	for _, ally in CombatService.GetAlliesInRadius(ctx.Character, ctx.Root.Position, ability.Radius, true) do
		CombatService.Heal(ctx.Character, ally, ability.Heal, { Ability = ability.Name })
	end
	FX.All("Ring", { Position = ctx.Root.Position, Radius = ability.Radius, Color = ctx.Hero.AccentColor, Time = 0.5 })
end

-- Tailwind
function Kit.Ability2(ctx)
	local ability = ctx.Ability
	for _, ally in CombatService.GetAlliesInRadius(ctx.Character, ctx.Root.Position, ability.Radius, true) do
		StatusService.Apply(ally, "Tailwind", { Speed = 1 + ability.SpeedBoost }, ability.Duration)
		FX.All("DashTrail", { Character = ally, Duration = ability.Duration, Color = TAILWIND_COLOR })
	end
	FX.All("Ring", { Position = ctx.Root.Position, Radius = ability.Radius, Color = TAILWIND_COLOR, Time = 0.5 })
end

-- Sanctuary: stays where Lumen stood, even if Lumen moves away or falls.
function Kit.Ultimate(ctx)
	local ability = ctx.Ability
	local character = ctx.Character
	local point = KitUtil.GroundAt(ctx.Root.Position)
	local interval = 0.25
	KitUtil.MakeZone(point, ability.Radius, ctx.Hero.AccentColor, ability.Duration, 0.55)

	KitUtil.Repeat(ability.Duration, interval, function()
		for _, ally in CombatService.GetAlliesInRadius(character, point, ability.Radius, true) do
			CombatService.Heal(character, ally, ability.HealPerSecond * interval, { Ability = ability.Name, Silent = true })
			StatusService.Apply(ally, "Sanctuary", { DamageTaken = 1 - ability.DamageReduction }, interval + 0.15)
		end
	end)
end

return Kit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Volta</string>
            <string name="Source"><![CDATA[--[[
	Volta (Damage) — ability code. Numbers live in Shared/Heroes.luau.
	  Ability1  Blink         short-range teleport (stops before walls)
	  Ability2  Static Field  damaging, slowing area on the ground
	  Ultimate  Thunderhead   three lightning strikes after a short warning
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CombatUtil = require(Shared.CombatUtil)

local Services = script.Parent.Parent:WaitForChild("Services")
local CombatService = require(Services.CombatService)
local StatusService = require(Services.StatusService)
local MotionService = require(Services.MotionService)
local FX = require(Services.FX)
local KitUtil = require(script.Parent.KitUtil)

local Kit = {}

-- Blink: check for walls at foot, waist and head height and stop just short of the nearest one.
-- (Raycasts, not a sphere cast: a sphere that starts inside a wall you're hugging would miss it.)
function Kit.Ability1(ctx)
	local ability = ctx.Ability
	local direction = CombatUtil.Flatten(ctx.AimDirection)
	local start = ctx.Root.Position
	local params = KitUtil.WorldParams()
	local distance = ability.Distance
	for _, height in { -1.8, 0, 1.5 } do
		local result = workspace:Raycast(start + Vector3.new(0, height, 0), direction * ability.Distance, params)
		if result then
			distance = math.min(distance, math.max(0, result.Distance - 2))
		end
	end
	local destination = start + direction * distance

	FX.All("Blink", { From = start, To = destination, Color = ctx.Hero.AccentColor })
	MotionService.Teleport(ctx.Character, CFrame.lookAt(destination, destination + direction))
end

-- Static Field: placed where you aim (up to MaxRange away), ticks damage and slow.
function Kit.Ability2(ctx)
	local ability = ctx.Ability
	local character = ctx.Character
	local point = KitUtil.GroundAt(KitUtil.ClampRange(ctx.Root.Position, ctx.AimPoint, ability.MaxRange))
	KitUtil.MakeZone(point, ability.Radius, ctx.Hero.AccentColor, ability.Duration, 0.6)

	KitUtil.Repeat(ability.Duration, ability.TickInterval, function()
		for _, enemy in CombatService.GetEnemiesInRadius(character, point, ability.Radius) do
			CombatService.Damage(character, enemy, ability.TickDamage, { Ability = ability.Name })
			StatusService.Apply(enemy, "Static", { Speed = 1 - ability.SlowAmount }, ability.TickInterval + 0.2)
		end
	end)
end

-- Thunderhead: a warning circle, then several strikes that ignore cover (they come from above).
function Kit.Ultimate(ctx)
	local ability = ctx.Ability
	local character = ctx.Character
	local color = ctx.Hero.AccentColor
	local point = KitUtil.GroundAt(KitUtil.ClampRange(ctx.Root.Position, ctx.AimPoint, ability.MaxRange))

	FX.All("Telegraph", { Position = point, Radius = ability.Radius, Duration = ability.Duration, Color = color })
	task.delay(ability.Delay, function()
		for _ = 1, ability.Strikes do
			FX.All("Lightning", { Position = point, Radius = ability.Radius, Color = color })
			CombatService.Explode(character, point + Vector3.new(0, 3, 0), ability.Radius, ability.StrikeDamage, {
				Ability = ability.Name,
				MinFalloff = 0.7,
				IgnoreCover = true,
			})
			task.wait(ability.StrikeInterval)
		end
	end)
end

return Kit
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="22">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Server entry point
	==================
	Configures a few engine settings, then starts every service in dependency order.
	Game logic lives in ./Services, hero abilities in ./HeroKits, the arena in ./Map.
]]

local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local StarterPlayer = game:GetService("StarterPlayer")

-- 1) Characters are spawned by the game (after you pick a hero), not automatically.
Players.CharacterAutoLoads = false

-- 2) Shift is an ability key, so turn off Roblox's shift-lock toggle.
StarterPlayer.EnableMouseLockOption = false

-- 3) No slow automatic health regeneration: an empty Script named "Health" in
--    StarterCharacterScripts replaces Roblox's default one. Heal at your spawn or with a support!
if not StarterPlayer.StarterCharacterScripts:FindFirstChild("Health") then
	local noRegen = Instance.new("Script")
	noRegen.Name = "Health"
	noRegen.Parent = StarterPlayer.StarterCharacterScripts
end

-- 4) Debris from destroyed cover never bumps into heroes.
for _, group in { "Characters", "Debris" } do
	if not PhysicsService:IsCollisionGroupRegistered(group) then
		PhysicsService:RegisterCollisionGroup(group)
	end
end
PhysicsService:CollisionGroupSetCollidable("Characters", "Debris", false)
PhysicsService:CollisionGroupSetCollidable("Debris", "Debris", false)

local Services = script.Parent:WaitForChild("Services")
local MapService = require(Services.MapService)
local DestructibleService = require(Services.DestructibleService)
local SynergyService = require(Services.SynergyService)
local WeaponService = require(Services.WeaponService)
local AbilityService = require(Services.AbilityService)
local BotService = require(Services.BotService)
local MatchService = require(Services.MatchService)

MapService.Init()
DestructibleService.Init()
SynergyService.Init()
WeaponService.Init()
AbilityService.Init()
BotService.Init()
MatchService.Start()

print("[Rift Arena] Server ready")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="23">
        <Properties>
          <string name="Name">Map</string>
        </Properties>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">MapBuilder</string>
            <string name="Source"><![CDATA[--[[
	MapBuilder
	==========
	Builds the arena out of plain parts. The shipped place file already contains a pre-built copy
	in Workspace.Map that you can edit freely in Studio; this code only runs if that map is missing.
	You can also run it from Studio's command bar to rebuild the default arena:
		require(game.ServerScriptService.Server.Map.MapBuilder).Build().Parent = workspace

	ANY map works as long as Workspace.Map contains:
	  Spawns/<Team>      Folder of parts where heroes appear (one folder per team name)
	  SpawnRooms/<Team>  Invisible box part: heals that team inside, hurts enemies inside
	  SpawnDoors/<Team>  Folder of parts that block the exits during Setup
	  ControlPoint       Invisible part at the centre of the objective, with number
	                     attributes "Radius" and "Height" (the capture area)
	  PointVisual        (optional) Folder of parts recoloured to the owning team
	Parts tagged "Destructible" (CollectionService) with a "MaxHealth" attribute can be shot apart.

	The layout is built for the first team and copied for the second team rotated 180 degrees,
	so both sides are identical. Only plain Instance APIs are used, so tools/bake-map.luau can run
	this file outside Roblox to bake the map into the place file.
]]

local MapBuilder = {}

local COLORS = {
	Floor = Color3.fromRGB(46, 49, 58),
	FloorTile = Color3.fromRGB(55, 58, 68),
	Wall = Color3.fromRGB(84, 88, 100),
	Structure = Color3.fromRGB(70, 74, 86),
	Dark = Color3.fromRGB(36, 38, 46),
	Crate = Color3.fromRGB(150, 105, 60),
	Barricade = Color3.fromRGB(112, 118, 130),
	Neutral = Color3.fromRGB(235, 235, 240),
}

local DEFAULT_TEAMS = {
	{ Name = "Blue", Color = Color3.fromRGB(70, 160, 255), BrickColor = BrickColor.new("Bright blue") },
	{ Name = "Red", Color = Color3.fromRGB(255, 80, 80), BrickColor = BrickColor.new("Bright red") },
}

local ARENA_X = 160 -- half length (spawn to spawn runs along X)
local ARENA_Z = 100 -- half width
local WALL_HEIGHT = 34
local UPRIGHT = CFrame.Angles(0, 0, math.rad(90)) -- stands a cylinder on its end

local function newFolder(parent: Instance, name: string): Folder
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

local function part(parent: Instance, props)
	local p = Instance.new(props.ClassName or "Part")
	p.Name = props.Name or "Part"
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = props.Size
	p.CFrame = props.CFrame
	p.Color = props.Color or COLORS.Structure
	p.Material = props.Material or Enum.Material.SmoothPlastic
	if props.Shape then
		p.Shape = props.Shape
	end
	if props.Transparency then
		p.Transparency = props.Transparency
	end
	if props.CanCollide ~= nil then
		p.CanCollide = props.CanCollide
	end
	if props.CanQuery ~= nil then
		p.CanQuery = props.CanQuery
	end
	if props.CanTouch ~= nil then
		p.CanTouch = props.CanTouch
	end
	if props.CastShadow ~= nil then
		p.CastShadow = props.CastShadow
	end
	if props.Attributes then
		for key, value in props.Attributes do
			p:SetAttribute(key, value)
		end
	end
	if props.Tags then
		for _, tag in props.Tags do
			p:AddTag(tag)
		end
	end
	p.Parent = parent
	return p
end

-- Decorative, non-solid glowing part.
local function glow(parent: Instance, size: Vector3, cframe: CFrame, color: Color3, transparency: number?)
	return part(parent, {
		Name = "Glow",
		Size = size,
		CFrame = cframe,
		Color = color,
		Material = Enum.Material.Neon,
		Transparency = transparency,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
	})
end

-- A block whose top surface runs from `bottom` to `top` (both are walking-surface points).
local function rampCFrame(bottom: Vector3, top: Vector3)
	local middle = (bottom + top) / 2
	local length = (top - bottom).Magnitude
	return CFrame.lookAt(middle, top) * CFrame.new(0, -0.5, 0), length
end

local function crate(parent: Instance, cframe: CFrame)
	return part(parent, {
		Name = "Crate",
		Size = Vector3.new(4, 4, 4),
		CFrame = cframe,
		Color = COLORS.Crate,
		Material = Enum.Material.WoodPlanks,
		Attributes = { MaxHealth = 150, RespawnTime = 25 },
		Tags = { "Destructible" },
	})
end

local function barricade(parent: Instance, cframe: CFrame, size: Vector3)
	return part(parent, {
		Name = "Barricade",
		Size = size,
		CFrame = cframe,
		Color = COLORS.Barricade,
		Material = Enum.Material.DiamondPlate,
		Attributes = { MaxHealth = 350, RespawnTime = 30 },
		Tags = { "Destructible" },
	})
end

--------------------------------------------------------------------------------
-- Everything that exists once: floor, outer walls and the control point.
--------------------------------------------------------------------------------
local function buildShared(map: Model, folders)
	local geometry, decor = folders.Geometry, folders.Decor

	part(geometry, {
		Name = "Floor",
		Size = Vector3.new(ARENA_X * 2 + 8, 2, ARENA_Z * 2 + 8),
		CFrame = CFrame.new(0, -1, 0),
		Color = COLORS.Floor,
		Material = Enum.Material.Concrete,
	})
	-- Checkerboard floor panels give a sense of distance and speed.
	for xIndex = 0, 7 do
		for zIndex = 0, 4 do
			if (xIndex + zIndex) % 2 == 0 then
				part(decor, {
					Name = "FloorPanel",
					Size = Vector3.new(38, 0.1, 38),
					CFrame = CFrame.new(-140 + xIndex * 40, 0.03, -80 + zIndex * 40),
					Color = COLORS.FloorTile,
					Material = Enum.Material.Slate,
					CanCollide = false,
					CanQuery = false,
					CanTouch = false,
				})
			end
		end
	end

	-- Outer walls
	for _, sign in { 1, -1 } do
		part(geometry, {
			Name = "OuterWall",
			Size = Vector3.new(ARENA_X * 2 + 8, WALL_HEIGHT, 4),
			CFrame = CFrame.new(0, WALL_HEIGHT / 2, sign * (ARENA_Z + 2)),
			Color = COLORS.Wall,
			Material = Enum.Material.Concrete,
		})
		part(geometry, {
			Name = "OuterWall",
			Size = Vector3.new(4, WALL_HEIGHT, ARENA_Z * 2 + 8),
			CFrame = CFrame.new(sign * (ARENA_X + 2), WALL_HEIGHT / 2, 0),
			Color = COLORS.Wall,
			Material = Enum.Material.Concrete,
		})
	end

	-- Control point: platform, glowing ring, core and a tall beacon you can see from anywhere.
	part(geometry, {
		Name = "PointPlatform",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.2, 40, 40),
		CFrame = CFrame.new(0, 0.6, 0) * UPRIGHT,
		Color = COLORS.Structure,
		Material = Enum.Material.Metal,
	})
	local pointVisual = folders.PointVisual
	part(pointVisual, {
		Name = "PointRing",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 44, 44),
		CFrame = CFrame.new(0, 0.2, 0) * UPRIGHT,
		Color = COLORS.Neutral,
		Material = Enum.Material.Neon,
		CanCollide = false,
		CanQuery = false,
	})
	part(pointVisual, {
		Name = "PointCore",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.1, 8, 8),
		CFrame = CFrame.new(0, 1.25, 0) * UPRIGHT,
		Color = COLORS.Neutral,
		Material = Enum.Material.Neon,
		CanCollide = false,
		CanQuery = false,
	})
	part(pointVisual, {
		Name = "Beacon",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(70, 1.5, 1.5),
		CFrame = CFrame.new(0, 36.2, 0) * UPRIGHT,
		Color = COLORS.Neutral,
		Material = Enum.Material.Neon,
		Transparency = 0.55,
		CanCollide = false,
		CanQuery = false,
		CastShadow = false,
	})
	part(map, {
		Name = "ControlPoint",
		Size = Vector3.new(2, 2, 2),
		CFrame = CFrame.new(0, 2.2, 0),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Attributes = { Radius = 20, Height = 10 },
	})
end

--------------------------------------------------------------------------------
-- One team's half. Coordinates are written for the first team (negative X);
-- `place` rotates them for the second team.
--------------------------------------------------------------------------------
local function buildSide(team, transform: CFrame, folders)
	local geometry, cover, decor = folders.Geometry, folders.Cover, folders.Decor
	local color = team.Color
	local function place(cframe: CFrame): CFrame
		return transform * cframe
	end

	-- Spawn room: walls, roof, a door gap with a team-coloured door, spawn pads, heal zone.
	local roomProps = { Color = COLORS.Structure, Material = Enum.Material.Concrete }
	local function roomPart(name: string, size: Vector3, cframe: CFrame)
		return part(geometry, { Name = name, Size = size, CFrame = place(cframe), Color = roomProps.Color, Material = roomProps.Material })
	end
	roomPart("SpawnWall", Vector3.new(2, 18, 18), CFrame.new(-123, 9, -17))
	roomPart("SpawnWall", Vector3.new(2, 18, 18), CFrame.new(-123, 9, 17))
	roomPart("SpawnLintel", Vector3.new(2, 6, 16), CFrame.new(-123, 15, 0))
	roomPart("SpawnWall", Vector3.new(37, 18, 2), CFrame.new(-141.5, 9, -25))
	roomPart("SpawnWall", Vector3.new(37, 18, 2), CFrame.new(-141.5, 9, 25))
	roomPart("SpawnRoof", Vector3.new(38, 1.5, 52), CFrame.new(-141, 18.75, 0))
	glow(decor, Vector3.new(0.4, 0.6, 16), place(CFrame.new(-121.8, 12.3, 0)), color)
	glow(decor, Vector3.new(0.4, 2, 12), place(CFrame.new(-121.8, 15.5, 0)), color)

	local doors = newFolder(folders.SpawnDoors, team.Name)
	part(doors, {
		Name = "SpawnDoor",
		Size = Vector3.new(1, 12, 16),
		CFrame = place(CFrame.new(-123, 6, 0)),
		Color = color,
		Material = Enum.Material.Neon,
		Transparency = 0.45,
		CastShadow = false,
	})

	local pads = newFolder(folders.Spawns, team.Name)
	for _, x in { -150, -138 } do
		for _, z in { -12, 0, 12 } do
			part(pads, {
				Name = "SpawnPad",
				Size = Vector3.new(5, 0.3, 5),
				CFrame = place(CFrame.new(x, 0.15, z)),
				Color = color,
				Material = Enum.Material.Neon,
				Transparency = 0.25,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
			})
		end
	end

	local spawnLocation = part(folders.SpawnLocations, {
		ClassName = "SpawnLocation",
		Name = team.Name .. "SpawnLocation",
		Size = Vector3.new(6, 1, 6),
		CFrame = place(CFrame.new(-145, 0.5, 0)),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	})
	spawnLocation.Neutral = false
	spawnLocation.TeamColor = team.BrickColor
	spawnLocation.Duration = 0 -- no spawn force field
	spawnLocation.AllowTeamChangeOnTouch = false

	part(folders.SpawnRooms, {
		Name = team.Name,
		Size = Vector3.new(36, 18, 50),
		CFrame = place(CFrame.new(-142, 9, 0)),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	})

	-- Main lane: barricades and crates between spawn and the gate.
	barricade(cover, place(CFrame.new(-100, 2.5, -10)), Vector3.new(1.5, 5, 10))
	barricade(cover, place(CFrame.new(-100, 2.5, 15)), Vector3.new(1.5, 5, 8))
	barricade(cover, place(CFrame.new(-64, 2.5, 0)), Vector3.new(1.5, 5, 10))
	crate(cover, place(CFrame.new(-82, 2, -3) * CFrame.Angles(0, math.rad(15), 0)))
	crate(cover, place(CFrame.new(-86, 2, 5)))
	crate(cover, place(CFrame.new(-46, 2, -26) * CFrame.Angles(0, math.rad(-20), 0)))
	crate(cover, place(CFrame.new(-40, 2, 30)))
	glow(decor, Vector3.new(56, 0.1, 0.5), place(CFrame.new(-92, 0.06, -9)), color)
	glow(decor, Vector3.new(56, 0.1, 0.5), place(CFrame.new(-92, 0.06, 9)), color)

	-- Gate: two pillars and an overhead beam framing the lane.
	for _, z in { -16, 16 } do
		part(geometry, { Name = "GatePillar", Size = Vector3.new(6, 16, 6), CFrame = place(CFrame.new(-60, 8, z)), Color = COLORS.Wall, Material = Enum.Material.Concrete })
	end
	part(geometry, { Name = "GateBeam", Size = Vector3.new(6, 3, 38), CFrame = place(CFrame.new(-60, 17.5, 0)), Color = COLORS.Wall, Material = Enum.Material.Concrete })
	glow(decor, Vector3.new(6.2, 0.4, 26), place(CFrame.new(-60, 15.85, 0)), color)

	-- Tower: a second floor with low walls to shoot over, reached by a ramp.
	part(geometry, { Name = "TowerFloor", Size = Vector3.new(28, 1, 28), CFrame = place(CFrame.new(-78, 10.5, 60)), Material = Enum.Material.Metal })
	for _, corner in { { -90.5, 47.5 }, { -65.5, 47.5 }, { -90.5, 72.5 }, { -65.5, 72.5 } } do
		part(geometry, { Name = "TowerPillar", Size = Vector3.new(3, 10, 3), CFrame = place(CFrame.new(corner[1], 5, corner[2])), Color = COLORS.Wall, Material = Enum.Material.Concrete })
	end
	local parapets = {
		{ Vector3.new(28, 3.5, 1), CFrame.new(-78, 12.75, 73.5) },
		{ Vector3.new(1, 3.5, 28), CFrame.new(-91.5, 12.75, 60) },
		{ Vector3.new(1, 3.5, 28), CFrame.new(-64.5, 12.75, 60) },
		{ Vector3.new(12.5, 3.5, 1), CFrame.new(-85.75, 12.75, 46.5) },
		{ Vector3.new(8.5, 3.5, 1), CFrame.new(-68.25, 12.75, 46.5) },
	}
	for _, parapet in parapets do
		part(geometry, { Name = "Parapet", Size = parapet[1], CFrame = place(parapet[2]), Color = COLORS.Wall, Material = Enum.Material.Concrete })
	end
	glow(decor, Vector3.new(28.2, 0.3, 0.3), place(CFrame.new(-78, 10, 45.9)), color)
	local towerRamp, towerRampLength = rampCFrame(Vector3.new(-76, 0, 22), Vector3.new(-76, 11, 46))
	part(geometry, { Name = "Ramp", Size = Vector3.new(7, 1, towerRampLength + 1), CFrame = place(towerRamp), Material = Enum.Material.DiamondPlate })
	crate(cover, place(CFrame.new(-84, 2, 58)))
	crate(cover, place(CFrame.new(-72, 2, 66) * CFrame.Angles(0, math.rad(30), 0)))

	-- Courtyard: a raised platform with a ramp and plenty of breakable crates.
	part(geometry, { Name = "Platform", Size = Vector3.new(20, 6, 16), CFrame = place(CFrame.new(-80, 3, -62)), Material = Enum.Material.Concrete })
	local yardRamp, yardRampLength = rampCFrame(Vector3.new(-80, 0, -36), Vector3.new(-80, 6, -54))
	part(geometry, { Name = "Ramp", Size = Vector3.new(8, 1, yardRampLength + 1), CFrame = place(yardRamp), Material = Enum.Material.DiamondPlate })
	part(geometry, { Name = "PlatformWall", Size = Vector3.new(1, 3, 16), CFrame = place(CFrame.new(-70.5, 7.5, -62)), Color = COLORS.Wall, Material = Enum.Material.Concrete })
	glow(decor, Vector3.new(20.2, 0.3, 0.3), place(CFrame.new(-80, 6.05, -53.9)), color)
	crate(cover, place(CFrame.new(-100, 2, -45)))
	crate(cover, place(CFrame.new(-60, 2, -80) * CFrame.Angles(0, math.rad(10), 0)))
	crate(cover, place(CFrame.new(-55, 2, -50)))
	crate(cover, place(CFrame.new(-105, 2, -78)))

	-- Around the point
	part(geometry, { Name = "MidWall", Size = Vector3.new(24, 9, 3), CFrame = place(CFrame.new(-22, 4.5, 40)), Color = COLORS.Wall, Material = Enum.Material.Concrete })
	glow(decor, Vector3.new(24.2, 0.4, 3.2), place(CFrame.new(-22, 9.1, 40)), color)
	part(geometry, { Name = "MidPillar", Size = Vector3.new(4, 12, 4), CFrame = place(CFrame.new(-16, 6, -24)), Color = COLORS.Wall, Material = Enum.Material.Concrete })
	part(geometry, { Name = "LowCover", Size = Vector3.new(2, 4, 10), CFrame = place(CFrame.new(-30, 2, -6)), Material = Enum.Material.Metal })
	part(geometry, { Name = "PointCover", Size = Vector3.new(1.5, 4, 6), CFrame = place(CFrame.new(-10, 3.2, 0)), Material = Enum.Material.Metal })
	part(geometry, { Name = "PointCover", Size = Vector3.new(6, 4, 1.5), CFrame = place(CFrame.new(0, 3.2, 8)), Material = Enum.Material.Metal })
	crate(cover, place(CFrame.new(-26, 2, 18)))
	crate(cover, place(CFrame.new(-8, 2, -30)))

	-- Lamps
	for _, spot in { { -110, -34 }, { -110, 34 }, { -40, -64 }, { -40, 64 } } do
		part(geometry, { Name = "LampPost", Size = Vector3.new(1, 14, 1), CFrame = place(CFrame.new(spot[1], 7, spot[2])), Color = COLORS.Dark, Material = Enum.Material.Metal })
		local lamp = glow(decor, Vector3.new(2.4, 0.8, 2.4), place(CFrame.new(spot[1], 14.4, spot[2])), color)
		local light = Instance.new("PointLight")
		light.Color = color
		light.Range = 28
		light.Brightness = 1.4
		light.Parent = lamp
	end

	-- Team-coloured trim along the bottom of the outer walls on this half.
	glow(decor, Vector3.new(ARENA_X, 0.6, 0.4), place(CFrame.new(-ARENA_X / 2, 0.6, ARENA_Z - 0.3)), color)
	glow(decor, Vector3.new(ARENA_X, 0.6, 0.4), place(CFrame.new(-ARENA_X / 2, 0.6, -ARENA_Z + 0.3)), color)
	glow(decor, Vector3.new(0.4, 0.6, ARENA_Z * 2), place(CFrame.new(-ARENA_X + 0.3, 0.6, 0)), color)
end

-- Builds and returns the map Model (not parented). `teams` defaults to Blue vs Red.
function MapBuilder.Build(teams)
	teams = teams or DEFAULT_TEAMS
	local map = Instance.new("Model")
	map.Name = "Map"

	local folders = {}
	for _, name in { "Geometry", "Cover", "Decor", "PointVisual", "Spawns", "SpawnRooms", "SpawnDoors", "SpawnLocations" } do
		folders[name] = newFolder(map, name)
	end

	buildShared(map, folders)
	for index, team in teams do
		local transform = if index == 1 then CFrame.new() else CFrame.Angles(0, math.pi, 0)
		buildSide(team, transform, folders)
	end
	return map
end

-- Default lighting for the arena (only used when the map is built at runtime; the place file
-- already has these settings).
function MapBuilder.SetupLighting(lighting: Lighting)
	lighting.ClockTime = 15.2
	lighting.Brightness = 2.6
	lighting.Ambient = Color3.fromRGB(60, 60, 72)
	lighting.OutdoorAmbient = Color3.fromRGB(125, 125, 140)
	lighting.EnvironmentDiffuseScale = 0.6
	lighting.EnvironmentSpecularScale = 0.7
	lighting.GlobalShadows = true

	if not lighting:FindFirstChildOfClass("Atmosphere") then
		local atmosphere = Instance.new("Atmosphere")
		atmosphere.Density = 0.3
		atmosphere.Offset = 0.25
		atmosphere.Color = Color3.fromRGB(199, 185, 170)
		atmosphere.Decay = Color3.fromRGB(110, 90, 140)
		atmosphere.Glare = 0.2
		atmosphere.Haze = 1.4
		atmosphere.Parent = lighting
	end
	if not lighting:FindFirstChildOfClass("BloomEffect") then
		local bloom = Instance.new("BloomEffect")
		bloom.Intensity = 0.7
		bloom.Size = 24
		bloom.Threshold = 1.5
		bloom.Parent = lighting
	end
	if not lighting:FindFirstChildOfClass("ColorCorrectionEffect") then
		local grading = Instance.new("ColorCorrectionEffect")
		grading.Contrast = 0.08
		grading.Saturation = 0.12
		grading.Parent = lighting
	end
end

return MapBuilder
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="25">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">AbilityService</string>
            <string name="Source"><![CDATA[--[[
	AbilityService
	==============
	Receives ability requests (from players and bots), checks cooldowns / ultimate charge, then runs
	the hero's kit function from ServerScriptService/Server/HeroKits/<HeroId>.luau.

	A kit function receives a context table:
		ctx.Character, ctx.Humanoid, ctx.Root, ctx.Team, ctx.Profile, ctx.Player (nil for bots)
		ctx.Hero        hero definition from Shared/Heroes
		ctx.Ability     this ability's definition (all the numbers)
		ctx.AimOrigin   where shots come from
		ctx.AimDirection unit vector toward what the player is aiming at
		ctx.AimPoint    the world position under the crosshair
	Return false to cancel (no cooldown is spent); anything else counts as used.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Heroes = require(Shared.Heroes)
local CombatUtil = require(Shared.CombatUtil)
local Remotes = require(Shared.Remotes)

local GameState = require(script.Parent.GameState)
local ProfileService = require(script.Parent.ProfileService)
local SynergyService = require(script.Parent.SynergyService)
local FX = require(script.Parent.FX)

local KitsFolder = script.Parent.Parent:WaitForChild("HeroKits")

local AbilityService = {}

local SLOTS = { Ability1 = true, Ability2 = true, Ultimate = true }
local kits = {}

-- Never trust aim data from a client: fix up anything missing, broken or absurd.
local function sanitizeAim(character: Model, aim)
	local origin = CombatUtil.GetMuzzle(character) or Vector3.zero
	local root = CombatUtil.GetRoot(character)
	local fallback = if root then root.CFrame.LookVector else Vector3.new(0, 0, -1)

	local direction = if typeof(aim) == "table" then aim.Direction else nil
	if not CombatUtil.IsFiniteVector(direction) or direction.Magnitude < 0.5 then
		direction = fallback
	end
	direction = direction.Unit

	local point = if typeof(aim) == "table" then aim.Point else nil
	if not CombatUtil.IsFiniteVector(point) or (point - origin).Magnitude > 600 then
		point = origin + direction * 100
	end
	return { Origin = origin, Direction = direction, Point = point }
end

-- Returns true if the ability went off.
function AbilityService.TryUse(character: Model, slot: string, aim): boolean
	if not SLOTS[slot] or not CombatUtil.IsAlive(character) then
		return false
	end
	if GameState.Phase == "MatchEnd" or GameState.Phase == "Intermission" then
		return false
	end
	local profile = ProfileService.GetByCharacter(character)
	local heroId = character:GetAttribute("Hero")
	local hero = Heroes.Get(heroId)
	local kit = kits[heroId]
	if not profile or profile.Character ~= character or not hero or not kit or not kit[slot] then
		return false
	end
	local ability = hero.Abilities[slot]

	local now = workspace:GetServerTimeNow()
	if slot == "Ultimate" then
		if ProfileService.GetUltCharge(profile) < 100 then
			return false
		end
	elseif now < (character:GetAttribute("CD_" .. slot) or 0) - 0.05 then
		return false
	end

	aim = sanitizeAim(character, aim)
	local context = {
		Character = character,
		Humanoid = character:FindFirstChildOfClass("Humanoid"),
		Root = CombatUtil.GetRoot(character),
		Team = character:GetAttribute("Team"),
		Profile = profile,
		Player = profile.Player,
		Hero = hero,
		Ability = ability,
		AimOrigin = aim.Origin,
		AimDirection = aim.Direction,
		AimPoint = aim.Point,
	}

	local ok, result = pcall(kit[slot], context)
	if not ok then
		warn(string.format("[AbilityService] %s %s failed: %s", heroId, slot, tostring(result)))
		return false
	end
	if result == false then
		return false
	end

	if slot == "Ultimate" then
		ProfileService.SetUltCharge(profile, 0)
		profile.UltActiveUntil = os.clock() + (ability.Duration or 0)
		FX.All("UltActivated", { Hero = hero.Id, Team = profile.Team, Name = profile.Name, Ability = ability.Name })
	else
		local cooldown = ability.Cooldown * SynergyService.GetBonus(profile, "CooldownMult", 1)
		character:SetAttribute("CD_" .. slot, now + cooldown)
	end
	return true
end

function AbilityService.Init()
	for _, module in KitsFolder:GetChildren() do
		if module:IsA("ModuleScript") and Heroes.Get(module.Name) then
			kits[module.Name] = require(module)
		end
	end
	for _, heroId in Heroes.Order do
		if not kits[heroId] then
			warn("[AbilityService] No kit found for hero '" .. heroId .. "' (HeroKits/" .. heroId .. ")")
		end
	end

	Remotes.UseAbility.OnServerEvent:Connect(function(player, slot, aim)
		local character = player.Character
		if typeof(slot) == "string" and character then
			AbilityService.TryUse(character, slot, aim)
		end
	end)
end

return AbilityService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">BotService</string>
            <string name="Source"><![CDATA[--[[
	BotService
	==========
	AI fighters that fill empty slots so a match works with any number of players.

	Each bot "thinks" ten times a second:
	  1. pick the closest enemy it can actually see
	  2. decide where to go: the control point, a fighting position, or home to heal
	  3. walk there (pathfinding around walls)
	  4. shoot with deliberate inaccuracy (Config.Bots.AimErrorDegrees)
	  5. use abilities according to the hero's Bot hints in Shared/Heroes.luau
]]

local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Heroes = require(Shared.Heroes)
local CombatUtil = require(Shared.CombatUtil)

local GameState = require(script.Parent.GameState)
local ProfileService = require(script.Parent.ProfileService)
local CombatService = require(script.Parent.CombatService)
local WeaponService = require(script.Parent.WeaponService)
local AbilityService = require(script.Parent.AbilityService)
local MapService = require(script.Parent.MapService)

-- Roblox's default R15 animations (public assets owned by Roblox).
local ANIMATIONS = {
	Idle = "rbxassetid://507766666",
	Run = "rbxassetid://507767714",
	Jump = "rbxassetid://507765000",
	Fall = "rbxassetid://507767968",
}

local BotService = {}

local brains = {} -- [profileId] = brain
local templates = {} -- [heroId] = bot body to clone
local rng = Random.new()

--------------------------------------------------------------------------------
-- Bodies
--------------------------------------------------------------------------------

local function buildTemplate(hero)
	local description = Instance.new("HumanoidDescription")
	description.HeadColor = Color3.fromRGB(205, 208, 215)
	description.TorsoColor = hero.Color
	description.LeftArmColor = hero.Color
	description.RightArmColor = hero.Color
	description.LeftLegColor = Color3.fromRGB(45, 48, 58)
	description.RightLegColor = Color3.fromRGB(45, 48, 58)

	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		warn("[BotService] Could not build a bot body: " .. tostring(model))
		return nil
	end
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BaseScript") then
			descendant:Destroy() -- we animate bots from the server instead
		end
	end
	return model
end

function BotService.CreateCharacter(profile, hero)
	if not hero then
		return nil
	end
	local template = templates[hero.Id]
	if not template then
		template = buildTemplate(hero)
		templates[hero.Id] = template
	end
	if not template then
		return nil
	end
	local model = template:Clone()
	model.Name = profile.Name
	return model
end

local function setupAnimations(humanoid: Humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local tracks = {}
	for name, id in ANIMATIONS do
		local animation = Instance.new("Animation")
		animation.AnimationId = id
		local ok, track = pcall(function()
			return animator:LoadAnimation(animation)
		end)
		if ok then
			tracks[name] = track
		end
	end

	local current = nil
	local function play(name: string)
		local track = tracks[name]
		if not track or track == current then
			return
		end
		if current then
			current:Stop(0.15)
		end
		current = track
		track:Play(0.15)
	end

	humanoid.Running:Connect(function(speed)
		play(if speed > 1 then "Run" else "Idle")
	end)
	humanoid.Jumping:Connect(function(active)
		if active then
			play("Jump")
		end
	end)
	humanoid.FreeFalling:Connect(function(active)
		if active then
			play("Fall")
		end
	end)
	play("Idle")
end

--------------------------------------------------------------------------------
-- Choosing heroes: aim for one tank, one support, the rest damage.
--------------------------------------------------------------------------------

function BotService.ChooseHero(profile)
	local roleCounts = { Tank = 0, Damage = 0, Support = 0 }
	local taken = {}
	for _, mate in ProfileService.OnTeam(profile.Team) do
		local hero = mate ~= profile and Heroes.Get(mate.HeroId)
		if hero then
			roleCounts[hero.Role] += 1
			taken[hero.Id] = true
		end
	end

	local wantedRole = "Damage"
	if roleCounts.Tank == 0 then
		wantedRole = "Tank"
	elseif roleCounts.Support == 0 then
		wantedRole = "Support"
	end

	local candidates = {}
	for _, hero in Heroes.GetOrdered() do
		if hero.Role == wantedRole and (Config.Match.AllowDuplicateHeroes or not taken[hero.Id]) then
			table.insert(candidates, hero.Id)
		end
	end
	if #candidates == 0 then
		for _, hero in Heroes.GetOrdered() do
			if Config.Match.AllowDuplicateHeroes or not taken[hero.Id] then
				table.insert(candidates, hero.Id)
			end
		end
	end
	if #candidates == 0 then
		return Heroes.Order[1]
	end
	return candidates[rng:NextInteger(1, #candidates)]
end

--------------------------------------------------------------------------------
-- Brain helpers
--------------------------------------------------------------------------------

local function findTarget(brain)
	local character, root = brain.Character, brain.Root
	local eye = CombatUtil.GetMuzzle(character)
	local best, bestScore, bestDistance = nil, math.huge, math.huge
	for _, enemy in CombatService.GetEnemiesInRadius(character, root.Position, Config.Bots.SightRange) do
		local enemyRoot = CombatUtil.GetRoot(enemy)
		if enemyRoot and eye then
			local distance = (enemyRoot.Position - root.Position).Magnitude
			local score = distance - (if enemy == brain.Target then 15 else 0) -- stick with the current target
			if score < bestScore and CombatService.HasLineOfSight(character, eye, enemyRoot.Position) then
				best, bestScore, bestDistance = enemy, score, distance
			end
		end
	end
	return best, bestDistance
end

-- Supports look for hurt teammates to heal with their primary fire.
local function findHurtAlly(brain, range: number)
	local character, root = brain.Character, brain.Root
	local eye = CombatUtil.GetMuzzle(character)
	local best, lowest = nil, 0.8
	for _, ally in CombatService.GetAlliesInRadius(character, root.Position, range, false) do
		local humanoid = CombatUtil.GetHumanoid(ally)
		local allyRoot = CombatUtil.GetRoot(ally)
		if humanoid and allyRoot and eye then
			local fraction = humanoid.Health / humanoid.MaxHealth
			if fraction < lowest and CombatService.HasLineOfSight(character, eye, allyRoot.Position) then
				best, lowest = ally, fraction
			end
		end
	end
	return best
end

local function predictAim(brain, hero, target: Model): Vector3
	local targetRoot = CombatUtil.GetRoot(target)
	local aim = targetRoot.Position + Vector3.new(0, 0.6, 0)
	local weapon = hero.Primary
	if weapon.Kind == "Projectile" then
		local origin = CombatUtil.GetMuzzle(brain.Character) or brain.Root.Position
		local travelTime = (aim - origin).Magnitude / weapon.ProjectileSpeed
		aim += targetRoot.AssemblyLinearVelocity * Vector3.new(1, 0.3, 1) * travelTime * 0.85
	end
	return aim
end

local function hasClearWalk(from: Vector3, to: Vector3): boolean
	local flatTarget = Vector3.new(to.X, from.Y, to.Z)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = CombatUtil.GetAllCharacters()
	return workspace:Raycast(from, flatTarget - from, params) == nil
end

local function computePath(brain, destination: Vector3)
	brain.PathComputing = true
	brain.NextPathTime = os.clock() + 2.5
	task.spawn(function()
		local path = PathfindingService:CreatePath({
			AgentRadius = 2.2,
			AgentHeight = 5.5,
			AgentCanJump = true,
			WaypointSpacing = 5,
		})
		local ok = pcall(function()
			path:ComputeAsync(brain.Root.Position, destination)
		end)
		brain.PathComputing = false
		if ok and path.Status == Enum.PathStatus.Success then
			brain.Path = path:GetWaypoints()
			brain.PathIndex = 2
			brain.PathGoal = destination
		else
			brain.Path = nil
			brain.PathGoal = nil
		end
	end)
end

local function moveTowards(brain, destination: Vector3?)
	local humanoid, root = brain.Humanoid, brain.Root
	if not destination then
		humanoid:MoveTo(root.Position)
		brain.Path = nil
		return
	end

	local flatDistance = (Vector3.new(destination.X, root.Position.Y, destination.Z) - root.Position).Magnitude
	if flatDistance < 30 and hasClearWalk(root.Position, destination) then
		brain.Path = nil
		humanoid:MoveTo(destination)
	else
		local now = os.clock()
		local goalMoved = brain.PathGoal == nil or (brain.PathGoal - destination).Magnitude > 12
		local throttled = now - (brain.LastPathRequest or 0) < 0.5 -- never more than 2 requests a second
		if not brain.PathComputing and not throttled and (goalMoved or now > brain.NextPathTime) then
			brain.LastPathRequest = now
			computePath(brain, destination)
		end
		local waypoints = brain.Path
		if waypoints then
			local waypoint = waypoints[brain.PathIndex]
			while waypoint and (Vector3.new(waypoint.Position.X, root.Position.Y, waypoint.Position.Z) - root.Position).Magnitude < 3 do
				brain.PathIndex += 1
				waypoint = waypoints[brain.PathIndex]
			end
			if waypoint then
				if waypoint.Action == Enum.PathWaypointAction.Jump then
					humanoid.Jump = true
				end
				humanoid:MoveTo(waypoint.Position)
			else
				brain.Path = nil
				humanoid:MoveTo(destination)
			end
		else
			humanoid:MoveTo(destination)
		end
	end

	-- Unstick: if we barely moved, hop and re-plan.
	local moved = (root.Position - brain.LastPosition).Magnitude
	brain.LastPosition = root.Position
	if moved < 0.3 and flatDistance > 3 then
		brain.StuckTime += Config.Bots.ThinkInterval
		if brain.StuckTime > 0.8 then
			humanoid.Jump = true
			brain.NextPathTime = 0
			brain.StuckTime = 0
		end
	else
		brain.StuckTime = 0
	end
end

local function abilityReady(brain, slot: string): boolean
	if slot == "Ultimate" then
		return ProfileService.GetUltCharge(brain.Profile) >= 100
	end
	return (brain.Character:GetAttribute("CD_" .. slot) or 0) <= workspace:GetServerTimeNow()
end

local function shouldUse(brain, usage: string?, target: Model?, distance: number): boolean
	local health = brain.Humanoid.Health / brain.Humanoid.MaxHealth
	if usage == "Engage" then
		return target ~= nil and distance > 8 and distance < 35
	elseif usage == "Attack" then
		return target ~= nil and distance < 45
	elseif usage == "AttackClose" then
		return target ~= nil and distance < 12
	elseif usage == "Defend" then
		return target ~= nil and distance < 40
	elseif usage == "Escape" then
		return target ~= nil and health < 0.45
	elseif usage == "Travel" then
		return target == nil
			and GameState.Phase == "Battle"
			and (MapService.GetPointPosition() - brain.Root.Position).Magnitude > 50
	elseif usage == "HealAllies" then
		for _, ally in CombatService.GetAlliesInRadius(brain.Character, brain.Root.Position, 20, true) do
			local humanoid = CombatUtil.GetHumanoid(ally)
			if humanoid and humanoid.Health / humanoid.MaxHealth < 0.7 then
				return true
			end
		end
		return false
	elseif usage == "TeamUlt" then
		local allies = CombatService.GetAlliesInRadius(brain.Character, brain.Root.Position, 25, false)
		return target ~= nil and (#allies > 0 or health < 0.6)
	end
	return false
end

local function makeAim(brain, usage: string?, target: Model?)
	local origin = CombatUtil.GetMuzzle(brain.Character) or brain.Root.Position
	local point
	if usage == "Travel" then
		point = MapService.GetPointPosition()
	elseif usage == "Escape" and target then
		local away = brain.Root.Position - CombatUtil.GetRoot(target).Position
		point = brain.Root.Position + CombatUtil.Flatten(away) * 30
	elseif target then
		point = CombatUtil.GetRoot(target).Position
	else
		point = origin + brain.Root.CFrame.LookVector * 30
	end
	local direction = point - origin
	direction = if direction.Magnitude > 0.1 then direction.Unit else brain.Root.CFrame.LookVector
	return { Direction = direction, Point = point }
end

local function tryAbilities(brain, hero, target: Model?, distance: number)
	local hints = hero.Bot or {}
	for _, slot in { "Ultimate", "Ability1", "Ability2" } do
		local usage = hints[slot]
		if abilityReady(brain, slot) and shouldUse(brain, usage, target, distance) then
			if AbilityService.TryUse(brain.Character, slot, makeAim(brain, usage, target)) then
				return
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Thinking
--------------------------------------------------------------------------------

local function think(brain)
	local character, humanoid, root, profile = brain.Character, brain.Humanoid, brain.Root, brain.Profile
	local hero = Heroes.Get(character:GetAttribute("Hero"))
	if not hero then
		return
	end
	local now = os.clock()
	local phase = GameState.Phase
	local fighting = phase == "Battle"

	-- 1. Target
	if now >= brain.NextTargetScan then
		brain.NextTargetScan = now + 0.3
		local target, distance = findTarget(brain)
		if target ~= brain.Target then
			brain.TargetSince = now
		end
		brain.Target, brain.TargetDistance = target, distance
	end
	local target = brain.Target
	if target and not CombatUtil.IsAlive(target) then
		target = nil
		brain.Target = nil
	end
	local targetRoot = target and CombatUtil.GetRoot(target)
	local distance = if targetRoot then (targetRoot.Position - root.Position).Magnitude else math.huge

	-- 2. Retreat when badly hurt, return when healed.
	local healthFraction = humanoid.Health / humanoid.MaxHealth
	if healthFraction < Config.Bots.RetreatHealthFraction then
		brain.Retreating = true
	elseif healthFraction > 0.9 then
		brain.Retreating = false
	end

	-- 3. Where to go
	if now > brain.NextStrafeFlip then
		brain.StrafeDirection = -brain.StrafeDirection
		brain.NextStrafeFlip = now + rng:NextNumber(0.6, 1.6)
	end
	local destination = nil
	if not fighting then
		destination = nil -- wait in spawn during setup
	elseif brain.Retreating then
		brain.HomePoint = brain.HomePoint or MapService.GetSpawnCFrame(profile.Team).Position
		destination = brain.HomePoint
	else
		brain.HomePoint = nil
		local preferred = hero.Bot and hero.Bot.PreferredRange or 20
		if targetRoot and distance < preferred * 1.6 then
			local toward = CombatUtil.Flatten(targetRoot.Position - root.Position)
			local side = Vector3.new(-toward.Z, 0, toward.X) * brain.StrafeDirection
			if distance > preferred + 4 then
				destination = root.Position + toward * 8 + side * 3
			elseif distance < preferred - 4 then
				destination = root.Position - toward * 6 + side * 3
			else
				destination = root.Position + side * 6
			end
		else
			if not brain.PointSpot or now > brain.NextSpotTime then
				local angle = rng:NextNumber() * math.pi * 2
				local radius = rng:NextNumber() * 10
				brain.PointSpot = MapService.GetPointPosition() + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
				brain.NextSpotTime = now + rng:NextNumber(3, 6)
			end
			destination = brain.PointSpot
		end
	end
	moveTowards(brain, destination)

	-- 4. Shoot (or heal a teammate if this hero's gun heals)
	local aimTarget = nil
	if fighting and hero.Primary.Heal and not (target and distance < 15) then
		aimTarget = findHurtAlly(brain, 60)
	end
	if not aimTarget and target and now - brain.TargetSince >= Config.Bots.ReactionTime then
		local weapon = hero.Primary
		local reach = if weapon.Kind == "Melee" then weapon.Range + 1.5 else math.min(weapon.Range, Config.Bots.SightRange)
		if distance <= reach then
			aimTarget = target
		end
	end
	if aimTarget and fighting then
		WeaponService.BotFire(character, predictAim(brain, hero, aimTarget))
		brain.FacePosition = CombatUtil.GetRoot(aimTarget).Position
	else
		brain.FacePosition = if targetRoot then targetRoot.Position else nil
		if not target and (character:GetAttribute("Ammo") or 0) < (character:GetAttribute("MaxAmmo") or 0) then
			WeaponService.Reload(character)
		end
	end

	-- 5. Abilities
	if fighting and now >= brain.NextAbilityCheck then
		brain.NextAbilityCheck = now + 0.4
		tryAbilities(brain, hero, target, distance)
	end
end

function BotService.OnSpawned(profile, character: Model)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = CombatUtil.GetRoot(character)
	if not humanoid or not root then
		return
	end
	pcall(function()
		root:SetNetworkOwner(nil) -- the server simulates bots
	end)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
	setupAnimations(humanoid)

	brains[profile.Id] = {
		Profile = profile,
		Character = character,
		Humanoid = humanoid,
		Root = root,
		Target = nil,
		TargetDistance = math.huge,
		TargetSince = 0,
		NextTargetScan = 0,
		Path = nil,
		PathIndex = 0,
		PathGoal = nil,
		PathComputing = false,
		NextPathTime = 0,
		LastPosition = root.Position,
		StuckTime = 0,
		StrafeDirection = 1,
		NextStrafeFlip = 0,
		PointSpot = nil,
		NextSpotTime = 0,
		Retreating = false,
		HomePoint = nil,
		NextAbilityCheck = 0,
		FacePosition = nil,
	}
end

function BotService.Init()
	task.spawn(function()
		while true do
			task.wait(Config.Bots.ThinkInterval)
			for id, brain in brains do
				local alive = brain.Profile.Character == brain.Character and CombatUtil.IsAlive(brain.Character)
				if not alive or ProfileService.Get(id) ~= brain.Profile then
					brains[id] = nil
				else
					local ok, err = pcall(think, brain)
					if not ok then
						warn("[BotService] " .. tostring(err))
					end
				end
			end
		end
	end)

	-- Turn bots to face whoever they are fighting (every frame, for smooth aiming).
	RunService.Heartbeat:Connect(function()
		for _, brain in brains do
			local face = brain.FacePosition
			if face and brain.Root.Parent then
				brain.Humanoid.AutoRotate = false
				local position = brain.Root.Position
				local flat = Vector3.new(face.X, position.Y, face.Z)
				if (flat - position).Magnitude > 0.5 then
					brain.Root.CFrame = CFrame.lookAt(position, flat)
				end
			else
				brain.Humanoid.AutoRotate = true
			end
		end
	end)
end

return BotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[--[[
	CombatService
	=============
	The single place where damage and healing happen. Everything (guns, abilities, explosions,
	spawn rooms) goes through Damage/Heal so multipliers, shields, stats, ultimate charge and
	kill credit always work the same way.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Heroes = require(Shared.Heroes)
local CombatUtil = require(Shared.CombatUtil)
local Remotes = require(Shared.Remotes)
local Signal = require(Shared.Signal)

local GameState = require(script.Parent.GameState)
local ProfileService = require(script.Parent.ProfileService)
local StatusService = require(script.Parent.StatusService)
local SynergyService = require(script.Parent.SynergyService)
local DestructibleService = require(script.Parent.DestructibleService)
local FX = require(script.Parent.FX)

local CombatService = {}

CombatService.Killed = Signal.new() -- (victimProfile, killerProfile?, assistProfiles)

function CombatService.CanDamage(attacker: Model?, target: Model): boolean
	if not GameState.DamageEnabled or not CombatUtil.IsAlive(target) then
		return false
	end
	if attacker then
		if attacker == target then
			return false
		end
		if not Config.Combat.FriendlyFire and not CombatUtil.AreEnemies(attacker, target) then
			return false
		end
	end
	return true
end

function CombatService.AddUltPoints(profile, points: number)
	if points <= 0 or os.clock() < (profile.UltActiveUntil or 0) then
		return
	end
	local hero = Heroes.Get(profile.HeroId)
	if not hero then
		return
	end
	local current = ProfileService.GetUltCharge(profile)
	if current < 100 then
		ProfileService.SetUltCharge(profile, current + points / hero.UltCost * 100)
	end
end

-- Deals damage. `attacker` may be nil for environmental damage. Returns damage actually dealt.
-- info = { Ability = "Talon Rifle", Headshot = true, Position = Vector3 }
function CombatService.Damage(attacker: Model?, target: Model, amount: number, info): number
	info = info or {}
	if not CombatService.CanDamage(attacker, target) then
		return 0
	end
	local humanoid = target:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return 0
	end

	if attacker then
		amount *= StatusService.GetMultiplier(attacker, "DamageDealt")
		amount *= SynergyService.GetBonus(attacker, "DamageMult", 1)
	end
	amount *= StatusService.GetMultiplier(target, "DamageTaken")
	if amount <= 0 then
		return 0
	end

	-- Shields soak damage first.
	local shield = target:GetAttribute("Shield") or 0
	local absorbed = math.min(shield, amount)
	if absorbed > 0 then
		target:SetAttribute("Shield", shield - absorbed)
	end
	local before = humanoid.Health
	humanoid.Health = math.max(0, before - (amount - absorbed))
	local dealt = absorbed + (before - humanoid.Health)
	local killed = humanoid.Health <= 0

	local victim = ProfileService.GetByCharacter(target)
	local source = attacker and ProfileService.GetByCharacter(attacker)
	if victim and source and source ~= victim then
		victim.DamageLog[source.Id] = os.clock()
		victim.LastAttackerId = source.Id
		victim.LastAbility = info.Ability
	end

	if source then
		ProfileService.AddStat(source, "Damage", dealt)
		CombatService.AddUltPoints(source, dealt)
		if source.Player then
			local targetRoot = CombatUtil.GetRoot(target)
			Remotes.HitConfirm:FireClient(source.Player, {
				Position = info.Position or (if targetRoot then targetRoot.Position else nil),
				Amount = math.floor(dealt + 0.5),
				Headshot = info.Headshot == true,
				Kill = killed,
			})
		end
	end

	if victim and victim.Player then
		local attackerRoot = attacker and CombatUtil.GetRoot(attacker)
		Remotes.Damaged:FireClient(victim.Player, {
			From = if attackerRoot then attackerRoot.Position else nil,
			Amount = dealt,
		})
	end

	return dealt
end

-- Heals `target`. `healer` may be nil (spawn rooms). Returns health actually restored.
function CombatService.Heal(healer: Model?, target: Model, amount: number, info): number
	if not CombatUtil.IsAlive(target) then
		return 0
	end
	if healer and healer ~= target and CombatUtil.AreEnemies(healer, target) then
		return 0
	end
	if healer then
		amount *= SynergyService.GetBonus(healer, "HealingMult", 1)
	end
	local humanoid = target:FindFirstChildOfClass("Humanoid")
	local before = humanoid.Health
	humanoid.Health = math.min(humanoid.MaxHealth, before + amount)
	local healed = humanoid.Health - before

	if healed > 0 and healer then
		local source = ProfileService.GetByCharacter(healer)
		if source then
			ProfileService.AddStat(source, "Healing", healed)
			CombatService.AddUltPoints(source, healed)
			if source.Player and not (info and info.Silent) then
				local targetRoot = CombatUtil.GetRoot(target)
				Remotes.HitConfirm:FireClient(source.Player, {
					Position = if targetRoot then targetRoot.Position else nil,
					Amount = math.floor(healed + 0.5),
					Heal = true,
				})
			end
		end
	end
	return healed
end

-- Living fighters within `radius` of `center` that pass `filter`.
function CombatService.GetCharactersInRadius(center: Vector3, radius: number, filter)
	local results = {}
	for _, profile in ProfileService.All() do
		local character = profile.Character
		if character and CombatUtil.IsAlive(character) then
			local root = CombatUtil.GetRoot(character)
			if root and (root.Position - center).Magnitude <= radius then
				if not filter or filter(character) then
					table.insert(results, character)
				end
			end
		end
	end
	return results
end

function CombatService.GetEnemiesInRadius(source: Model, center: Vector3, radius: number)
	return CombatService.GetCharactersInRadius(center, radius, function(character)
		return character ~= source and CombatUtil.AreEnemies(source, character)
	end)
end

function CombatService.GetAlliesInRadius(source: Model, center: Vector3, radius: number, includeSelf: boolean?)
	local team = source:GetAttribute("Team")
	return CombatService.GetCharactersInRadius(center, radius, function(character)
		if character == source then
			return includeSelf == true
		end
		return team ~= nil and character:GetAttribute("Team") == team
	end)
end

-- True if nothing solid (walls, enemy barriers) is between two points.
function CombatService.HasLineOfSight(source: Model?, from: Vector3, to: Vector3): boolean
	local offset = to - from
	if offset.Magnitude < 0.5 then
		return true
	end
	local params
	if source then
		params = CombatUtil.ShotParams(source, true)
	else
		params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = CombatUtil.GetAllCharacters()
	end
	local result = workspace:Raycast(from, offset, params)
	return result == nil or (result.Position - to).Magnitude < 1.5
end

-- Area damage. Full damage at the centre, `MinFalloff` (default 50%) at the edge.
-- options = { Ability, MinFalloff, IgnoreCover, OnHit = function(character, dealt) }
function CombatService.Explode(attacker: Model, position: Vector3, radius: number, damage: number, options)
	options = options or {}
	local minFalloff = options.MinFalloff or 0.5
	local hit = {}
	for _, profile in ProfileService.All() do
		local character = profile.Character
		if character and CombatService.CanDamage(attacker, character) then
			local root = CombatUtil.GetRoot(character)
			if root then
				local distance = (root.Position - position).Magnitude
				if
					distance <= radius + 1
					and (options.IgnoreCover or CombatService.HasLineOfSight(attacker, position, root.Position))
				then
					local scale = 1 - (1 - minFalloff) * math.clamp(distance / radius, 0, 1)
					local dealt = CombatService.Damage(attacker, character, damage * scale, {
						Ability = options.Ability,
						Position = root.Position,
					})
					if dealt > 0 then
						table.insert(hit, character)
						if options.OnHit then
							options.OnHit(character, dealt)
						end
					end
				end
			end
		end
	end
	DestructibleService.DamageInRadius(position, radius, damage, attacker)
	return hit
end

-- Called when a fighter's Humanoid dies: works out the killer and assists, updates stats,
-- posts to the kill feed and tells the match to start the respawn timer.
function CombatService.HandleDeath(character: Model)
	local victim = ProfileService.GetByCharacter(character)
	if not victim or victim.Character ~= character or victim.DeathHandledFor == character then
		return
	end
	victim.DeathHandledFor = character

	local now = os.clock()
	local window = Config.Match.AssistWindow
	local killer = nil
	local lastId = victim.LastAttackerId
	if lastId and victim.DamageLog[lastId] and now - victim.DamageLog[lastId] <= window then
		killer = ProfileService.Get(lastId)
	end
	local assists = {}
	for attackerId, time in victim.DamageLog do
		if attackerId ~= lastId and now - time <= window then
			local assister = ProfileService.Get(attackerId)
			if assister then
				table.insert(assists, assister)
			end
		end
	end
	victim.DamageLog = {}
	victim.LastAttackerId = nil

	ProfileService.AddStat(victim, "Deaths", 1)
	if killer then
		ProfileService.AddStat(killer, "Kills", 1)
	end
	for _, assister in assists do
		ProfileService.AddStat(assister, "Assists", 1)
	end

	FX.Notify("Kill", {
		KillerName = if killer then killer.Name else nil,
		KillerHero = if killer then killer.HeroId else nil,
		KillerTeam = if killer then killer.Team else nil,
		VictimName = victim.Name,
		VictimHero = victim.HeroId,
		VictimTeam = victim.Team,
		Ability = if killer then victim.LastAbility else nil,
	})
	FX.NotifyPlayer(victim.Player, "Eliminated", {
		By = if killer then killer.Name else nil,
		ByHero = if killer then killer.HeroId else nil,
	})
	if killer then
		FX.NotifyPlayer(killer.Player, "KillConfirmed", { Victim = victim.Name })
	end

	CombatService.Killed:Fire(victim, killer, assists)
end

return CombatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">DestructibleService</string>
            <string name="Source"><![CDATA[--[[
	DestructibleService
	===================
	Any part tagged "Destructible" can be shot to pieces. Give it a MaxHealth attribute (default 200)
	and optionally RespawnTime (seconds, default 30). Broken cover rebuilds itself later, and all
	cover is restored at the start of every round.

	Barriers (like Bulwark's Aegis Wall) are destructibles with a "Team" attribute (their own team
	cannot damage them) and "Permanent" = true (they are deleted instead of rebuilt).
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CombatUtil = require(Shared.CombatUtil)
local GameState = require(script.Parent.GameState)
local FX = require(script.Parent.FX)

local TAG = "Destructible"
local DEFAULT_HEALTH = 200
local DEFAULT_RESPAWN = 30

local DestructibleService = {}

local originals = {} -- [part] = saved look, so it can be rebuilt
local broken = {} -- [part] = os.clock() time to rebuild

local function setup(instance)
	if not instance:IsA("BasePart") or originals[instance] then
		return
	end
	local maxHealth = instance:GetAttribute("MaxHealth") or DEFAULT_HEALTH
	instance:SetAttribute("MaxHealth", maxHealth)
	instance:SetAttribute("Health", maxHealth)
	originals[instance] = {
		Color = instance.Color,
		Transparency = instance.Transparency,
		CanCollide = instance.CanCollide,
		CanQuery = instance.CanQuery,
	}
	instance.AncestryChanged:Connect(function()
		if not instance:IsDescendantOf(game) then
			originals[instance] = nil
			broken[instance] = nil
		end
	end)
end

local function restore(part: BasePart)
	local original = originals[part]
	if not original then
		return
	end
	part.Color = original.Color
	part.Transparency = original.Transparency
	part.CanCollide = original.CanCollide
	part.CanQuery = original.CanQuery
	part:SetAttribute("Health", part:GetAttribute("MaxHealth"))
	broken[part] = nil
end

local function shatter(part: BasePart)
	local original = originals[part]
	FX.All("Shatter", {
		CFrame = part.CFrame,
		Size = part.Size,
		Color = if original then original.Color else part.Color,
		Material = part.Material,
	})
	if part:GetAttribute("Permanent") then
		part:Destroy()
		return
	end
	part.Transparency = 1
	part.CanCollide = false
	part.CanQuery = false
	broken[part] = os.clock() + (part:GetAttribute("RespawnTime") or DEFAULT_RESPAWN)
end

function DestructibleService.IsDestructible(part): boolean
	return part ~= nil and originals[part] ~= nil and (part:GetAttribute("Health") or 0) > 0
end

function DestructibleService.Damage(part: BasePart, amount: number, attacker: Model?): number
	if not DestructibleService.IsDestructible(part) or not GameState.DamageEnabled or amount <= 0 then
		return 0
	end
	local team = part:GetAttribute("Team")
	if team and attacker and attacker:GetAttribute("Team") == team then
		return 0 -- you can't break your own team's barrier
	end

	local health = part:GetAttribute("Health")
	local dealt = math.min(health, amount)
	health -= dealt
	part:SetAttribute("Health", health)

	if health <= 0 then
		shatter(part)
	elseif not team then
		-- Cover gets darker as it is damaged so players can see it is about to break.
		local original = originals[part]
		local fraction = health / part:GetAttribute("MaxHealth")
		part.Color = original.Color:Lerp(Color3.new(0.08, 0.08, 0.08), (1 - fraction) * 0.55)
	end
	return dealt
end

-- Explosions damage every destructible within `radius` (less at the edge).
function DestructibleService.DamageInRadius(position: Vector3, radius: number, damage: number, attacker: Model?)
	for part in originals do
		if part.Parent and (part:GetAttribute("Health") or 0) > 0 then
			local relative = part.CFrame:PointToObjectSpace(position)
			local half = part.Size / 2
			local closest = Vector3.new(
				math.clamp(relative.X, -half.X, half.X),
				math.clamp(relative.Y, -half.Y, half.Y),
				math.clamp(relative.Z, -half.Z, half.Z)
			)
			local distance = (relative - closest).Magnitude
			if distance <= radius then
				DestructibleService.Damage(part, damage * (1 - 0.5 * distance / radius), attacker)
			end
		end
	end
end

-- Rebuild everything (start of a round).
function DestructibleService.ResetAll()
	for part in originals do
		if part.Parent then
			restore(part)
		end
	end
end

function DestructibleService.Init()
	for _, instance in CollectionService:GetTagged(TAG) do
		setup(instance)
	end
	CollectionService:GetInstanceAddedSignal(TAG):Connect(setup)

	-- Rebuild broken cover once its timer is up, but never on top of someone.
	task.spawn(function()
		while true do
			task.wait(1)
			local now = os.clock()
			for part, rebuildAt in broken do
				if now >= rebuildAt then
					local params = OverlapParams.new()
					params.FilterType = Enum.RaycastFilterType.Include
					params.FilterDescendantsInstances = CombatUtil.GetAllCharacters()
					if #workspace:GetPartBoundsInBox(part.CFrame, part.Size, params) == 0 then
						restore(part)
					else
						broken[part] = now + 2
					end
				end
			end
		end
	end)
end

return DestructibleService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">FX</string>
            <string name="Source"><![CDATA[--[[
	FX
	==
	Helpers for sending visual effects and messages to clients. The server decides WHAT happens;
	each client draws it (see the client's FXController and HUDController).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared").Remotes)

local FX = {}

-- Visual effect for everyone.
function FX.All(kind: string, data)
	Remotes.FX:FireAllClients(kind, data)
end

-- Visual effect for everyone except `player` (who already drew it locally for instant feedback).
function FX.Except(player: Player?, kind: string, data)
	if not player then
		FX.All(kind, data)
		return
	end
	for _, other in Players:GetPlayers() do
		if other ~= player then
			Remotes.FX:FireClient(other, kind, data)
		end
	end
end

-- Kill feed entries, banners and other messages for everyone.
function FX.Notify(kind: string, data)
	Remotes.Notify:FireAllClients(kind, data)
end

function FX.NotifyPlayer(player: Player?, kind: string, data)
	if player then
		Remotes.Notify:FireClient(player, kind, data)
	end
end

return FX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">GameState</string>
            <string name="Source"><![CDATA[--[[
	GameState
	=========
	The current match phase and scoreboard numbers. Values are mirrored onto
	ReplicatedStorage.MatchState as attributes so every client can read them for the HUD.

	Phases: "Waiting" -> "Intermission" -> ("Setup" -> "Battle" -> "RoundEnd") x rounds -> "MatchEnd"
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameState = {}

GameState.Phase = "Waiting"
GameState.DamageEnabled = false

local folder = ReplicatedStorage:FindFirstChild("MatchState")
if not folder then
	folder = Instance.new("Folder")
	folder.Name = "MatchState"
	folder.Parent = ReplicatedStorage
end
GameState.Folder = folder

function GameState.Set(key: string, value)
	folder:SetAttribute(key, value)
end

function GameState.Get(key: string)
	return folder:GetAttribute(key)
end

-- `duration` (seconds) lets clients show a countdown; nil means "no timer".
function GameState.SetPhase(phase: string, duration: number?)
	GameState.Phase = phase
	GameState.DamageEnabled = phase == "Battle"
	folder:SetAttribute("Phase", phase)
	folder:SetAttribute("PhaseEndsAt", if duration then workspace:GetServerTimeNow() + duration else 0)
end

GameState.SetPhase("Waiting", nil)

return GameState
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">HeroService</string>
            <string name="Source"><![CDATA[--[[
	HeroService
	===========
	Turns a profile into a living character: loads the player's avatar (or builds a bot body),
	applies the hero's stats and gear, and wires up death handling.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Heroes = require(Shared.Heroes)
local CombatUtil = require(Shared.CombatUtil)
local Signal = require(Shared.Signal)

local ProfileService = require(script.Parent.ProfileService)
local StatusService = require(script.Parent.StatusService)
local SynergyService = require(script.Parent.SynergyService)
local CombatService = require(script.Parent.CombatService)
local WeaponService = require(script.Parent.WeaponService)
local MapService = require(script.Parent.MapService)
local BotService = require(script.Parent.BotService)
local HeroVisuals = require(script.Parent.HeroVisuals)

local HeroService = {}

HeroService.Spawned = Signal.new() -- (profile, character)

-- Accessories (hats, hair...) shouldn't block shots or count as hits.
local function prepareDescendant(descendant: Instance)
	if descendant:IsA("BasePart") then
		descendant.CollisionGroup = "Characters"
		if descendant.Parent and descendant.Parent:IsA("Accessory") then
			descendant.CanQuery = false
			descendant.CanTouch = false
			descendant.Massless = true
		end
	end
end

local function applyHero(profile, character: Model, spawnCFrame: CFrame)
	local hero = Heroes.Get(profile.HeroId)
	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
	if not hero or not humanoid then
		return false
	end

	character:SetAttribute("CombatantId", profile.Id)
	character:SetAttribute("Team", profile.Team)
	character:SetAttribute("Hero", hero.Id)
	character:SetAttribute("BaseWalkSpeed", hero.WalkSpeed)
	character:SetAttribute("SpawnYaw", CombatUtil.YawFromLook(spawnCFrame.LookVector))
	character:SetAttribute("CD_Ability1", 0)
	character:SetAttribute("CD_Ability2", 0)

	local maxHealth = hero.MaxHealth + SynergyService.GetBonus(profile, "MaxHealthBonus", 0)
	humanoid.MaxHealth = maxHealth
	humanoid.Health = maxHealth
	humanoid.WalkSpeed = hero.WalkSpeed
	humanoid.UseJumpPower = false
	humanoid.JumpHeight = hero.JumpHeight
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None -- we draw our own nameplates

	for _, descendant in character:GetDescendants() do
		prepareDescendant(descendant)
	end
	character.DescendantAdded:Connect(prepareDescendant)

	HeroVisuals.Apply(character, hero, Config.GetTeamColor(profile.Team))
	StatusService.Setup(character, hero.WalkSpeed)
	WeaponService.Setup(character, hero)

	humanoid.Died:Connect(function()
		CombatService.HandleDeath(character)
		StatusService.Clear(character)
		WeaponService.Clear(character)
	end)
	return true
end

-- Spawns (or respawns) a fighter at their team's spawn. Yields while the avatar loads.
function HeroService.Spawn(profile)
	if profile.Spawning or not profile.Team or not Heroes.Get(profile.HeroId) then
		return
	end
	profile.Spawning = true
	profile.RespawnAt = nil
	profile.Folder:SetAttribute("RespawnAt", 0)

	local spawnCFrame = MapService.GetSpawnCFrame(profile.Team)
	local character

	if profile.Player then
		local player = profile.Player
		if player.Parent == Players then
			local ok, err = pcall(function()
				player:LoadCharacter()
			end)
			if not ok then
				warn("[HeroService] LoadCharacter failed: " .. tostring(err))
			end
			character = player.Character
		end
	else
		if profile.Character then
			profile.Character:Destroy()
			profile.Character = nil
		end
		character = BotService.CreateCharacter(profile, Heroes.Get(profile.HeroId))
	end

	-- The player may have left, or the bot removed, while the avatar was loading.
	if not character or ProfileService.Get(profile.Id) ~= profile then
		if character and not profile.Player then
			character:Destroy()
		end
		profile.Spawning = false
		return
	end

	if not applyHero(profile, character, spawnCFrame) then
		profile.Spawning = false
		return
	end
	character:PivotTo(spawnCFrame)
	if not profile.Player then
		character.Parent = workspace
		BotService.OnSpawned(profile, character)
	end

	profile.Character = character
	profile.DeathHandledFor = nil
	profile.Folder:SetAttribute("Alive", true)
	profile.Spawning = false
	HeroService.Spawned:Fire(profile, character)
end

-- Removes a fighter's body (between matches).
function HeroService.Despawn(profile)
	local character = profile.Character
	profile.Character = nil
	profile.RespawnAt = nil
	profile.Folder:SetAttribute("Alive", false)
	profile.Folder:SetAttribute("RespawnAt", 0)
	if character then
		character:Destroy()
	end
	if profile.Player and profile.Player.Character then
		profile.Player.Character:Destroy()
		profile.Player.Character = nil
	end
end

return HeroService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">HeroVisuals</string>
            <string name="Source"><![CDATA[--[[
	HeroVisuals
	===========
	Gives each hero a recognisable look by welding simple "gear" parts (shoulder pads, visors,
	weapons, halos...) onto the player's own avatar. Works on R15 and R6 bodies.

	Want real models? Replace a hero's builder with code that clones a Model from ServerStorage
	and welds it on the same way.
]]

local HeroVisuals = {}

local DARK = Color3.fromRGB(35, 38, 48)
local ROTATE_UPRIGHT = CFrame.Angles(0, 0, math.rad(90)) -- turns a cylinder from lying down to standing

local function findPart(character: Model, names): BasePart?
	for _, name in names do
		local part = character:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			return part
		end
	end
	return nil
end

local TORSO = { "UpperTorso", "Torso" }
local HEAD = { "Head" }
local LEFT_ARM = { "LeftUpperArm", "Left Arm" }
local RIGHT_ARM = { "RightUpperArm", "Right Arm" }

-- Welds a part to a body part at `offset` (relative to that body part).
local function gear(folder: Model, body: BasePart?, size: Vector3, offset: CFrame, color: Color3, props)
	if not body then
		return nil
	end
	props = props or {}
	local part = Instance.new("Part")
	part.Name = "Gear"
	part.Size = size
	part.Shape = props.Shape or Enum.PartType.Block
	part.Material = props.Material or Enum.Material.SmoothPlastic
	part.Color = color
	part.Transparency = props.Transparency or 0
	part.CanCollide = false
	part.CanQuery = false -- gear never blocks or absorbs shots
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = false
	part.CFrame = body.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = body
	weld.Part1 = part
	weld.Parent = part
	part.Parent = folder
	return part
end

local builders = {}

function builders.Bulwark(character, folder, hero)
	local torso, leftArm, rightArm = findPart(character, TORSO), findPart(character, LEFT_ARM), findPart(character, RIGHT_ARM)
	gear(folder, leftArm, Vector3.new(1.4, 0.55, 1.4), CFrame.new(0, 0.6, 0), hero.Color, { Material = Enum.Material.Metal })
	gear(folder, rightArm, Vector3.new(1.4, 0.55, 1.4), CFrame.new(0, 0.6, 0), hero.Color, { Material = Enum.Material.Metal })
	-- arm shield and cannon
	gear(folder, leftArm, Vector3.new(0.3, 2.4, 2), CFrame.new(-0.75, -0.6, 0), hero.AccentColor, { Material = Enum.Material.Neon, Transparency = 0.35 })
	gear(folder, torso, Vector3.new(0.9, 0.9, 3.2), CFrame.new(1.35, -0.3, -1.3), DARK, { Material = Enum.Material.Metal })
	gear(folder, torso, Vector3.new(0.6, 0.6, 0.3), CFrame.new(1.35, -0.3, -2.95), hero.AccentColor, { Material = Enum.Material.Neon })
end

function builders.Kestrel(character, folder, hero)
	local torso, head = findPart(character, TORSO), findPart(character, HEAD)
	gear(folder, head, Vector3.new(1.05, 0.3, 0.25), CFrame.new(0, 0.15, -0.55), hero.AccentColor, { Material = Enum.Material.Neon })
	gear(folder, torso, Vector3.new(1.3, 1.4, 0.6), CFrame.new(0, 0.1, 0.8), hero.Color, { Material = Enum.Material.Metal })
	gear(folder, torso, Vector3.new(0.35, 0.5, 3.6), CFrame.new(1.2, -0.2, -1.5), DARK, { Material = Enum.Material.Metal })
	gear(folder, torso, Vector3.new(0.4, 0.25, 0.9), CFrame.new(1.2, 0.15, -0.9), hero.AccentColor, { Material = Enum.Material.Neon })
end

function builders.Volta(character, folder, hero)
	local torso, head = findPart(character, TORSO), findPart(character, HEAD)
	gear(folder, torso, Vector3.new(1.1, 1.1, 1.1), CFrame.new(1.7, 0.9, -0.7), hero.AccentColor, { Shape = Enum.PartType.Ball, Material = Enum.Material.Neon })
	gear(folder, head, Vector3.new(0.15, 1.5, 1.5), CFrame.new(0, 0.8, 0) * ROTATE_UPRIGHT, hero.AccentColor, { Shape = Enum.PartType.Cylinder, Material = Enum.Material.Neon, Transparency = 0.3 })
	gear(folder, torso, Vector3.new(2.1, 0.3, 1.2), CFrame.new(0, 0.95, 0), hero.Color, { Material = Enum.Material.Metal })
end

function builders.Kaida(character, folder, hero)
	local torso, head = findPart(character, TORSO), findPart(character, HEAD)
	gear(folder, torso, Vector3.new(0.15, 0.4, 3), CFrame.new(1.2, -0.6, -1.3), hero.AccentColor, { Material = Enum.Material.Neon })
	gear(folder, torso, Vector3.new(0.15, 0.4, 3), CFrame.new(-1.2, -0.6, -1.3), hero.AccentColor, { Material = Enum.Material.Neon })
	gear(folder, head, Vector3.new(1.05, 0.45, 0.2), CFrame.new(0, -0.2, -0.55), DARK)
	gear(folder, torso, Vector3.new(1.4, 0.35, 1.1), CFrame.new(0, 1.0, 0.1), hero.Color, { Material = Enum.Material.Fabric })
end

function builders.Lumen(character, folder, hero)
	local torso, head = findPart(character, TORSO), findPart(character, HEAD)
	gear(folder, head, Vector3.new(0.12, 1.9, 1.9), CFrame.new(0, 1.1, 0) * ROTATE_UPRIGHT, hero.AccentColor, { Shape = Enum.PartType.Cylinder, Material = Enum.Material.Neon, Transparency = 0.25 })
	gear(folder, torso, Vector3.new(5, 0.25, 0.25), CFrame.new(1.35, 0, -0.5) * ROTATE_UPRIGHT, hero.Color, { Shape = Enum.PartType.Cylinder, Material = Enum.Material.Metal })
	gear(folder, torso, Vector3.new(0.8, 0.8, 0.8), CFrame.new(1.35, 2.6, -0.5), hero.AccentColor, { Shape = Enum.PartType.Ball, Material = Enum.Material.Neon })
end

function HeroVisuals.Apply(character: Model, hero, teamColor: Color3)
	local existing = character:FindFirstChild("HeroGear")
	if existing then
		existing:Destroy()
	end
	local folder = Instance.new("Model")
	folder.Name = "HeroGear"
	folder.Parent = character

	local builder = builders[hero.Id]
	if builder then
		builder(character, folder, hero)
	end
	-- A team-coloured chest light on every hero so teams are easy to tell apart.
	gear(folder, findPart(character, TORSO), Vector3.new(0.9, 0.5, 0.15), CFrame.new(0, 0.25, -0.55), teamColor, { Material = Enum.Material.Neon })
end

return HeroVisuals
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">MapService</string>
            <string name="Source"><![CDATA[--[[
	MapService
	==========
	Finds (or builds) Workspace.Map and answers questions about it: where to spawn, where the
	control point is, whether someone is standing in a spawn room, and opening the spawn doors.

	See Map/MapBuilder.luau for the pieces a custom map needs.
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local MapBuilder = require(script.Parent.Parent.Map.MapBuilder)

local MapService = {}

local map: Model? = nil
local effects: Folder? = nil
local rng = Random.new()

function MapService.Init()
	map = workspace:FindFirstChild("Map")
	if not map then
		-- No map in the place (e.g. scripts were copied in by hand), so build the default arena.
		map = MapBuilder.Build(Config.Teams)
		map.Parent = workspace
		MapBuilder.SetupLighting(Lighting)
	end

	for _, required in { "Spawns", "SpawnRooms", "SpawnDoors", "ControlPoint" } do
		if not map:FindFirstChild(required) then
			warn("[MapService] Workspace.Map is missing '" .. required .. "'. See MapBuilder.luau for what a map needs.")
		end
	end

	effects = workspace:FindFirstChild("Effects")
	if not effects then
		effects = Instance.new("Folder")
		effects.Name = "Effects"
		effects.Parent = workspace
	end
end

function MapService.GetMap()
	return map
end

-- Server-made visuals (barriers, zones) live here and are wiped between rounds.
function MapService.GetEffectsFolder(): Folder
	return effects :: Folder
end

function MapService.ClearEffects()
	if effects then
		effects:ClearAllChildren()
	end
end

function MapService.GetControlPoint(): BasePart?
	local point = map and map:FindFirstChild("ControlPoint")
	return if point and point:IsA("BasePart") then point else nil
end

function MapService.GetPointPosition(): Vector3
	local point = MapService.GetControlPoint()
	return if point then point.Position else Vector3.new(0, 2, 0)
end

-- A random spawn spot for `team`, facing the objective.
function MapService.GetSpawnCFrame(team: string): CFrame
	local pads = {}
	local spawns = map and map:FindFirstChild("Spawns")
	local folder = spawns and spawns:FindFirstChild(team)
	if folder then
		for _, child in folder:GetChildren() do
			if child:IsA("BasePart") then
				table.insert(pads, child)
			end
		end
	end
	if #pads == 0 then
		warn("[MapService] No spawn pads for team " .. tostring(team))
		return CFrame.new(0, 10, 0)
	end

	local pad = pads[rng:NextInteger(1, #pads)]
	local position = pad.Position
		+ Vector3.new(rng:NextNumber(-1.5, 1.5), pad.Size.Y / 2 + 3.2, rng:NextNumber(-1.5, 1.5))
	local target = MapService.GetPointPosition()
	local lookAt = Vector3.new(target.X, position.Y, target.Z)
	if (lookAt - position).Magnitude < 1 then
		lookAt = position + Vector3.new(0, 0, -1)
	end
	return CFrame.lookAt(position, lookAt)
end

local function insideBox(part: BasePart, position: Vector3): boolean
	local relative = part.CFrame:PointToObjectSpace(position)
	local half = part.Size / 2
	return math.abs(relative.X) <= half.X and math.abs(relative.Y) <= half.Y and math.abs(relative.Z) <= half.Z
end

function MapService.IsInSpawnRoom(position: Vector3, team: string?): boolean
	local rooms = map and map:FindFirstChild("SpawnRooms")
	local room = rooms and team and rooms:FindFirstChild(team)
	return room ~= nil and room:IsA("BasePart") and insideBox(room, position)
end

-- Closed doors are solid and block shots; open doors vanish.
function MapService.SetDoorsOpen(open: boolean)
	local doors = map and map:FindFirstChild("SpawnDoors")
	if not doors then
		return
	end
	for _, door in doors:GetDescendants() do
		if door:IsA("BasePart") then
			door.CanCollide = not open
			door.CanQuery = not open
			door.Transparency = if open then 1 else 0.45
		end
	end
end

return MapService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">MatchService</string>
            <string name="Source"><![CDATA[--[[
	MatchService
	============
	Runs the match loop and everything around it:
	  * players joining/leaving, team balance, filling empty slots with bots
	  * hero selection and swapping
	  * respawns, spawn-room healing, falling off the map
	  * the phases: Waiting -> Intermission -> (Setup -> Battle -> RoundEnd) x N -> MatchEnd
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Teams = game:GetService("Teams")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Heroes = require(Shared.Heroes)
local CombatUtil = require(Shared.CombatUtil)
local Remotes = require(Shared.Remotes)

local GameState = require(script.Parent.GameState)
local ProfileService = require(script.Parent.ProfileService)
local CombatService = require(script.Parent.CombatService)
local HeroService = require(script.Parent.HeroService)
local BotService = require(script.Parent.BotService)
local ObjectiveService = require(script.Parent.ObjectiveService)
local DestructibleService = require(script.Parent.DestructibleService)
local MapService = require(script.Parent.MapService)
local FX = require(script.Parent.FX)

local MatchService = {}

local TEAM_A, TEAM_B = Config.Teams[1].Name, Config.Teams[2].Name
local teamObjects = {}
local rng = Random.new()

--------------------------------------------------------------------------------
-- Teams and bots
--------------------------------------------------------------------------------

local function humans()
	local list = {}
	for _, profile in ProfileService.All() do
		if profile.Player then
			table.insert(list, profile)
		end
	end
	return list
end

local function countOnTeam(team: string, wantBots: boolean?)
	local count = 0
	for _, profile in ProfileService.OnTeam(team) do
		if wantBots == nil or profile.IsBot == wantBots then
			count += 1
		end
	end
	return count
end

local function setTeam(profile, team: string)
	ProfileService.SetTeam(profile, team)
	if profile.Player then
		profile.Player.Team = teamObjects[team]
		profile.Player.Neutral = false
	end
	if profile.Character then
		profile.Character:SetAttribute("Team", team)
	end
end

local function pickTeamForNewPlayer(): string
	local a, b = countOnTeam(TEAM_A, false), countOnTeam(TEAM_B, false)
	if a ~= b then
		return if a < b then TEAM_A else TEAM_B
	end
	return if rng:NextNumber() < 0.5 then TEAM_A else TEAM_B
end

local function matchRunning(): boolean
	local phase = GameState.Phase
	return phase == "Setup" or phase == "Battle" or phase == "RoundEnd"
end

local function nextBotName(): string
	local used = {}
	for _, profile in ProfileService.All() do
		used[profile.Name] = true
	end
	for _, name in Config.Bots.Names do
		local botName = name .. " (Bot)"
		if not used[botName] then
			return botName
		end
	end
	return "Bot " .. rng:NextInteger(100, 999)
end

-- Adds or removes bots so each team has Config.Match.BotsFillTeamsTo fighters.
function MatchService.RebalanceBots()
	local anyHumans = #humans() > 0
	for _, team in { TEAM_A, TEAM_B } do
		local wanted = if anyHumans then math.max(0, Config.Match.BotsFillTeamsTo - countOnTeam(team, false)) else 0
		local bots = {}
		for _, profile in ProfileService.OnTeam(team) do
			if profile.IsBot then
				table.insert(bots, profile)
			end
		end
		while #bots > wanted do
			ProfileService.Remove(table.remove(bots))
		end
		while #bots < wanted do
			local bot = ProfileService.AddBot(nextBotName())
			setTeam(bot, team)
			table.insert(bots, bot)
			if matchRunning() then
				ProfileService.SetHero(bot, BotService.ChooseHero(bot))
				task.spawn(HeroService.Spawn, bot)
			end
		end
	end
end

-- Evens out the human players between matches.
local function balanceHumans()
	local a, b = {}, {}
	for _, profile in humans() do
		table.insert(if profile.Team == TEAM_A then a else b, profile)
	end
	while #a - #b > 1 do
		local moved = table.remove(a, rng:NextInteger(1, #a))
		setTeam(moved, TEAM_B)
		table.insert(b, moved)
	end
	while #b - #a > 1 do
		local moved = table.remove(b, rng:NextInteger(1, #b))
		setTeam(moved, TEAM_A)
		table.insert(a, moved)
	end
end

--------------------------------------------------------------------------------
-- Players
--------------------------------------------------------------------------------

local function onPlayerAdded(player: Player)
	player.DevEnableMouseLock = false -- Shift is an ability key
	local profile = ProfileService.AddPlayer(player)
	setTeam(profile, pickTeamForNewPlayer())
	MatchService.RebalanceBots()
end

local function onPlayerRemoving(player: Player)
	local profile = ProfileService.GetByPlayer(player)
	if profile then
		ProfileService.Remove(profile)
	end
	MatchService.RebalanceBots()
end

local function teammateHasHero(profile, heroId: string): boolean
	for _, mate in ProfileService.OnTeam(profile.Team) do
		if mate ~= profile and mate.HeroId == heroId then
			return true
		end
	end
	return false
end

local function onSelectHero(player: Player, heroId)
	local hero = Heroes.Get(heroId)
	local profile = ProfileService.GetByPlayer(player)
	if not hero or not profile or not profile.Team then
		return
	end
	if not Config.Match.AllowDuplicateHeroes and teammateHasHero(profile, heroId) then
		FX.NotifyPlayer(player, "Message", { Text = hero.DisplayName .. " is already on your team." })
		return
	end

	local character = profile.Character
	local alive = CombatUtil.IsAlive(character)
	local root = CombatUtil.GetRoot(character)
	local inSpawn = root ~= nil and MapService.IsInSpawnRoom(root.Position, profile.Team)
	if alive and GameState.Phase ~= "Setup" and not inSpawn then
		FX.NotifyPlayer(player, "Message", { Text = "Return to your spawn room to change heroes." })
		return
	end

	if profile.HeroId ~= heroId then
		ProfileService.SetHero(profile, heroId)
		ProfileService.SetUltCharge(profile, 0)
	end
	-- Swap right away if we're alive in spawn or haven't spawned yet; dead players use it on respawn.
	if matchRunning() and (alive or not character) then
		task.spawn(HeroService.Spawn, profile)
	end
end

--------------------------------------------------------------------------------
-- Continuous upkeep: respawns, spawn rooms, falling, passive ult charge
--------------------------------------------------------------------------------

local accumulator = 0
local function upkeep(dt: number)
	accumulator += dt
	if accumulator < 0.25 then
		return
	end
	local step = accumulator
	accumulator = 0
	local phase = GameState.Phase
	local battle = phase == "Battle"

	for _, profile in ProfileService.All() do
		local character = profile.Character
		if character and CombatUtil.IsAlive(character) then
			local root = CombatUtil.GetRoot(character)
			if root then
				if root.Position.Y < Config.Match.KillHeight then
					character:FindFirstChildOfClass("Humanoid").Health = 0
				elseif MapService.IsInSpawnRoom(root.Position, profile.Team) then
					CombatService.Heal(nil, character, Config.Match.SpawnRoomHealPerSecond * step)
				elseif battle and MapService.IsInSpawnRoom(root.Position, Config.GetOtherTeam(profile.Team)) then
					CombatService.Damage(nil, character, Config.Match.EnemySpawnRoomDamagePerSecond * step)
				end
			end
			if battle and os.clock() >= profile.UltActiveUntil then
				local charge = ProfileService.GetUltCharge(profile)
				if charge < 100 then
					ProfileService.SetUltCharge(profile, charge + Config.Combat.PassiveUltChargePerSecond * step)
				end
			end
		elseif profile.RespawnAt and (phase == "Setup" or battle) and os.clock() >= profile.RespawnAt then
			profile.RespawnAt = nil
			task.spawn(HeroService.Spawn, profile)
		end
	end
end

local function onKilled(victim)
	victim.Folder:SetAttribute("Alive", false)
	victim.RespawnAt = os.clock() + Config.Match.RespawnTime
	victim.Folder:SetAttribute("RespawnAt", workspace:GetServerTimeNow() + Config.Match.RespawnTime)
end

--------------------------------------------------------------------------------
-- Phases
--------------------------------------------------------------------------------

local function waitSeconds(seconds: number)
	local finish = os.clock() + seconds
	while os.clock() < finish do
		task.wait(0.2)
	end
end

local function resetForNewMatch()
	for _, profile in ProfileService.All() do
		HeroService.Despawn(profile)
		ProfileService.SetHero(profile, nil)
		ProfileService.SetUltCharge(profile, 0)
		ProfileService.ResetStats(profile)
	end
	ObjectiveService.Reset()
	DestructibleService.ResetAll()
	MapService.ClearEffects()
	MapService.SetDoorsOpen(false)
	GameState.Set("Round", 0)
	GameState.Set("RoundWins_" .. TEAM_A, 0)
	GameState.Set("RoundWins_" .. TEAM_B, 0)
end

local function playRound(round: number): string?
	-- SETUP: everyone (re)spawns in their spawn room and picks heroes. Doors are shut.
	ObjectiveService.Reset()
	DestructibleService.ResetAll()
	MapService.ClearEffects()
	MapService.SetDoorsOpen(false)
	GameState.Set("Round", round)
	GameState.SetPhase("Setup", Config.Match.SetupTime)
	FX.Notify("Announce", {
		Title = "ROUND " .. round,
		Subtitle = if round == 1 then "Choose your hero" else "Press " .. Config.KeyLabels.HeroSelect .. " to change hero",
		Duration = 3,
	})

	MatchService.RebalanceBots()
	for _, profile in ProfileService.All() do
		if profile.IsBot and not profile.HeroId then
			ProfileService.SetHero(profile, BotService.ChooseHero(profile))
		end
		profile.RespawnAt = nil
		if profile.HeroId then
			task.spawn(HeroService.Spawn, profile)
		end
	end
	waitSeconds(Config.Match.SetupTime)

	-- BATTLE: doors open, the point unlocks shortly after.
	MapService.SetDoorsOpen(true)
	ObjectiveService.Start(Config.Match.PointUnlockDelay)
	GameState.SetPhase("Battle", nil)
	FX.Notify("Announce", {
		Title = "FIGHT!",
		Subtitle = "The point unlocks in " .. Config.Match.PointUnlockDelay .. " seconds",
		Duration = 2.5,
	})

	local winner = nil
	while not winner do
		local dt = task.wait(0.1)
		winner = ObjectiveService.Update(dt)
		if #humans() == 0 then
			return nil
		end
	end

	-- ROUND END
	GameState.SetPhase("RoundEnd", Config.Match.RoundEndTime)
	GameState.Set("LastRoundWinner", winner)
	FX.Notify("RoundOver", { Winner = winner, Round = round })
	waitSeconds(Config.Match.RoundEndTime)
	return winner
end

local function runMatch(): string?
	local wins = { [TEAM_A] = 0, [TEAM_B] = 0 }
	local round = 0
	while true do
		round += 1
		local winner = playRound(round)
		if not winner then
			return nil -- everyone left
		end
		wins[winner] += 1
		GameState.Set("RoundWins_" .. winner, wins[winner])
		if wins[winner] >= Config.Match.RoundsToWin then
			return winner
		end
	end
end

local function mainLoop()
	while true do
		resetForNewMatch()
		GameState.SetPhase("Waiting", nil)
		while #humans() < Config.Match.MinPlayersToStart do
			task.wait(1)
		end

		GameState.SetPhase("Intermission", Config.Match.IntermissionTime)
		waitSeconds(Config.Match.IntermissionTime)
		if #humans() >= Config.Match.MinPlayersToStart then
			balanceHumans()
			local winner = runMatch()
			if winner then
				GameState.SetPhase("MatchEnd", Config.Match.MatchEndTime)
				GameState.Set("MatchWinner", winner)
				FX.Notify("MatchOver", { Winner = winner })
				waitSeconds(Config.Match.MatchEndTime)
			end
		end
	end
end

function MatchService.Start()
	for _, def in Config.Teams do
		local team = Teams:FindFirstChild(def.Name)
		if not team then
			team = Instance.new("Team")
			team.Name = def.Name
			team.Parent = Teams
		end
		team.TeamColor = def.BrickColor
		team.AutoAssignable = false
		teamObjects[def.Name] = team
	end

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	Remotes.SelectHero.OnServerEvent:Connect(onSelectHero)
	CombatService.Killed:Connect(onKilled)
	RunService.Heartbeat:Connect(upkeep)
	task.spawn(mainLoop)
end

return MatchService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">MotionService</string>
            <string name="Source"><![CDATA[--[[
	MotionService
	=============
	Moves characters for dashes, leaps and knockback. Players' characters are simulated on their
	own computer, so we ask that client to apply the motion; bots are moved right here.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local MotionUtil = require(Shared.MotionUtil)

local MotionService = {}

function MotionService.Dash(character: Model, velocity: Vector3, duration: number)
	local player = Players:GetPlayerFromCharacter(character)
	if player then
		Remotes.Motion:FireClient(player, "Dash", velocity, duration)
	else
		MotionUtil.Dash(character, velocity, duration)
	end
end

function MotionService.Impulse(character: Model, velocity: Vector3)
	local player = Players:GetPlayerFromCharacter(character)
	if player then
		Remotes.Motion:FireClient(player, "Impulse", velocity, 0)
	else
		MotionUtil.Impulse(character, velocity)
	end
end

-- A short, strong shove.
function MotionService.Knockback(character: Model, velocity: Vector3)
	MotionService.Dash(character, velocity, 0.15)
end

-- Teleports work from the server for everyone.
function MotionService.Teleport(character: Model, cframe: CFrame)
	character:PivotTo(cframe)
end

return MotionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">ObjectiveService</string>
            <string name="Source"><![CDATA[--[[
	ObjectiveService
	================
	The control point ("king of the hill"):
	  * The point is locked for a few seconds after the doors open.
	  * Stand on it alone to capture it. More teammates capture faster.
	  * While your team owns it, your score climbs. First to 100% wins the round.
	  * If both teams are on the point it is contested: nobody captures.
	  * Overtime: you cannot win while an enemy is standing on the point.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local CombatUtil = require(Shared.CombatUtil)

local GameState = require(script.Parent.GameState)
local ProfileService = require(script.Parent.ProfileService)
local MapService = require(script.Parent.MapService)
local FX = require(script.Parent.FX)

local ObjectiveService = {}

local TEAM_A, TEAM_B = Config.Teams[1].Name, Config.Teams[2].Name
local NEUTRAL_COLOR = Color3.fromRGB(235, 235, 240)

local state = nil

local function round1(value: number): number
	return math.floor(value * 10 + 0.5) / 10
end

local function countOnPoint()
	local counts = { [TEAM_A] = 0, [TEAM_B] = 0 }
	local point = MapService.GetControlPoint()
	if not point then
		return counts
	end
	local radius = point:GetAttribute("Radius") or 18
	local height = point:GetAttribute("Height") or 10
	for _, profile in ProfileService.All() do
		local character = profile.Character
		if character and profile.Team and counts[profile.Team] and CombatUtil.IsAlive(character) then
			local root = CombatUtil.GetRoot(character)
			if root then
				local offset = root.Position - point.Position
				if Vector2.new(offset.X, offset.Z).Magnitude <= radius and math.abs(offset.Y) <= height then
					counts[profile.Team] += 1
				end
			end
		end
	end
	return counts
end

local function paintPoint()
	local map = MapService.GetMap()
	local visual = map and map:FindFirstChild("PointVisual")
	if not visual then
		return
	end
	local color = if state.Owner then Config.GetTeamColor(state.Owner) else NEUTRAL_COLOR
	for _, part in visual:GetDescendants() do
		if part:IsA("BasePart") then
			part.Color = color
		end
	end
end

local function publish(counts)
	GameState.Set("PointOwner", state.Owner or "")
	GameState.Set("CaptureTeam", state.CaptureTeam or "")
	GameState.Set("CaptureProgress", round1(state.Progress))
	GameState.Set("PointLocked", not state.Unlocked)
	GameState.Set("PointUnlockAt", state.UnlockAt)
	GameState.Set("Contested", state.Contested)
	GameState.Set("Overtime", state.Overtime)
	GameState.Set("Score_" .. TEAM_A, round1(state.Scores[TEAM_A]))
	GameState.Set("Score_" .. TEAM_B, round1(state.Scores[TEAM_B]))
	GameState.Set("OnPoint_" .. TEAM_A, if counts then counts[TEAM_A] else 0)
	GameState.Set("OnPoint_" .. TEAM_B, if counts then counts[TEAM_B] else 0)
end

function ObjectiveService.Reset()
	state = {
		Owner = nil,
		CaptureTeam = nil,
		Progress = 0,
		Scores = { [TEAM_A] = 0, [TEAM_B] = 0 },
		Unlocked = false,
		UnlockAt = 0,
		Contested = false,
		Overtime = false,
		Winner = nil,
	}
	paintPoint()
	publish(nil)
end

-- Starts the round's objective; the point unlocks `delay` seconds from now.
function ObjectiveService.Start(delay: number)
	state.UnlockAt = workspace:GetServerTimeNow() + delay
	publish(nil)
end

-- Call regularly during "Battle". Returns the winning team once someone reaches 100%.
function ObjectiveService.Update(dt: number)
	if state.Winner then
		return state.Winner
	end
	if not state.Unlocked then
		if workspace:GetServerTimeNow() >= state.UnlockAt then
			state.Unlocked = true
			FX.Notify("Announce", { Title = "POINT UNLOCKED", Subtitle = "Capture the objective!", Duration = 2.5 })
		end
		publish(nil)
		return nil
	end

	local counts = countOnPoint()
	local present = {}
	for _, team in { TEAM_A, TEAM_B } do
		if counts[team] > 0 then
			table.insert(present, team)
		end
	end
	state.Contested = #present > 1

	local objective = Config.Objective
	local captureRate = 100 / objective.CaptureTime
	if #present == 1 then
		local team = present[1]
		if team ~= state.Owner then
			if state.CaptureTeam and state.CaptureTeam ~= team and state.Progress > 0 then
				-- Undo the other team's partial capture first.
				state.Progress = math.max(0, state.Progress - captureRate * dt)
				if state.Progress <= 0 then
					state.CaptureTeam = team
				end
			else
				state.CaptureTeam = team
				local helpers = math.min(counts[team], objective.MaxCapturers) - 1
				local speed = 1 + helpers * objective.CaptureSpeedPerExtraPlayer
				state.Progress = math.min(100, state.Progress + captureRate * speed * dt)
				if state.Progress >= 100 then
					state.Owner = team
					state.CaptureTeam = nil
					state.Progress = 0
					paintPoint()
					FX.Notify("PointCaptured", { Team = team })
				end
			end
		else
			-- Owners standing on their point wipe out the enemy's partial capture.
			state.Progress = math.max(0, state.Progress - objective.DecayPerSecond * 2 * dt)
			if state.Progress <= 0 then
				state.CaptureTeam = nil
			end
		end
	elseif #present == 0 then
		state.Progress = math.max(0, state.Progress - objective.DecayPerSecond * dt)
		if state.Progress <= 0 then
			state.CaptureTeam = nil
		end
	end

	state.Overtime = false
	if state.Owner then
		local enemy = Config.GetOtherTeam(state.Owner)
		local score = state.Scores[state.Owner] + objective.ScorePerSecond * dt
		if score >= 100 then
			if enemy and counts[enemy] > 0 then
				state.Scores[state.Owner] = 99.9
				state.Overtime = true
			else
				state.Scores[state.Owner] = 100
				state.Winner = state.Owner
			end
		else
			state.Scores[state.Owner] = score
		end
	end

	publish(counts)
	return state.Winner
end

ObjectiveService.Reset()

return ObjectiveService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">ProfileService</string>
            <string name="Source"><![CDATA[--[[
	ProfileService
	==============
	A "profile" is one fighter in the match: a real player or a bot. It survives deaths and
	respawns, and remembers the team, chosen hero, ultimate charge and stats.

	Each profile also has a Folder in ReplicatedStorage.Combatants whose attributes mirror the
	public parts (name, team, hero, kills, ...) so clients can draw the scoreboard and HUD.
	A character points back at its profile with the "CombatantId" attribute.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared.Signal)

local ProfileService = {}

ProfileService.Changed = Signal.new() -- (profile, field) when team or hero changes
ProfileService.Removed = Signal.new() -- (profile)

local STATS = { "Kills", "Deaths", "Assists", "Damage", "Healing" }
ProfileService.Stats = STATS

local profiles = {}
local byPlayer = {}
local botCounter = 0

local root = ReplicatedStorage:FindFirstChild("Combatants")
if not root then
	root = Instance.new("Folder")
	root.Name = "Combatants"
	root.Parent = ReplicatedStorage
end

local function create(id: string, name: string, player: Player?)
	local folder = Instance.new("Folder")
	folder.Name = id
	folder:SetAttribute("DisplayName", name)
	folder:SetAttribute("IsBot", player == nil)
	folder:SetAttribute("UserId", if player then player.UserId else 0)
	folder:SetAttribute("Team", "")
	folder:SetAttribute("Hero", "")
	folder:SetAttribute("UltCharge", 0)
	folder:SetAttribute("Alive", false)
	folder:SetAttribute("RespawnAt", 0)
	folder:SetAttribute("Synergies", "")
	for _, stat in STATS do
		folder:SetAttribute(stat, 0)
	end
	folder.Parent = root

	local profile = {
		Id = id,
		Name = name,
		Player = player,
		IsBot = player == nil,
		Team = nil,
		HeroId = nil,
		Character = nil,
		Folder = folder,
		DamageLog = {}, -- [attackerProfileId] = os.clock() of their last hit
		LastAttackerId = nil,
		LastAbility = nil,
		UltActiveUntil = 0,
		RespawnAt = nil,
		Spawning = false,
	}
	profiles[id] = profile
	return profile
end

function ProfileService.AddPlayer(player: Player)
	local profile = create("P" .. player.UserId, player.DisplayName, player)
	byPlayer[player] = profile
	return profile
end

function ProfileService.AddBot(name: string)
	botCounter += 1
	return create("B" .. botCounter, name, nil)
end

function ProfileService.Remove(profile)
	if profiles[profile.Id] ~= profile then
		return
	end
	profiles[profile.Id] = nil
	if profile.Player then
		byPlayer[profile.Player] = nil
	elseif profile.Character then
		profile.Character:Destroy()
	end
	profile.Character = nil
	profile.Folder:Destroy()
	ProfileService.Removed:Fire(profile)
end

function ProfileService.Get(id)
	return if id then profiles[id] else nil
end

function ProfileService.GetByPlayer(player: Player)
	return byPlayer[player]
end

function ProfileService.GetByCharacter(character)
	if not character then
		return nil
	end
	local id = character:GetAttribute("CombatantId")
	return if id then profiles[id] else nil
end

function ProfileService.All()
	local list = {}
	for _, profile in profiles do
		table.insert(list, profile)
	end
	return list
end

function ProfileService.OnTeam(team: string)
	local list = {}
	for _, profile in profiles do
		if profile.Team == team then
			table.insert(list, profile)
		end
	end
	return list
end

function ProfileService.SetTeam(profile, team: string?)
	profile.Team = team
	profile.Folder:SetAttribute("Team", team or "")
	ProfileService.Changed:Fire(profile, "Team")
end

function ProfileService.SetHero(profile, heroId: string?)
	profile.HeroId = heroId
	profile.Folder:SetAttribute("Hero", heroId or "")
	ProfileService.Changed:Fire(profile, "Hero")
end

function ProfileService.GetUltCharge(profile): number
	return profile.Folder:GetAttribute("UltCharge") or 0
end

function ProfileService.SetUltCharge(profile, percent: number)
	profile.Folder:SetAttribute("UltCharge", math.clamp(percent, 0, 100))
end

function ProfileService.AddStat(profile, stat: string, amount: number)
	local folder = profile.Folder
	folder:SetAttribute(stat, (folder:GetAttribute(stat) or 0) + amount)
end

function ProfileService.ResetStats(profile)
	for _, stat in STATS do
		profile.Folder:SetAttribute(stat, 0)
	end
	profile.DamageLog = {}
	profile.LastAttackerId = nil
end

return ProfileService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">ProjectileService</string>
            <string name="Source"><![CDATA[--[[
	ProjectileService
	=================
	Moves projectiles on the server (so hits are fair) using a sphere cast every frame. Clients only
	draw them: each client receives the start position/velocity and simulates the same flight.

		ProjectileService.Fire({
			Owner = character,             -- who fired it (never hits its owner)
			Origin = Vector3, Velocity = Vector3,
			Gravity = 0,                   -- studs/s^2 pulling it down (grenades arc)
			Radius = 0.5,                  -- hit size
			Lifetime = 3,                  -- seconds before it fizzles
			HitsAllies = false,            -- true for healing shots
			ExplodeOnExpire = false,       -- call OnHit where it fizzles (grenades)
			Color = Color3, Style = "Volta",
			Impact = "Explosion" | "Spark", ImpactRadius = 7,   -- what clients draw on impact
			OnHit = function(hitPart: BasePart?, position: Vector3, normal: Vector3?) end,
			Id = "123_4", PredictedBy = player,  -- the shooter already drew it locally
		})
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CombatUtil = require(Shared.CombatUtil)
local FX = require(script.Parent.FX)

local ProjectileService = {}

local active = {}
local counter = 0

function ProjectileService.Fire(def)
	counter += 1
	local projectile = {
		Def = def,
		Id = def.Id or ("S" .. counter),
		Position = def.Origin,
		Velocity = def.Velocity,
		Gravity = def.Gravity or 0,
		Radius = def.Radius or 0.5,
		Lifetime = def.Lifetime or 3,
		Age = 0,
		Team = def.Owner:GetAttribute("Team"),
	}
	table.insert(active, projectile)

	FX.Except(def.PredictedBy, "Projectile", {
		Id = projectile.Id,
		Origin = projectile.Position,
		Velocity = projectile.Velocity,
		Gravity = projectile.Gravity,
		Lifetime = projectile.Lifetime,
		Radius = projectile.Radius,
		Style = def.Style,
		Color = def.Color,
	})
	return projectile.Id
end

local function buildParams(projectile): RaycastParams
	local ignore = { projectile.Def.Owner }
	for _, barrier in CombatUtil.GetTeamBarriers(projectile.Team) do
		table.insert(ignore, barrier)
	end
	if not projectile.Def.HitsAllies then
		for _, character in CombatUtil.GetAllCharacters() do
			if character:GetAttribute("Team") == projectile.Team then
				table.insert(ignore, character)
			end
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	params.IgnoreWater = true
	return params
end

local function finish(index: number, projectile, hitPart: BasePart?, position: Vector3, normal: Vector3?)
	table.remove(active, index)
	local def = projectile.Def
	FX.All("ProjectileEnd", {
		Id = projectile.Id,
		Position = position,
		Impact = def.Impact,
		Radius = def.ImpactRadius,
		Color = def.Color,
	})
	if def.OnHit and (hitPart or def.ExplodeOnExpire) then
		local ok, err = pcall(def.OnHit, hitPart, position, normal)
		if not ok then
			warn("[ProjectileService] OnHit error: " .. tostring(err))
		end
	end
end

RunService.Heartbeat:Connect(function(dt)
	for index = #active, 1, -1 do
		local projectile = active[index]
		projectile.Age += dt
		local gravity = Vector3.new(0, -projectile.Gravity, 0)
		local displacement = projectile.Velocity * dt + gravity * (0.5 * dt * dt)
		projectile.Velocity += gravity * dt

		local result = nil
		if displacement.Magnitude > 1e-3 then
			result = workspace:Spherecast(projectile.Position, projectile.Radius, displacement, buildParams(projectile))
		end

		if result then
			finish(index, projectile, result.Instance, result.Position, result.Normal)
		else
			projectile.Position += displacement
			if projectile.Age >= projectile.Lifetime then
				finish(index, projectile, nil, projectile.Position, nil)
			end
		end
	end
end)

return ProjectileService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">StatusService</string>
            <string name="Source"><![CDATA[--[[
	StatusService
	=============
	Temporary buffs and debuffs. Each effect has a name (shown on the HUD), a duration, and one
	or more modifiers. Applying the same name again refreshes it instead of stacking.

		StatusService.Apply(character, "Tailwind", { Speed = 1.3 }, 4)
		StatusService.Apply(character, "Slowed", { Speed = 0.6 }, 2.5)
		StatusService.Apply(character, "Overdrive", { FireRate = 1.5, DamageDealt = 1.25, InfiniteAmmo = 1 }, 8)

	Modifiers (multiply together when several effects are active):
	  Speed, DamageDealt, DamageTaken, FireRate      multipliers (1 = normal)
	  InfiniteAmmo                                   flag (any value)

	Shields are temporary bonus health that absorbs damage before health does.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local StatusService = {}

local records = {} -- [character] = { Effects = { [name] = { Mods, Expires } }, BaseSpeed, ShieldExpires }

local function multiplierFor(record, modType: string): number
	local value = 1
	for _, effect in record.Effects do
		local modifier = effect.Mods[modType]
		if modifier then
			value *= modifier
		end
	end
	return value
end

local function hasFlag(record, modType: string): boolean
	for _, effect in record.Effects do
		if effect.Mods[modType] then
			return true
		end
	end
	return false
end

-- Pushes the combined effect values onto the character (WalkSpeed + attributes for the HUD).
local function refresh(character: Model, record)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		humanoid.WalkSpeed = record.BaseSpeed * multiplierFor(record, "Speed")
	end
	character:SetAttribute("FireRateMult", multiplierFor(record, "FireRate"))
	character:SetAttribute("InfiniteAmmo", hasFlag(record, "InfiniteAmmo"))

	local names = {}
	for name in record.Effects do
		table.insert(names, name)
	end
	table.sort(names)
	character:SetAttribute("Effects", table.concat(names, ","))
end

function StatusService.Setup(character: Model, baseWalkSpeed: number)
	local record = { Effects = {}, BaseSpeed = baseWalkSpeed, ShieldExpires = nil }
	records[character] = record
	character:SetAttribute("Shield", 0)
	refresh(character, record)
	character.AncestryChanged:Connect(function()
		if not character:IsDescendantOf(game) then
			records[character] = nil
		end
	end)
end

function StatusService.Clear(character: Model)
	records[character] = nil
end

function StatusService.Apply(character: Model, name: string, mods, duration: number)
	local record = records[character]
	if not record then
		return
	end
	record.Effects[name] = { Mods = mods, Expires = os.clock() + duration }
	refresh(character, record)
end

function StatusService.Remove(character: Model, name: string)
	local record = records[character]
	if record and record.Effects[name] then
		record.Effects[name] = nil
		refresh(character, record)
	end
end

function StatusService.GetMultiplier(character: Model?, modType: string): number
	local record = character and records[character]
	return if record then multiplierFor(record, modType) else 1
end

function StatusService.Has(character: Model?, modType: string): boolean
	local record = character and records[character]
	return if record then hasFlag(record, modType) else false
end

-- Adds temporary shields (they all vanish when the longest one runs out).
function StatusService.AddShield(character: Model, amount: number, duration: number)
	local record = records[character]
	if not record then
		return
	end
	local current = character:GetAttribute("Shield") or 0
	character:SetAttribute("Shield", math.min(Config.Combat.MaxShield, current + amount))
	record.ShieldExpires = math.max(record.ShieldExpires or 0, os.clock() + duration)
end

RunService.Heartbeat:Connect(function()
	local now = os.clock()
	for character, record in records do
		local changed = false
		for name, effect in record.Effects do
			if now >= effect.Expires then
				record.Effects[name] = nil
				changed = true
			end
		end
		if changed then
			refresh(character, record)
		end
		if record.ShieldExpires and now >= record.ShieldExpires then
			record.ShieldExpires = nil
			character:SetAttribute("Shield", 0)
		end
	end
end)

return StatusService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">SynergyService</string>
            <string name="Source"><![CDATA[--[[
	SynergyService
	==============
	Works out which team-ups (Shared/Synergies.luau) are active for each fighter and answers
	"what bonus does this fighter have for stat X?". Recalculated whenever a team or hero changes.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Synergies = require(Shared.Synergies)
local ProfileService = require(script.Parent.ProfileService)

local SynergyService = {}

local bonusesByProfile = {} -- [profileId] = { [stat] = value }

local function teamHasAll(teamHeroes, required): boolean
	for _, heroId in required do
		if not teamHeroes[heroId] then
			return false
		end
	end
	return true
end

function SynergyService.Recompute()
	local heroesByTeam = {}
	for _, profile in ProfileService.All() do
		if profile.Team and profile.HeroId then
			heroesByTeam[profile.Team] = heroesByTeam[profile.Team] or {}
			heroesByTeam[profile.Team][profile.HeroId] = true
		end
	end

	table.clear(bonusesByProfile)
	for _, profile in ProfileService.All() do
		local bonuses, names = {}, {}
		local teamHeroes = profile.Team and heroesByTeam[profile.Team]
		if teamHeroes and profile.HeroId then
			for _, synergy in Synergies.List do
				local mine = synergy.Bonuses[profile.HeroId]
				if mine and teamHasAll(teamHeroes, synergy.Heroes) then
					table.insert(names, synergy.Name)
					for stat, value in mine do
						if string.sub(stat, -4) == "Mult" then
							bonuses[stat] = (bonuses[stat] or 1) * value
						else
							bonuses[stat] = (bonuses[stat] or 0) + value
						end
					end
				end
			end
		end
		bonusesByProfile[profile.Id] = bonuses
		profile.Folder:SetAttribute("Synergies", table.concat(names, ", "))
	end
end

-- `who` can be a character Model or a profile.
function SynergyService.GetBonus(who, stat: string, default: number): number
	local profile = if typeof(who) == "Instance" then ProfileService.GetByCharacter(who) else who
	local bonuses = profile and bonusesByProfile[profile.Id]
	local value = bonuses and bonuses[stat]
	return if value ~= nil then value else default
end

function SynergyService.Init()
	ProfileService.Changed:Connect(SynergyService.Recompute)
	ProfileService.Removed:Connect(SynergyService.Recompute)
end

return SynergyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">WeaponService</string>
            <string name="Source"><![CDATA[--[[
	WeaponService
	=============
	Primary fire for every hero: hitscan guns, projectiles and melee, plus ammo and reloading.

	Players: the client aims and reports what it hit (so shooting feels instant even with lag);
	the server checks the claim is believable (fire rate, ammo, range, target position, walls)
	before applying any damage.
	Bots: the server does the whole shot itself (BotFire).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Heroes = require(Shared.Heroes)
local CombatUtil = require(Shared.CombatUtil)
local Remotes = require(Shared.Remotes)

local ProfileService = require(script.Parent.ProfileService)
local CombatService = require(script.Parent.CombatService)
local ProjectileService = require(script.Parent.ProjectileService)
local StatusService = require(script.Parent.StatusService)
local SynergyService = require(script.Parent.SynergyService)
local DestructibleService = require(script.Parent.DestructibleService)
local FX = require(script.Parent.FX)

-- How far (studs) a target may have moved between what the shooter saw and what the server sees.
-- Higher = friendlier to laggy players, lower = harder to cheat.
local MAX_TARGET_DRIFT = 14
local RANGE_TOLERANCE = 10

local WeaponService = {}

local states = {} -- [character] = { Ammo, Reloading, Budget, LastTime, ReloadToken }
local rng = Random.new()

local function getWeapon(character: Model)
	local hero = Heroes.Get(character:GetAttribute("Hero"))
	return hero and hero.Primary, hero
end

local function publishAmmo(character: Model, state)
	character:SetAttribute("Ammo", state.Ammo)
	character:SetAttribute("Reloading", state.Reloading)
end

function WeaponService.Setup(character: Model, hero)
	local magazine = hero.Primary.MagazineSize or 0
	states[character] = { Ammo = magazine, Reloading = false, Budget = 1, LastTime = os.clock() }
	character:SetAttribute("MaxAmmo", magazine)
	publishAmmo(character, states[character])
end

function WeaponService.Clear(character: Model)
	states[character] = nil
end

function WeaponService.Refill(character: Model)
	local state = states[character]
	local weapon = getWeapon(character)
	if state and weapon and weapon.MagazineSize then
		state.Ammo = weapon.MagazineSize
		state.Reloading = false
		state.ReloadToken = nil
		publishAmmo(character, state)
	end
end

function WeaponService.Reload(character: Model)
	local state = states[character]
	local weapon = getWeapon(character)
	if not state or not weapon or not weapon.MagazineSize or state.Reloading or state.Ammo >= weapon.MagazineSize then
		return
	end
	state.Reloading = true
	publishAmmo(character, state)

	local token = {}
	state.ReloadToken = token
	task.delay(weapon.ReloadTime or 1.5, function()
		if states[character] ~= state or state.ReloadToken ~= token then
			return -- died, swapped hero or reload was cancelled
		end
		state.Ammo = weapon.MagazineSize
		state.Reloading = false
		state.ReloadToken = nil
		publishAmmo(character, state)
	end)
end

-- Fire-rate and ammo check. A small "budget" absorbs network jitter without allowing rapid fire.
local function tryConsumeShot(character: Model, weapon): boolean
	local state = states[character]
	if not state then
		return false
	end
	local now = os.clock()
	local rate = weapon.FireRate * StatusService.GetMultiplier(character, "FireRate")
	state.Budget = math.min(state.Budget + (now - state.LastTime) * rate, 1.5)
	state.LastTime = now
	if state.Budget < 0.85 then
		return false
	end

	if weapon.MagazineSize and not StatusService.Has(character, "InfiniteAmmo") then
		if state.Reloading then
			return false
		end
		if state.Ammo <= 0 then
			WeaponService.Reload(character)
			return false
		end
		state.Ammo -= 1
		publishAmmo(character, state)
		if state.Ammo <= 0 then
			WeaponService.Reload(character)
		end
	end
	state.Budget -= 1
	return true
end

-- Applies a list of hitscan hits { Part, Position }. `validate` = the hits came from a client.
local function applyHitscanHits(character: Model, weapon, origin: Vector3, hits, validate: boolean)
	local totals = {} -- one damage event per target, so shotguns show one big number
	for _, hit in hits do
		local part, position = hit.Part, hit.Position
		if part:IsDescendantOf(workspace) then
			local distance = (position - origin).Magnitude
			if distance <= weapon.Range + (if validate then RANGE_TOLERANCE else 1) then
				local target = CombatUtil.GetCharacterFromPart(part)
				if target then
					if target ~= character and CombatUtil.IsAlive(target) then
						local believable = true
						if validate then
							local targetRoot = CombatUtil.GetRoot(target)
							believable = targetRoot ~= nil
								and (targetRoot.Position - position).Magnitude <= MAX_TARGET_DRIFT
								and CombatService.HasLineOfSight(character, origin, position)
						end
						if believable then
							local headshot = part.Name == "Head"
							local multiplier = CombatUtil.Falloff(weapon, distance)
							if headshot then
								multiplier *= weapon.HeadshotMultiplier or Config.Combat.DefaultHeadshotMultiplier
							end
							local entry = totals[target]
							if not entry then
								entry = { Amount = 0, Headshot = false, Position = position }
								totals[target] = entry
							end
							entry.Amount += weapon.Damage * multiplier
							entry.Headshot = entry.Headshot or headshot
						end
					end
				elseif DestructibleService.IsDestructible(part) then
					if not validate or CombatService.HasLineOfSight(character, origin, position) then
						DestructibleService.Damage(part, weapon.Damage * CombatUtil.Falloff(weapon, distance), character)
					end
				end
			end
		end
	end
	for target, entry in totals do
		CombatService.Damage(character, target, entry.Amount, {
			Ability = weapon.Name,
			Headshot = entry.Headshot,
			Position = entry.Position,
		})
	end
end

local function fireProjectile(character: Model, hero, origin: Vector3, aimPoint: Vector3, id: string?, predictedBy: Player?)
	local weapon = hero.Primary
	local direction = aimPoint - origin
	if direction.Magnitude < 0.5 then
		local root = CombatUtil.GetRoot(character)
		direction = if root then root.CFrame.LookVector else Vector3.new(0, 0, -1)
	end
	direction = direction.Unit
	local speed = weapon.ProjectileSpeed * SynergyService.GetBonus(character, "ProjectileSpeedMult", 1)

	ProjectileService.Fire({
		Owner = character,
		Id = id,
		PredictedBy = predictedBy,
		Origin = origin,
		Velocity = direction * speed,
		Gravity = weapon.ProjectileGravity or 0,
		Radius = weapon.ProjectileRadius or 0.5,
		Lifetime = weapon.Range / speed,
		HitsAllies = (weapon.Heal or 0) > 0,
		Style = hero.Id,
		Color = weapon.TracerColor,
		Impact = if weapon.SplashRadius then "Explosion" else "Spark",
		ImpactRadius = weapon.SplashRadius or 2,
		OnHit = function(hitPart, position, normal)
			local target = hitPart and CombatUtil.GetCharacterFromPart(hitPart)
			if target and target ~= character and CombatUtil.IsAlive(target) then
				if CombatUtil.AreEnemies(character, target) then
					CombatService.Damage(character, target, weapon.Damage, { Ability = weapon.Name, Position = position })
				elseif weapon.Heal then
					CombatService.Heal(character, target, weapon.Heal, { Ability = weapon.Name })
				end
			elseif hitPart and DestructibleService.IsDestructible(hitPart) then
				DestructibleService.Damage(hitPart, weapon.Damage, character)
			end
			if weapon.SplashRadius and weapon.SplashDamage then
				local center = if normal then position + normal * 0.5 else position
				CombatService.Explode(character, center, weapon.SplashRadius, weapon.SplashDamage, { Ability = weapon.Name })
			end
		end,
	})
end

local function doMelee(character: Model, hero, direction: Vector3, predictedBy: Player?)
	local weapon = hero.Primary
	local root = CombatUtil.GetRoot(character)
	if not root then
		return
	end
	local origin = root.Position + Vector3.new(0, 1, 0)
	local halfArc = math.rad((weapon.ArcDegrees or 90) / 2)

	for _, target in CombatService.GetEnemiesInRadius(character, origin, weapon.Range + 2.5) do
		local targetRoot = CombatUtil.GetRoot(target)
		if targetRoot then
			local offset = targetRoot.Position - origin
			local inArc = offset.Magnitude < 3.5
				or math.acos(math.clamp(direction:Dot(offset.Unit), -1, 1)) <= halfArc
			if inArc and CombatService.HasLineOfSight(character, origin, targetRoot.Position) then
				CombatService.Damage(character, target, weapon.Damage, { Ability = weapon.Name, Position = targetRoot.Position })
			end
		end
	end

	-- Blades chop cover too.
	local result = workspace:Raycast(origin, direction * weapon.Range, CombatUtil.ShotParams(character, true))
	if result and DestructibleService.IsDestructible(result.Instance) then
		DestructibleService.Damage(result.Instance, weapon.Damage, character)
	end

	FX.Except(predictedBy, "Slash", {
		Origin = origin,
		Direction = direction,
		Range = weapon.Range,
		Color = weapon.TracerColor,
	})
end

local function onClientFire(player: Player, payload)
	if typeof(payload) ~= "table" then
		return
	end
	local character = player.Character
	local profile = ProfileService.GetByPlayer(player)
	if not character or not profile or profile.Character ~= character or not CombatUtil.IsAlive(character) then
		return
	end
	local weapon, hero = getWeapon(character)
	if not weapon or not tryConsumeShot(character, weapon) then
		return
	end
	local origin = CombatUtil.GetMuzzle(character)
	if not origin then
		return
	end

	if weapon.Kind == "Hitscan" then
		local pellets = weapon.Pellets or 1
		local ends, hits = {}, {}
		if typeof(payload.Ends) == "table" then
			for index = 1, math.min(#payload.Ends, pellets) do
				local point = payload.Ends[index]
				if CombatUtil.IsFiniteVector(point) then
					table.insert(ends, point)
				end
			end
		end
		if typeof(payload.Hits) == "table" then
			for index = 1, math.min(#payload.Hits, pellets) do
				local hit = payload.Hits[index]
				if
					typeof(hit) == "table"
					and typeof(hit.Part) == "Instance"
					and hit.Part:IsA("BasePart")
					and CombatUtil.IsFiniteVector(hit.Position)
				then
					table.insert(hits, { Part = hit.Part, Position = hit.Position })
				end
			end
		end
		FX.Except(player, "Tracer", { Origin = origin, Ends = ends, Color = weapon.TracerColor, Width = weapon.TracerWidth })
		applyHitscanHits(character, weapon, origin, hits, true)
	elseif weapon.Kind == "Projectile" then
		local aimPoint, shotId = payload.AimPoint, payload.ShotId
		if CombatUtil.IsFiniteVector(aimPoint) and typeof(shotId) == "number" then
			local id = tostring(player.UserId) .. "_" .. tostring(math.floor(shotId))
			fireProjectile(character, hero, origin, aimPoint, id, player)
		end
	elseif weapon.Kind == "Melee" then
		local direction = payload.Direction
		if not CombatUtil.IsFiniteVector(direction) or direction.Magnitude < 0.5 then
			direction = CombatUtil.GetRoot(character).CFrame.LookVector
		end
		doMelee(character, hero, direction.Unit, player)
	end
end

-- Bots: the server aims, rolls inaccuracy and fires. Returns true if a shot went off.
function WeaponService.BotFire(character: Model, aimPoint: Vector3): boolean
	local weapon, hero = getWeapon(character)
	if not weapon or not tryConsumeShot(character, weapon) then
		return false
	end
	local origin = CombatUtil.GetMuzzle(character)
	if not origin then
		return false
	end
	local direction = aimPoint - origin
	if direction.Magnitude < 0.1 then
		return false
	end
	direction = direction.Unit
	local aimError = Config.Bots.AimErrorDegrees

	if weapon.Kind == "Hitscan" then
		local params = CombatUtil.ShotParams(character)
		local ends, hits = {}, {}
		for _ = 1, weapon.Pellets or 1 do
			local pelletDirection = CombatUtil.SpreadDirection(direction, (weapon.SpreadDegrees or 0) + aimError, rng)
			local result = workspace:Raycast(origin, pelletDirection * weapon.Range, params)
			table.insert(ends, if result then result.Position else origin + pelletDirection * weapon.Range)
			if result then
				table.insert(hits, { Part = result.Instance, Position = result.Position })
			end
		end
		FX.All("Tracer", { Origin = origin, Ends = ends, Color = weapon.TracerColor, Width = weapon.TracerWidth })
		applyHitscanHits(character, weapon, origin, hits, false)
	elseif weapon.Kind == "Projectile" then
		local spread = CombatUtil.SpreadDirection(direction, aimError, rng)
		fireProjectile(character, hero, origin, origin + spread * 100, nil, nil)
	elseif weapon.Kind == "Melee" then
		doMelee(character, hero, direction, nil)
	end
	return true
end

function WeaponService.Init()
	Remotes.Fire.OnServerEvent:Connect(onClientFire)
	Remotes.Reload.OnServerEvent:Connect(function(player)
		local character = player.Character
		if character and CombatUtil.IsAlive(character) then
			WeaponService.Reload(character)
		end
	end)
end

return WeaponService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="43">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="44">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <bool name="AutoJumpEnabled">false</bool>
      <float name="CharacterJumpHeight">7.2</float>
      <bool name="CharacterUseJumpPower">false</bool>
      <bool name="EnableMouseLockOption">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="45">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="46">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="47">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[--[[
	CameraController
	================
	Over-the-shoulder third-person camera, like most hero shooters:
	  * the mouse is locked to the centre and turns the camera (gamepad: right stick, touch: drag)
	  * your hero always faces where the camera looks, so the crosshair is where you shoot
	  * the camera slides in front of walls instead of clipping through them
	  * with no character (between matches) it slowly circles the arena
	Opening a menu (hero select, scoreboard) frees the mouse.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local ClientState = require(script.Parent.ClientState)

local player = Players.LocalPlayer
local UserGameSettings = UserSettings():GetService("UserGameSettings")

local CameraController = {}

local settings = Config.Camera
local yaw, pitch = 0, math.rad(-8)
local recoil = 0
local distance = settings.Distance
local orbitAngle = 0
local lastFocus = Vector3.new(0, 20, 0)
local gamepadLook = Vector2.zero
local lookTouches = {} -- touches that started on the right side of the screen steer the camera

local function mapCenter(): Vector3
	local map = workspace:FindFirstChild("Map")
	local point = map and map:FindFirstChild("ControlPoint")
	return if point and point:IsA("BasePart") then point.Position else Vector3.zero
end

-- Kicks the view up a little (weapon recoil). It settles back by itself.
function CameraController.Kick(amount: number)
	recoil += amount
end

local function onCharacterAdded(character: Model)
	recoil = 0
	task.spawn(function()
		-- Face the way the server spawned us (it sets SpawnYaw right after spawning).
		local waited = 0
		while character.Parent and character:GetAttribute("SpawnYaw") == nil and waited < 3 do
			waited += task.wait(0.1)
		end
		local spawnYaw = character:GetAttribute("SpawnYaw")
		if spawnYaw then
			yaw = spawnYaw
			pitch = math.rad(-5)
		end
	end)
end

local function update(dt: number)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = settings.FieldOfView

	if ClientState.IsMenuOpen() then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
	else
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		UserInputService.MouseIconEnabled = false
		local delta = UserInputService:GetMouseDelta()
		local sensitivity = settings.MouseSensitivity * UserGameSettings.MouseSensitivity
		yaw -= delta.X * sensitivity
		pitch -= delta.Y * sensitivity
		if gamepadLook.Magnitude > 0.15 then
			yaw -= gamepadLook.X * settings.GamepadSensitivity * dt
			pitch += gamepadLook.Y * settings.GamepadSensitivity * dt * 0.7
		end
	end
	pitch = math.clamp(pitch, math.rad(settings.MinPitch), math.rad(settings.MaxPitch))
	recoil *= math.exp(-dt * 12)

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if not root then
		-- Nothing to follow: a slow cinematic orbit around the arena.
		orbitAngle += dt * 0.08
		local center = mapCenter()
		local position = center + Vector3.new(math.cos(orbitAngle) * 120, 55, math.sin(orbitAngle) * 120)
		camera.CFrame = CFrame.lookAt(position, center)
		return
	end

	local alive = humanoid ~= nil and humanoid.Health > 0
	local focus = root.Position + Vector3.new(0, settings.Height, 0)
	if alive then
		lastFocus = focus
	else
		focus = lastFocus
	end

	local wantedDistance = if alive then settings.Distance else settings.Distance + 5
	distance += (wantedDistance - distance) * math.min(1, dt * 6)

	local rotation = CFrame.fromOrientation(pitch + recoil, yaw, 0)
	local offset = rotation:VectorToWorldSpace(Vector3.new(settings.ShoulderOffset, 0, distance))

	-- Keep the camera out of walls (but ignore ability barriers and effects).
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character, workspace:FindFirstChild("Effects") }
	local hit = workspace:Spherecast(focus, 0.5, offset, params)
	local cameraPosition = if hit then focus + offset.Unit * math.max(0.6, hit.Distance - 0.1) else focus + offset

	camera.CFrame = CFrame.new(cameraPosition) * rotation
	camera.Focus = CFrame.new(focus)

	-- Turn the hero to face where we aim.
	if alive and root:IsA("BasePart") then
		humanoid.AutoRotate = false
		root.CFrame = CFrame.new(root.Position) * CFrame.fromOrientation(0, yaw, 0)
	end
end

function CameraController.Init()
	RunService:BindToRenderStep("HeroCamera", Enum.RenderPriority.Camera.Value + 1, update)

	player.CharacterAdded:Connect(onCharacterAdded)
	if player.Character then
		onCharacterAdded(player.Character)
	end

	UserInputService.InputBegan:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.Touch and not processed then
			local camera = workspace.CurrentCamera
			-- The left part of the screen belongs to the movement thumbstick.
			if camera and input.Position.X > camera.ViewportSize.X * 0.35 then
				lookTouches[input] = true
			end
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch and lookTouches[input] then
			if not ClientState.IsMenuOpen() then
				yaw -= input.Delta.X * settings.TouchSensitivity
				pitch -= input.Delta.Y * settings.TouchSensitivity
			end
		elseif input.KeyCode == Enum.KeyCode.Thumbstick2 then
			gamepadLook = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		lookTouches[input] = nil
		if input.KeyCode == Enum.KeyCode.Thumbstick2 then
			gamepadLook = Vector2.zero
		end
	end)
end

return CameraController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">ClientState</string>
              <string name="Source"><![CDATA[--[[
	ClientState
	===========
	Small shared state for the client controllers: which menus are open (menus free the mouse),
	and quick access to this player's profile and the match state replicated by the server.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared.Signal)

local player = Players.LocalPlayer

local ClientState = {}

ClientState.MenuChanged = Signal.new()
ClientState.AbilityDenied = Signal.new() -- (slot) pressed an ability that isn't ready

ClientState.Combatants = ReplicatedStorage:WaitForChild("Combatants")
ClientState.MatchState = ReplicatedStorage:WaitForChild("MatchState")

local menus = {}

function ClientState.SetMenu(name: string, open: boolean)
	if (menus[name] == true) == open then
		return
	end
	menus[name] = if open then true else nil
	ClientState.MenuChanged:Fire()
end

-- With a name: is that menu open? Without: is ANY menu open?
function ClientState.IsMenuOpen(name: string?): boolean
	if name then
		return menus[name] == true
	end
	return next(menus) ~= nil
end

-- This player's profile folder (attributes: Team, Hero, UltCharge, Kills, ...).
function ClientState.GetProfile(): Folder?
	return ClientState.Combatants:FindFirstChild("P" .. player.UserId)
end

function ClientState.GetMyTeam(): string?
	local profile = ClientState.GetProfile()
	local team = profile and profile:GetAttribute("Team")
	return if team and team ~= "" then team else nil
end

function ClientState.GetPhase(): string
	return ClientState.MatchState:GetAttribute("Phase") or "Waiting"
end

-- Seconds left in the current phase, or nil if the phase has no timer.
function ClientState.TimeLeft(): number?
	local endsAt = ClientState.MatchState:GetAttribute("PhaseEndsAt") or 0
	if endsAt <= 0 then
		return nil
	end
	return math.max(0, endsAt - workspace:GetServerTimeNow())
end

-- Our character if it is alive, else nil.
function ClientState.GetLivingCharacter(): Model?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		return character
	end
	return nil
end

return ClientState
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">CombatController</string>
              <string name="Source"><![CDATA[--[[
	CombatController
	================
	Turns your input into shots and abilities.

	Shooting works like most online shooters: we aim from the camera through the crosshair, fire
	from the hero's weapon toward that point, draw the shot instantly, and tell the server what we
	hit. The server double-checks everything before any damage happens (see WeaponService).
]]

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Heroes = require(Shared.Heroes)
local Remotes = require(Shared.Remotes)
local CombatUtil = require(Shared.CombatUtil)
local MotionUtil = require(Shared.MotionUtil)

local ClientState = require(script.Parent.ClientState)
local FXController = require(script.Parent.FXController)
local CameraController = require(script.Parent.CameraController)

local player = Players.LocalPlayer
local rng = Random.new()

local CombatController = {}

local triggerHeld = false
local nextFireTime = 0
local shotCounter = 0
local lastReloadRequest = 0

local function getArmedCharacter()
	local character = ClientState.GetLivingCharacter()
	local hero = character and Heroes.Get(character:GetAttribute("Hero"))
	if not hero then
		return nil, nil
	end
	return character, hero
end

-- The world point under the crosshair. Starts the ray level with our hero so walls behind
-- the hero (between it and the camera) are ignored.
local function getAimPoint(character: Model, range: number): Vector3
	local camera = workspace.CurrentCamera
	local look = camera.CFrame.LookVector
	local origin = camera.CFrame.Position
	local root = CombatUtil.GetRoot(character)
	if root then
		origin += look * math.max(0, (root.Position - origin):Dot(look))
	end
	local result = workspace:Raycast(origin, look * range, CombatUtil.ShotParams(character))
	return if result then result.Position else origin + look * range
end

local function requestReload()
	if os.clock() - lastReloadRequest > 0.5 then
		lastReloadRequest = os.clock()
		Remotes.Reload:FireServer()
	end
end

local function fireOnce(character: Model, hero)
	local weapon = hero.Primary
	local origin = CombatUtil.GetMuzzle(character)
	if not origin then
		return
	end
	local aimPoint = getAimPoint(character, (weapon.Range or 100) + 40)
	local direction = aimPoint - origin
	direction = if direction.Magnitude > 0.5 then direction.Unit else workspace.CurrentCamera.CFrame.LookVector

	if weapon.Kind == "Hitscan" then
		local params = CombatUtil.ShotParams(character)
		local ends, hits = {}, {}
		for _ = 1, weapon.Pellets or 1 do
			local pelletDirection = CombatUtil.SpreadDirection(direction, weapon.SpreadDegrees or 0, rng)
			local result = workspace:Raycast(origin, pelletDirection * weapon.Range, params)
			table.insert(ends, if result then result.Position else origin + pelletDirection * weapon.Range)
			if result then
				local instance = result.Instance
				if CombatUtil.GetCharacterFromPart(instance) or CollectionService:HasTag(instance, "Destructible") then
					table.insert(hits, { Part = instance, Position = result.Position })
				end
			end
		end
		FXController.Tracers(origin, ends, weapon.TracerColor, weapon.TracerWidth)
		Remotes.Fire:FireServer({ Ends = ends, Hits = hits })
		CameraController.Kick(if (weapon.Pellets or 1) > 1 then 0.03 else 0.008)
	elseif weapon.Kind == "Projectile" then
		shotCounter += 1
		FXController.SpawnProjectile({
			Id = tostring(player.UserId) .. "_" .. tostring(shotCounter),
			Origin = origin,
			Velocity = direction * weapon.ProjectileSpeed,
			Gravity = weapon.ProjectileGravity or 0,
			Lifetime = weapon.Range / weapon.ProjectileSpeed,
			Radius = weapon.ProjectileRadius,
			Color = weapon.TracerColor,
		})
		Remotes.Fire:FireServer({ AimPoint = aimPoint, ShotId = shotCounter })
		CameraController.Kick(0.012)
	elseif weapon.Kind == "Melee" then
		local look = workspace.CurrentCamera.CFrame.LookVector
		local root = CombatUtil.GetRoot(character)
		if root then
			FXController.Slash(root.Position + Vector3.new(0, 1, 0), look, weapon.Range, weapon.TracerColor)
		end
		Remotes.Fire:FireServer({ Direction = look })
	end
end

-- Runs every frame: keeps firing while the trigger is held, at the weapon's fire rate.
local function step()
	if not triggerHeld or ClientState.IsMenuOpen() then
		return
	end
	local character, hero = getArmedCharacter()
	if not character then
		return
	end
	local now = os.clock()
	if now < nextFireTime or character:GetAttribute("Reloading") then
		return
	end
	local weapon = hero.Primary
	if weapon.MagazineSize and not character:GetAttribute("InfiniteAmmo") and (character:GetAttribute("Ammo") or 0) <= 0 then
		requestReload()
		return
	end
	local fireRate = weapon.FireRate * (character:GetAttribute("FireRateMult") or 1)
	nextFireTime = now + 1 / fireRate
	fireOnce(character, hero)
	if not weapon.Automatic then
		triggerHeld = false
	end
end

local function useAbility(slot: string)
	if ClientState.IsMenuOpen() then
		return
	end
	local character, hero = getArmedCharacter()
	if not character or not hero.Abilities[slot] then
		return
	end
	if slot == "Ultimate" then
		local profile = ClientState.GetProfile()
		if not profile or (profile:GetAttribute("UltCharge") or 0) < 100 then
			ClientState.AbilityDenied:Fire(slot)
			return
		end
	elseif (character:GetAttribute("CD_" .. slot) or 0) > workspace:GetServerTimeNow() + 0.05 then
		ClientState.AbilityDenied:Fire(slot)
		return
	end

	local origin = CombatUtil.GetMuzzle(character) or workspace.CurrentCamera.CFrame.Position
	local point = getAimPoint(character, 400)
	local direction = point - origin
	direction = if direction.Magnitude > 0.5 then direction.Unit else workspace.CurrentCamera.CFrame.LookVector
	Remotes.UseAbility:FireServer(slot, { Direction = direction, Point = point })
end

local function bind(name: string, callback, inputs, title: string)
	ContextActionService:BindActionAtPriority(name, callback, true, Enum.ContextActionPriority.High.Value, table.unpack(inputs))
	ContextActionService:SetTitle(name, title)
end

local function onCharacterAdded(character: Model)
	triggerHeld = false
	nextFireTime = 0
	local humanoid = character:WaitForChild("Humanoid", 10)
	if humanoid and humanoid:IsA("Humanoid") then
		-- Big knockbacks shouldn't make our hero trip over.
		humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
	end
end

function CombatController.Init()
	local controls = Config.Controls

	bind("HS_Fire", function(_, state)
		if state == Enum.UserInputState.Begin then
			triggerHeld = not ClientState.IsMenuOpen()
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			triggerHeld = false
		end
		return Enum.ContextActionResult.Pass
	end, controls.Fire, "Fire")

	for _, slot in Heroes.AbilitySlots do
		bind("HS_" .. slot, function(_, state)
			if state == Enum.UserInputState.Begin then
				useAbility(slot)
			end
			return Enum.ContextActionResult.Pass
		end, controls[slot], Config.KeyLabels[slot])
	end

	bind("HS_Reload", function(_, state)
		if state == Enum.UserInputState.Begin and not ClientState.IsMenuOpen() then
			requestReload()
		end
		return Enum.ContextActionResult.Pass
	end, controls.Reload, "R")

	RunService.RenderStepped:Connect(step)

	-- The server asks us to move our own character for dashes and knockback.
	Remotes.Motion.OnClientEvent:Connect(function(kind, velocity, duration)
		local character = player.Character
		if not character or not CombatUtil.IsFiniteVector(velocity) then
			return
		end
		if kind == "Dash" then
			MotionUtil.Dash(character, velocity, if typeof(duration) == "number" then math.clamp(duration, 0, 2) else 0.2)
		elseif kind == "Impulse" then
			MotionUtil.Impulse(character, velocity)
		end
	end)

	player.CharacterAdded:Connect(onCharacterAdded)
	if player.Character then
		task.spawn(onCharacterAdded, player.Character)
	end
end

return CombatController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">FXController</string>
              <string name="Source"><![CDATA[--[[
	FXController
	============
	Draws every visual effect on this client: tracers, projectiles, explosions, rings, lightning,
	debris and floating damage numbers. Effects are local parts in Workspace.ClientFX that never
	collide or block shots. The server tells us what to draw through the "FX" remote; our own
	shots are drawn instantly by CombatController so they feel responsive.
]]

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local FXController = {}

local UPRIGHT = CFrame.Angles(0, 0, math.rad(90))

local folder: Folder? = nil
local projectiles = {} -- [id] = { Part, Position, Velocity, Gravity, Age, Lifetime }
local followers = {} -- [part] = { Root, Expires, Offset } effects that follow a character
local rng = Random.new()

local function getFolder(): Folder
	if not folder or not folder.Parent then
		folder = Instance.new("Folder")
		folder.Name = "ClientFX"
		folder.Parent = workspace
	end
	return folder :: Folder
end

local function effectPart(props): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = props.Material or Enum.Material.Neon
	part.Color = props.Color or Color3.new(1, 1, 1)
	part.Transparency = props.Transparency or 0
	if props.Shape then
		part.Shape = props.Shape
	end
	part.Size = props.Size or Vector3.one
	part.CFrame = props.CFrame or CFrame.new()
	part.Parent = getFolder()
	return part
end

local function fadeOut(instance: Instance, duration: number, goals)
	goals = goals or {}
	goals.Transparency = 1
	TweenService:Create(instance, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goals):Play()
	Debris:AddItem(instance, duration + 0.05)
end

--------------------------------------------------------------------------------
-- Sound
--------------------------------------------------------------------------------

-- Plays a sound in the world at `position`, or as a flat UI sound if position is nil.
function FXController.PlaySound(soundId: string?, position: Vector3?, volume: number?, speed: number?)
	if not soundId or soundId == "" then
		return
	end
	local sound = Instance.new("Sound")
	sound.SoundId = soundId
	sound.Volume = volume or 0.5
	sound.PlaybackSpeed = speed or 1
	if position then
		local attachment = Instance.new("Attachment")
		attachment.Position = position
		attachment.Parent = workspace.Terrain
		sound.RollOffMaxDistance = 250
		sound.Parent = attachment
		sound:Play()
		Debris:AddItem(attachment, 4)
	else
		sound.Parent = SoundService
		sound:Play()
		Debris:AddItem(sound, 4)
	end
end

--------------------------------------------------------------------------------
-- Effects
--------------------------------------------------------------------------------

function FXController.Tracer(origin: Vector3, finish: Vector3, color: Color3, width: number?, duration: number?)
	local length = (finish - origin).Magnitude
	if length < 0.1 then
		return
	end
	local thickness = width or 0.1
	local beam = effectPart({
		Size = Vector3.new(thickness, thickness, length),
		CFrame = CFrame.lookAt(origin, finish) * CFrame.new(0, 0, -length / 2),
		Color = color,
		Transparency = 0.1,
	})
	fadeOut(beam, duration or 0.12)
end

function FXController.MuzzleFlash(position: Vector3, color: Color3)
	local flash = effectPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.7, CFrame = CFrame.new(position), Color = color })
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 10
	light.Brightness = 3
	light.Parent = flash
	fadeOut(flash, 0.08)
end

function FXController.Tracers(origin: Vector3, ends, color: Color3, width: number?)
	for _, finish in ends do
		FXController.Tracer(origin, finish, color, width)
	end
	FXController.MuzzleFlash(origin, color)
	FXController.PlaySound(Config.Sounds.Hitscan, origin, 0.35, rng:NextNumber(0.95, 1.1))
end

function FXController.Explosion(position: Vector3, radius: number, color: Color3)
	local ball = effectPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 2, CFrame = CFrame.new(position), Color = color, Transparency = 0.15 })
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = radius * 2
	light.Brightness = 4
	light.Parent = ball
	fadeOut(ball, 0.35, { Size = Vector3.one * radius * 2 })
	FXController.PlaySound(Config.Sounds.Explosion, position, 0.6, rng:NextNumber(0.9, 1.1))
end

-- An expanding flat ring on the ground (heals, shockwaves, area abilities).
function FXController.Ring(position: Vector3, radius: number, color: Color3, duration: number?)
	local ring = effectPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 2, 2),
		CFrame = CFrame.new(position) * UPRIGHT,
		Color = color,
		Transparency = 0.25,
	})
	fadeOut(ring, duration or 0.45, { Size = Vector3.new(0.3, radius * 2, radius * 2) })
end

function FXController.Slash(origin: Vector3, direction: Vector3, range: number, color: Color3)
	local blade = effectPart({
		Size = Vector3.new(range * 1.3, 0.2, 0.8),
		CFrame = CFrame.lookAt(origin, origin + direction) * CFrame.new(0, 0, -range * 0.5),
		Color = color,
		Transparency = 0.15,
	})
	fadeOut(blade, 0.16, { Size = Vector3.new(range * 1.6, 0.05, 0.3) })
	FXController.PlaySound(Config.Sounds.Melee, origin, 0.5, rng:NextNumber(0.95, 1.15))
end

function FXController.Blink(from: Vector3, to: Vector3, color: Color3)
	FXController.Tracer(from, to, color, 1.2, 0.3)
	FXController.Ring(from, 4, color, 0.3)
	FXController.Ring(to, 4, color, 0.3)
	FXController.PlaySound(Config.Sounds.Ability, to, 0.6, 1.3)
end

function FXController.Lightning(position: Vector3, radius: number, color: Color3)
	local top = position + Vector3.new(rng:NextNumber(-4, 4), 90, rng:NextNumber(-4, 4))
	local points = { top }
	local segments = 7
	for index = 1, segments - 1 do
		local point = top:Lerp(position, index / segments)
		table.insert(points, point + Vector3.new(rng:NextNumber(-3, 3), 0, rng:NextNumber(-3, 3)))
	end
	table.insert(points, position)
	for index = 1, #points - 1 do
		FXController.Tracer(points[index], points[index + 1], color, 0.7, 0.3)
	end
	FXController.Explosion(position + Vector3.new(0, 1, 0), radius * 0.6, color)
	FXController.Ring(position, radius, color, 0.4)
end

-- A pulsing warning circle that shows where something is about to happen.
function FXController.Telegraph(position: Vector3, radius: number, duration: number, color: Color3)
	local disc = effectPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, radius * 2, radius * 2),
		CFrame = CFrame.new(position + Vector3.new(0, 0.3, 0)) * UPRIGHT,
		Color = color,
		Transparency = 0.8,
	})
	TweenService:Create(disc, TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
		Transparency = 0.45,
	}):Play()
	Debris:AddItem(disc, duration)
end

-- Breaks a destroyed piece of cover into tumbling chunks.
function FXController.Shatter(cframe: CFrame, size: Vector3, color: Color3, material: Enum.Material?)
	local count = math.clamp(math.floor(size.X * size.Y * size.Z / 12), 4, 14)
	for _ = 1, count do
		local piece = Instance.new("Part")
		local scale = rng:NextNumber(0.5, 1.4)
		piece.Size = Vector3.new(scale, scale * rng:NextNumber(0.5, 1), scale)
		piece.CFrame = cframe
			* CFrame.new(
				rng:NextNumber(-0.5, 0.5) * size.X,
				rng:NextNumber(-0.5, 0.5) * size.Y,
				rng:NextNumber(-0.5, 0.5) * size.Z
			)
			* CFrame.Angles(rng:NextNumber(0, math.pi * 2), rng:NextNumber(0, math.pi * 2), 0)
		piece.Color = color
		piece.Material = material or Enum.Material.SmoothPlastic
		piece.CanQuery = false
		piece.CanTouch = false
		piece.CollisionGroup = "Debris"
		piece.Parent = getFolder()
		piece.AssemblyLinearVelocity = Vector3.new(rng:NextNumber(-25, 25), rng:NextNumber(10, 35), rng:NextNumber(-25, 25))
		Debris:AddItem(piece, rng:NextNumber(1.8, 2.8))
	end
	FXController.PlaySound(Config.Sounds.Explosion, cframe.Position, 0.35, 1.4)
end

function FXController.DashTrail(character: Model, duration: number, color: Color3)
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local top = Instance.new("Attachment")
	top.Position = Vector3.new(0, 1.2, 0)
	top.Parent = root
	local bottom = Instance.new("Attachment")
	bottom.Position = Vector3.new(0, -1.8, 0)
	bottom.Parent = root
	local trail = Instance.new("Trail")
	trail.Attachment0 = top
	trail.Attachment1 = bottom
	trail.Color = ColorSequence.new(color)
	trail.Transparency = NumberSequence.new(0.3, 1)
	trail.Lifetime = 0.3
	trail.LightEmission = 1
	trail.Parent = root
	for _, item in { trail, top, bottom } do
		Debris:AddItem(item, duration + 0.35)
	end
	FXController.PlaySound(Config.Sounds.Dash, root.Position, 0.5)
end

-- A glowing ring that follows a character for a while (buffs, ultimates).
function FXController.Aura(character: Model, duration: number, color: Color3, radius: number?)
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local size = (radius or 3.5) * 2
	local ring = effectPart({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, size, size), Color = color, Transparency = 0.55 })
	followers[ring] = { Root = root, Expires = os.clock() + duration, Offset = -2.8 }
end

function FXController.DamageNumber(position: Vector3, text: string, color: Color3, big: boolean?)
	local offset = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(0.5, 1.5), rng:NextNumber(-1, 1))
	local anchor = effectPart({ Transparency = 1, Size = Vector3.one * 0.2, CFrame = CFrame.new(position + offset) })
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(if big then 96 else 72, if big then 36 else 28)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.MaxDistance = 250
	billboard.Parent = anchor
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.3
	label.Parent = billboard
	TweenService:Create(billboard, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		StudsOffset = Vector3.new(0, 2.5, 0),
	}):Play()
	TweenService:Create(label, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	}):Play()
	Debris:AddItem(anchor, 0.75)
end

--------------------------------------------------------------------------------
-- Projectiles (simulated exactly like the server simulates them)
--------------------------------------------------------------------------------

function FXController.SpawnProjectile(data)
	if projectiles[data.Id] then
		return
	end
	local size = math.max(0.6, (data.Radius or 0.5) * 2)
	local color = data.Color or Color3.new(1, 1, 1)
	local orb = effectPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * size, CFrame = CFrame.new(data.Origin), Color = color })

	local top = Instance.new("Attachment")
	top.Position = Vector3.new(0, size * 0.35, 0)
	top.Parent = orb
	local bottom = Instance.new("Attachment")
	bottom.Position = Vector3.new(0, -size * 0.35, 0)
	bottom.Parent = orb
	local trail = Instance.new("Trail")
	trail.Attachment0 = top
	trail.Attachment1 = bottom
	trail.Color = ColorSequence.new(color)
	trail.Transparency = NumberSequence.new(0.3, 1)
	trail.Lifetime = 0.18
	trail.LightEmission = 1
	trail.FaceCamera = true
	trail.Parent = orb
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 8
	light.Brightness = 2
	light.Parent = orb

	projectiles[data.Id] = {
		Part = orb,
		Position = data.Origin,
		Velocity = data.Velocity,
		Gravity = data.Gravity or 0,
		Age = 0,
		Lifetime = (data.Lifetime or 3) + 0.3,
	}
	FXController.PlaySound(Config.Sounds.Projectile, data.Origin, 0.35, rng:NextNumber(1.1, 1.3))
end

function FXController.EndProjectile(data)
	local projectile = projectiles[data.Id]
	if projectile then
		projectile.Part:Destroy()
		projectiles[data.Id] = nil
	end
	local color = data.Color or Color3.new(1, 1, 1)
	if data.Impact == "Explosion" then
		FXController.Explosion(data.Position, data.Radius or 6, color)
	else
		FXController.Ring(data.Position, data.Radius or 2, color, 0.2)
	end
end

local function step(dt: number)
	for id, projectile in projectiles do
		projectile.Age += dt
		if projectile.Age > projectile.Lifetime or not projectile.Part.Parent then
			projectile.Part:Destroy()
			projectiles[id] = nil
		else
			local gravity = Vector3.new(0, -projectile.Gravity, 0)
			projectile.Position += projectile.Velocity * dt + gravity * (0.5 * dt * dt)
			projectile.Velocity += gravity * dt
			projectile.Part.CFrame = CFrame.new(projectile.Position)
		end
	end

	local now = os.clock()
	for part, info in followers do
		if now >= info.Expires or not info.Root.Parent then
			followers[part] = nil
			fadeOut(part, 0.2)
		else
			part.CFrame = CFrame.new(info.Root.Position + Vector3.new(0, info.Offset, 0)) * UPRIGHT
		end
	end
end

--------------------------------------------------------------------------------
-- Server events
--------------------------------------------------------------------------------

local handlers = {
	Tracer = function(data)
		FXController.Tracers(data.Origin, data.Ends or {}, data.Color, data.Width)
	end,
	Projectile = FXController.SpawnProjectile,
	ProjectileEnd = FXController.EndProjectile,
	Explosion = function(data)
		FXController.Explosion(data.Position, data.Radius, data.Color)
	end,
	Ring = function(data)
		FXController.Ring(data.Position, data.Radius, data.Color, data.Time)
		FXController.PlaySound(Config.Sounds.Ability, data.Position, 0.4)
	end,
	Burst = function(data)
		FXController.Ring(data.Position, 6, data.Color, 0.3)
		FXController.PlaySound(Config.Sounds.Dash, data.Position, 0.5, 0.8)
	end,
	Slash = function(data)
		FXController.Slash(data.Origin, data.Direction, data.Range, data.Color)
	end,
	Blink = function(data)
		FXController.Blink(data.From, data.To, data.Color)
	end,
	Lightning = function(data)
		FXController.Lightning(data.Position, data.Radius, data.Color)
	end,
	Telegraph = function(data)
		FXController.Telegraph(data.Position, data.Radius, data.Duration, data.Color)
	end,
	Shatter = function(data)
		FXController.Shatter(data.CFrame, data.Size, data.Color, data.Material)
	end,
	DashTrail = function(data)
		FXController.DashTrail(data.Character, data.Duration, data.Color)
	end,
	Aura = function(data)
		FXController.Aura(data.Character, data.Duration, data.Color, data.Radius)
	end,
	UltActivated = function()
		FXController.PlaySound(Config.Sounds.Ultimate, nil, 0.6)
	end,
}

function FXController.Init()
	getFolder()
	RunService.RenderStepped:Connect(step)
	Remotes.FX.OnClientEvent:Connect(function(kind, data)
		local handler = handlers[kind]
		if handler and typeof(data) == "table" then
			local ok, err = pcall(handler, data)
			if not ok then
				warn("[FX] " .. tostring(kind) .. ": " .. tostring(err))
			end
		end
	end)
end

return FXController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">HUDController</string>
              <string name="Source"><![CDATA[--[[
	HUDController
	=============
	Everything on screen during a match:
	  bottom-left    hero name, health and shields, active buffs
	  bottom-centre  ability cooldowns and ultimate charge, active team-ups
	  bottom-right   ammo
	  top-centre     objective: team scores, point status, round wins, phase timer
	  top-right      kill feed
	  centre         crosshair, hit markers, big announcements, death/respawn panel
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Heroes = require(Shared.Heroes)
local Remotes = require(Shared.Remotes)

local ClientState = require(script.Parent.ClientState)
local UIKit = require(script.Parent.UIKit)
local FXController = require(script.Parent.FXController)

local player = Players.LocalPlayer
local Colors = UIKit.Colors
local Fonts = UIKit.Fonts
local WHITE = Color3.new(1, 1, 1)

local HUDController = {}

local ui = {}
local lastKiller = ""
local feedOrder = 0
local bannerToken = 0
local toastToken = 0
local ultFeedToken = 0
local deniedFlash = {} -- [slot] = os.clock() until which the slot flashes red

--------------------------------------------------------------------------------
-- Building
--------------------------------------------------------------------------------

local function buildOverlay(playerGui: PlayerGui)
	-- Full-screen layer whose centre is the true screen centre (where the camera aims).
	local overlay = UIKit.Create("ScreenGui", {
		Name = "HUDOverlay",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ScreenInsets = Enum.ScreenInsets.None,
		DisplayOrder = 0,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	})

	ui.DamageFlash = UIKit.Frame({
		Name = "DamageFlash",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(255, 40, 40),
		BackgroundTransparency = 1,
		Parent = overlay,
	})

	local crosshair = UIKit.Frame({
		Name = "Crosshair",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(40, 40),
		BackgroundTransparency = 1,
		Parent = overlay,
	})
	local function tick(position: UDim2, size: UDim2)
		local line = UIKit.Frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = position,
			Size = size,
			BackgroundColor3 = WHITE,
			Parent = crosshair,
		})
		UIKit.Stroke(line, Color3.new(0, 0, 0), 1, 0.45)
	end
	tick(UDim2.new(0.5, 0, 0.5, -9), UDim2.fromOffset(2, 7))
	tick(UDim2.new(0.5, 0, 0.5, 9), UDim2.fromOffset(2, 7))
	tick(UDim2.new(0.5, -9, 0.5, 0), UDim2.fromOffset(7, 2))
	tick(UDim2.new(0.5, 9, 0.5, 0), UDim2.fromOffset(7, 2))
	tick(UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(2, 2))
	UIKit.AutoScale(crosshair)
	ui.Crosshair = crosshair

	local marker = UIKit.Frame({
		Name = "HitMarker",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(32, 32),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = overlay,
	})
	ui.HitMarkerArms = {}
	for _, angle in { 45, 135, 225, 315 } do
		local radians = math.rad(angle)
		local arm = UIKit.Frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, math.sin(radians) * 10, 0.5, -math.cos(radians) * 10),
			Size = UDim2.fromOffset(2, 9),
			Rotation = angle,
			BackgroundColor3 = WHITE,
			Parent = marker,
		})
		table.insert(ui.HitMarkerArms, arm)
	end
	UIKit.AutoScale(marker)
	ui.HitMarker = marker

	ui.KillConfirm = UIKit.Text({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 80),
		Size = UDim2.fromOffset(420, 28),
		Font = Fonts.Black,
		TextSize = 20,
		TextColor3 = Colors.HealthLow,
		TextStrokeTransparency = 0.5,
		Visible = false,
		Parent = overlay,
	})
	UIKit.AutoScale(ui.KillConfirm)
end

