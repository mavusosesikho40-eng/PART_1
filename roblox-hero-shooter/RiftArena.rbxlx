      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">CombatUtil</string>
          <string name="Source"><![CDATA[--[[
	CombatUtil
	==========
	Small helpers used by both the server (hit validation) and the client (aiming), so both
	sides agree on things like where a shot starts and what it can pass through.
]]

local CollectionService = game:GetService("CollectionService")

local CombatUtil = {}

-- Walks up from a part to the character Model that owns it (anything with a Humanoid).
function CombatUtil.GetCharacterFromPart(part)
	local current = part
	while current and current ~= workspace and current ~= game do
		if current:IsA("Model") and current:FindFirstChildOfClass("Humanoid") then
			return current
		end
		current = current.Parent
	end
	return nil
end

function CombatUtil.GetHumanoid(character)
	return if character then character:FindFirstChildOfClass("Humanoid") else nil
end

function CombatUtil.GetRoot(character)
	if not character then
		return nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

function CombatUtil.IsAlive(character): boolean
	if not character or not character.Parent then
		return false
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0
end

function CombatUtil.GetTeam(character)
	return if character then character:GetAttribute("Team") else nil
end

function CombatUtil.AreEnemies(a, b): boolean
	local teamA, teamB = CombatUtil.GetTeam(a), CombatUtil.GetTeam(b)
	return teamA ~= nil and teamB ~= nil and teamA ~= "" and teamB ~= "" and teamA ~= teamB
end

-- Every fighter (players and bots) currently in the world.
function CombatUtil.GetAllCharacters()
	local list = {}
	for _, child in workspace:GetChildren() do
		if child:IsA("Model") and child:GetAttribute("CombatantId") then
			table.insert(list, child)
		end
	end
	return list
end

-- Where shots come out: just right of the head, roughly where the weapon is held.
function CombatUtil.GetMuzzle(character)
	local root = CombatUtil.GetRoot(character)
	if not root then
		return nil
	end
	local head = character:FindFirstChild("Head")
	local base = if head and head:IsA("BasePart") then head.Position else root.Position + Vector3.new(0, 1.5, 0)
	return base + root.CFrame.RightVector * 1 - Vector3.new(0, 0.4, 0)
end

-- Barriers that belong to a team. Allies shoot straight through their own team's barriers.
function CombatUtil.GetTeamBarriers(team)
	local list = {}
	if team == nil or team == "" then
		return list
	end
	for _, barrier in CollectionService:GetTagged("Barrier") do
		if barrier:GetAttribute("Team") == team then
			table.insert(list, barrier)
		end
	end
	return list
end

-- Raycast params for a shot fired by `shooter`: ignores the shooter and their team's barriers.
-- With ignoreCharacters = true it only sees the world (used for line-of-sight checks).
function CombatUtil.ShotParams(shooter, ignoreCharacters: boolean?): RaycastParams
	local ignore = { shooter }
	for _, barrier in CombatUtil.GetTeamBarriers(shooter:GetAttribute("Team")) do
		table.insert(ignore, barrier)
	end
	if ignoreCharacters then
		for _, character in CombatUtil.GetAllCharacters() do
			table.insert(ignore, character)
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	params.IgnoreWater = true
	return params
end

-- Rotates `direction` randomly inside a cone `spreadDegrees` wide.
function CombatUtil.SpreadDirection(direction: Vector3, spreadDegrees: number, rng: Random): Vector3
	local unit = direction.Unit
	if spreadDegrees <= 0 then
		return unit
	end
	local up = if math.abs(unit.Y) > 0.99 then Vector3.xAxis else Vector3.yAxis
	local frame = CFrame.lookAt(Vector3.zero, unit, up)
	local angle = math.rad(spreadDegrees) * math.sqrt(rng:NextNumber())
	local roll = rng:NextNumber() * math.pi * 2
	return (frame * CFrame.Angles(0, 0, roll) * CFrame.Angles(angle, 0, 0)).LookVector
end

-- Damage multiplier for a weapon at a given distance (1 = full damage).
function CombatUtil.Falloff(weapon, distance: number): number
	local start, finish, minimum = weapon.FalloffStart, weapon.FalloffEnd, weapon.FalloffMin
	if not start or not finish or not minimum then
		return 1
	end
	if distance <= start then
		return 1
	elseif distance >= finish then
		return minimum
	end
	local alpha = (distance - start) / (finish - start)
	return 1 + (minimum - 1) * alpha
end

-- Horizontal unit vector (falls back to "forward" if the input points straight up or down).
function CombatUtil.Flatten(vector: Vector3): Vector3
	local flat = Vector3.new(vector.X, 0, vector.Z)
	return if flat.Magnitude > 1e-3 then flat.Unit else Vector3.new(0, 0, -1)
end

-- Rejects NaN, infinity and non-Vector3 values (never trust what a client sends!).
function CombatUtil.IsFiniteVector(value): boolean
	if typeof(value) ~= "Vector3" then
		return false
	end
	for _, component in { value.X, value.Y, value.Z } do
		if component ~= component or math.abs(component) > 1e6 then
			return false
		end
	end
	return true
end

-- The Y rotation that makes a CFrame face `look` (used to point cameras at spawn).
function CombatUtil.YawFromLook(look: Vector3): number
	return math.atan2(-look.X, -look.Z)
end

return CombatUtil
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	Config
	======
	Every number that controls how a match plays lives here, so you can tune the game without
	digging through the code. Hero stats live in Heroes.luau, team-ups in Synergies.luau.

	This module is shared: the server and every client read the same values.
]]

local Config = {}

-- Shown on menus and banners. Rename it to whatever you call your game!
Config.GameName = "RIFT ARENA"

--------------------------------------------------------------------------------
-- Teams (exactly two). "Name" is used by the code; the colours are used by the HUD.
--------------------------------------------------------------------------------
Config.Teams = {
	{
		Name = "Blue",
		DisplayName = "BLUE",
		BrickColor = BrickColor.new("Bright blue"),
		Color = Color3.fromRGB(70, 160, 255),
	},
	{
		Name = "Red",
		DisplayName = "RED",
		BrickColor = BrickColor.new("Bright red"),
		Color = Color3.fromRGB(255, 80, 80),
	},
}

function Config.GetTeam(name)
	for _, team in Config.Teams do
		if team.Name == name then
			return team
		end
	end
	return nil
end

function Config.GetTeamColor(name): Color3
	local team = Config.GetTeam(name)
	return if team then team.Color else Color3.fromRGB(210, 210, 215)
end

function Config.GetOtherTeam(name)
	if name == Config.Teams[1].Name then
		return Config.Teams[2].Name
	elseif name == Config.Teams[2].Name then
		return Config.Teams[1].Name
	end
	return nil
end

--------------------------------------------------------------------------------
-- Match flow
--------------------------------------------------------------------------------
Config.Match = {
	MaxPlayersPerTeam = 6, -- real players per team
	BotsFillTeamsTo = 5, -- top each team up to this many fighters with bots (0 = no bots)
	MinPlayersToStart = 1, -- real players needed before a match begins
	IntermissionTime = 10, -- seconds between matches
	SetupTime = 20, -- start of every round: pick heroes, spawn doors stay shut
	PointUnlockDelay = 10, -- seconds after the doors open before the point can be captured
	RoundsToWin = 2, -- best of 3
	RoundEndTime = 6,
	MatchEndTime = 10,
	RespawnTime = 6,
	AllowDuplicateHeroes = true, -- false = each hero can only be picked once per team
	AssistWindow = 10, -- damage dealt within this many seconds counts toward kills and assists
	SpawnRoomHealPerSecond = 150, -- your own spawn room heals you quickly
	EnemySpawnRoomDamagePerSecond = 200, -- the enemy's spawn room is deadly
	KillHeight = -60, -- fall below this Y and you are eliminated
}

--------------------------------------------------------------------------------
-- Control point ("king of the hill")
--------------------------------------------------------------------------------
Config.Objective = {
	CaptureTime = 8, -- seconds for ONE player to capture the point
	CaptureSpeedPerExtraPlayer = 0.3, -- each extra player on the point adds 30% capture speed...
	MaxCapturers = 3, -- ...up to this many players
	ScorePerSecond = 1.25, -- the holding team gains this many % per second (80s to win a round)
	DecayPerSecond = 10, -- unattended capture progress drains this fast
}

--------------------------------------------------------------------------------
-- Combat
--------------------------------------------------------------------------------
Config.Combat = {
	PassiveUltChargePerSecond = 0.35, -- % of your ultimate gained per second just for being alive
	DefaultHeadshotMultiplier = 1.5,
	MaxShield = 500, -- cap on temporary bonus shields
	FriendlyFire = false,
}

--------------------------------------------------------------------------------
-- Bots (they fill empty slots so you can play alone or with a few friends)
--------------------------------------------------------------------------------
Config.Bots = {
	Names = { "Echo", "Nyx", "Pike", "Juno", "Vale", "Onyx", "Wren", "Sable", "Flint", "Moss", "Rune", "Ash" },
	AimErrorDegrees = 3.5, -- bigger = worse aim
	ReactionTime = 0.45, -- seconds before a bot starts shooting a new target
	SightRange = 140,
	ThinkInterval = 0.1,
	RetreatHealthFraction = 0.3, -- below this much health, bots run home to heal
}

--------------------------------------------------------------------------------
-- Controls. Keyboard + mouse and gamepad; phones and tablets get on-screen buttons.
--------------------------------------------------------------------------------
Config.Controls = {
	Fire = { Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2 },
	Ability1 = { Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL1 },
	Ability2 = { Enum.KeyCode.E, Enum.KeyCode.ButtonR1 },
	Ultimate = { Enum.KeyCode.Q, Enum.KeyCode.ButtonY },
	Reload = { Enum.KeyCode.R, Enum.KeyCode.ButtonX },
	HeroSelect = { Enum.KeyCode.H, Enum.KeyCode.DPadUp },
	Scoreboard = { Enum.KeyCode.Tab, Enum.KeyCode.ButtonSelect },
}

-- Labels the HUD shows next to each action.
Config.KeyLabels = {
	Fire = "LMB",
	Ability1 = "SHIFT",
	Ability2 = "E",
	Ultimate = "Q",
	Reload = "R",
	HeroSelect = "H",
	Scoreboard = "TAB",
}

--------------------------------------------------------------------------------
-- Camera (over-the-shoulder third person)
--------------------------------------------------------------------------------
Config.Camera = {
	Distance = 11,
	ShoulderOffset = 2.4, -- studs to the right of your hero
	Height = 2.2, -- studs above the HumanoidRootPart
	FieldOfView = 72,
	MouseSensitivity = 0.0032, -- radians per pixel, multiplied by the player's Roblox sensitivity setting
	GamepadSensitivity = 3.2, -- radians per second with the stick fully pushed
	TouchSensitivity = 0.0065,
	MinPitch = -70, -- degrees
	MaxPitch = 70,
}

--------------------------------------------------------------------------------
-- Sounds. These are built-in Roblox sounds that ship with every client. Replace them with
-- your own "rbxassetid://123456" ids to give your game its own voice.
--------------------------------------------------------------------------------
Config.Sounds = {
	Hitscan = "rbxasset://sounds/paintball.wav",
	Projectile = "rbxasset://sounds/Rocket shot.wav",
	Melee = "rbxasset://sounds/swordslash.wav",
	Explosion = "rbxasset://sounds/collide.wav",
	Ability = "rbxasset://sounds/electronicpingshort.wav",
	Dash = "rbxasset://sounds/swordlunge.wav",
	Ultimate = "rbxasset://sounds/unsheath.wav",
	HitMarker = "rbxasset://sounds/electronicpingshort.wav",
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Heroes</string>
          <string name="Source"><![CDATA[--[[
	Heroes
	======
	Every hero's stats, weapon and abilities. The server uses these numbers to run the abilities
	(see ServerScriptService/Server/HeroKits) and the client uses them for the HUD and the hero
	select screen, so changing a number here changes it everywhere.

	HOW TO ADD A HERO
	  1. Copy one of the entries below, give it a new Id and change the numbers.
	  2. Add the Id to Heroes.Order so it appears on the hero select screen.
	  3. Create ServerScriptService/Server/HeroKits/<Id>.luau with Ability1, Ability2 and
	     Ultimate functions (copy an existing kit to start).

	Primary weapon kinds:
	  "Hitscan"     instant bullets (rifles, shotguns). Pellets > 1 makes a shotgun.
	  "Projectile"  travelling shots. SplashRadius/SplashDamage make them explode,
	                Heal makes them heal the allies they hit.
	  "Melee"       hits everything in a cone in front of you.

	The "Bot" table tells bots how to use each ability:
	  Engage       dash at a nearby enemy          Attack       use on a visible enemy
	  AttackClose  use when an enemy is in reach   Escape       use when low on health
	  Travel       use to reach the objective      Defend       place cover toward enemies
	  HealAllies   use when a nearby ally is hurt  TeamUlt      use when allies are fighting nearby
]]

local Heroes = {}

Heroes.Roles = {
	Tank = { Name = "TANK", Icon = "■", Color = Color3.fromRGB(110, 170, 255) },
	Damage = { Name = "DAMAGE", Icon = "▲", Color = Color3.fromRGB(255, 125, 105) },
	Support = { Name = "SUPPORT", Icon = "✚", Color = Color3.fromRGB(120, 230, 150) },
}

Heroes.Definitions = {
	----------------------------------------------------------------------------
	Bulwark = {
		Id = "Bulwark",
		DisplayName = "Bulwark",
		Role = "Tank",
		Tagline = "The wall that walks.",
		Description = "A heavy defender who shields the team with energy walls and smashes through enemy lines.",
		Color = Color3.fromRGB(60, 110, 170),
		AccentColor = Color3.fromRGB(110, 225, 255),
		MaxHealth = 600,
		WalkSpeed = 14.5,
		JumpHeight = 6.5,
		UltCost = 2200, -- damage + healing needed to charge the ultimate
		Primary = {
			Name = "Breach Cannon",
			Description = "Close-range scatter shot. Devastating up close, weak at range.",
			Kind = "Hitscan",
			Damage = 9, -- per pellet
			Pellets = 9,
			SpreadDegrees = 5.5,
			FireRate = 1.2, -- shots per second
			Automatic = true,
			Range = 45,
			FalloffStart = 12,
			FalloffEnd = 35,
			FalloffMin = 0.35,
			HeadshotMultiplier = 1.5,
			MagazineSize = 6,
			ReloadTime = 2,
			TracerColor = Color3.fromRGB(110, 225, 255),
			TracerWidth = 0.12,
		},
		Abilities = {
			Ability1 = {
				Name = "Ram Dash",
				Icon = "»",
				Description = "Charge forward, damaging and knocking back enemies in your path.",
				Cooldown = 8,
				Distance = 30,
				Duration = 0.4,
				Damage = 45,
				Knockback = 55,
				HitRadius = 6,
			},
			Ability2 = {
				Name = "Aegis Wall",
				Icon = "▮",
				Description = "Deploy an energy wall that blocks enemy fire. Your team can shoot through it.",
				Cooldown = 14,
				Health = 900,
				Duration = 9,
				Width = 16,
				Height = 9,
				PlaceDistance = 9,
			},
			Ultimate = {
				Name = "Fortress Protocol",
				Icon = "✦",
				Description = "You and nearby allies gain 200 shields and take 30% less damage for 8 seconds.",
				Radius = 30,
				Shield = 200,
				DamageReduction = 0.3,
				Duration = 8,
			},
		},
		Bot = { PreferredRange = 14, Ability1 = "Engage", Ability2 = "Defend", Ultimate = "TeamUlt" },
	},

	----------------------------------------------------------------------------
	Kestrel = {
		Id = "Kestrel",
		DisplayName = "Kestrel",
		Role = "Damage",
		Tagline = "Eyes in the sky.",
		Description = "An agile marksman with a jet harness who takes the high ground and picks targets off from range.",
		Color = Color3.fromRGB(200, 120, 40),
		AccentColor = Color3.fromRGB(255, 190, 70),
		MaxHealth = 250,
		WalkSpeed = 16.5,
		JumpHeight = 7.5,
		UltCost = 2000,
		Primary = {
			Name = "Talon Rifle",
			Description = "Fully automatic rifle. Headshots deal 80% bonus damage.",
			Kind = "Hitscan",
			Damage = 19,
			FireRate = 7,
			Automatic = true,
			Range = 160,
			SpreadDegrees = 0.8,
			FalloffStart = 45,
			FalloffEnd = 100,
			FalloffMin = 0.6,
			HeadshotMultiplier = 1.8,
			MagazineSize = 30,
			ReloadTime = 1.5,
			TracerColor = Color3.fromRGB(255, 190, 70),
			TracerWidth = 0.08,
		},
		Abilities = {
			Ability1 = {
				Name = "Jet Leap",
				Icon = "▲",
				Description = "Blast up and forward with your jet harness.",
				Cooldown = 7,
				UpSpeed = 60,
				ForwardSpeed = 40,
				Duration = 0.22,
			},
			Ability2 = {
				Name = "Shock Grenade",
				Icon = "●",
				Description = "Lob a grenade that explodes, damaging and slowing enemies.",
				Cooldown = 10,
				Damage = 70,
				Radius = 12,
				Speed = 85,
				Gravity = 110,
				SlowAmount = 0.4,
				SlowDuration = 2.5,
			},
			Ultimate = {
				Name = "Overdrive",
