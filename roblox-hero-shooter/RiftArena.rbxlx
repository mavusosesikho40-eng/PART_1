--------------------------------------------------------------------------------
-- Messages
--------------------------------------------------------------------------------

local function showBanner(title: string, subtitle: string?, color: Color3?, duration: number?)
	bannerToken += 1
	local token = bannerToken
	ui.BannerTitle.Text = title
	ui.BannerTitle.TextColor3 = color or Colors.Text
	ui.BannerSubtitle.Text = subtitle or ""
	ui.BannerTitle.TextTransparency = 1
	ui.BannerSubtitle.TextTransparency = 1
	ui.Banner.Visible = true
	local fadeIn = TweenInfo.new(0.2)
	TweenService:Create(ui.BannerTitle, fadeIn, { TextTransparency = 0 }):Play()
	TweenService:Create(ui.BannerSubtitle, fadeIn, { TextTransparency = 0 }):Play()
	task.delay(duration or 2.5, function()
		if bannerToken ~= token then
			return
		end
		local fade = TweenInfo.new(0.4)
		TweenService:Create(ui.BannerTitle, fade, { TextTransparency = 1 }):Play()
		TweenService:Create(ui.BannerSubtitle, fade, { TextTransparency = 1 }):Play()
		task.wait(0.45)
		if bannerToken == token then
			ui.Banner.Visible = false
		end
	end)
end

local function showToast(text: string)
	toastToken += 1
	local token = toastToken
	ui.Toast.Text = text
	ui.Toast.Visible = true
	task.delay(2.5, function()
		if toastToken == token then
			ui.Toast.Visible = false
		end
	end)
end

local function addKillFeed(data)
	feedOrder += 1
	local entry = UIKit.Frame({
		Size = UDim2.fromOffset(0, 26),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Colors.Panel,
		BackgroundTransparency = 0.3,
		LayoutOrder = feedOrder,
		Parent = ui.KillFeed,
	})
	UIKit.Corner(entry, 6)
	UIKit.Create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = entry })
	UIKit.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
		Parent = entry,
	})
	local function chunk(text: string?, color: Color3, order: number, font: Enum.Font?)
		if not text or text == "" then
			return
		end
		UIKit.Text({
			Size = UDim2.fromOffset(0, 22),
			AutomaticSize = Enum.AutomaticSize.X,
			Text = text,
			TextColor3 = color,
			TextSize = 14,
			Font = font or Fonts.Bold,
			LayoutOrder = order,
			Parent = entry,
		})
	end
	local function heroName(heroId)
		local hero = Heroes.Get(heroId)
		return if hero then hero.DisplayName else nil
	end

	if data.KillerName then
		chunk(data.KillerName, Config.GetTeamColor(data.KillerTeam), 1)
		chunk(heroName(data.KillerHero), Colors.Muted, 2, Fonts.Regular)
		chunk("›", Colors.Text, 3, Fonts.Black)
	else
		chunk("✕", Colors.Muted, 3, Fonts.Black)
	end
	chunk(data.VictimName, Config.GetTeamColor(data.VictimTeam), 4)
	chunk(heroName(data.VictimHero), Colors.Muted, 5, Fonts.Regular)

	-- Keep the newest six.
	local entries = {}
	for _, child in ui.KillFeed:GetChildren() do
		if child:IsA("Frame") then
			table.insert(entries, child)
		end
	end
	table.sort(entries, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	for index = 1, #entries - 6 do
		entries[index]:Destroy()
	end
	task.delay(7, function()
		if entry.Parent then
			entry:Destroy()
		end
	end)
end

local function flashHitMarker(color: Color3)
	for _, arm in ui.HitMarkerArms do
		arm.BackgroundColor3 = color
	end
	ui.HitMarker.Visible = true
	local shownAt = os.clock()
	ui.HitMarkerShownAt = shownAt
	task.delay(0.15, function()
		if ui.HitMarkerShownAt == shownAt then
			ui.HitMarker.Visible = false
		end
	end)
end

local function onNotify(kind: string, data)
	if typeof(data) ~= "table" then
		return
	end
	local myTeam = ClientState.GetMyTeam()
	if kind == "Kill" then
		addKillFeed(data)
	elseif kind == "Announce" then
		showBanner(data.Title or "", data.Subtitle, nil, data.Duration)
	elseif kind == "Message" then
		showToast(data.Text or "")
	elseif kind == "PointCaptured" then
		if data.Team == myTeam then
			showBanner("POINT CAPTURED", "Hold it to win the round!", Config.GetTeamColor(data.Team), 2)
		else
			showBanner("POINT LOST", "Take it back!", Colors.HealthLow, 2)
		end
	elseif kind == "RoundOver" then
		local won = data.Winner == myTeam
		showBanner(if won then "ROUND WON" else "ROUND LOST", "Round " .. tostring(data.Round or ""), if won then Config.GetTeamColor(myTeam) else Colors.HealthLow, 4)
	elseif kind == "MatchOver" then
		local won = data.Winner == myTeam
		showBanner(if won then "VICTORY" else "DEFEAT", Config.GameName, if won then Colors.Gold else Colors.HealthLow, 8)
	elseif kind == "Eliminated" then
		local hero = Heroes.Get(data.ByHero)
		if data.By then
			lastKiller = "by " .. data.By .. (if hero then " (" .. hero.DisplayName .. ")" else "")
		else
			lastKiller = ""
		end
	elseif kind == "KillConfirmed" then
		ui.KillConfirm.Text = "ELIMINATED  " .. string.upper(tostring(data.Victim or ""))
		ui.KillConfirm.Visible = true
		local text = ui.KillConfirm.Text
		task.delay(1.6, function()
			if ui.KillConfirm.Text == text then
				ui.KillConfirm.Visible = false
			end
		end)
	end
end

--------------------------------------------------------------------------------
-- Per-frame updates
--------------------------------------------------------------------------------

local function updateVitals(character: Model, humanoid: Humanoid, hero)
	ui.HeroName.Text = string.upper(hero.DisplayName)
	ui.HeroName.TextColor3 = hero.AccentColor
	local role = Heroes.Roles[hero.Role]
	ui.Role.Text = if role then role.Icon .. "  " .. role.Name else ""
	ui.Role.TextColor3 = if role then role.Color else Colors.Muted

	local maxHealth = math.max(1, humanoid.MaxHealth)
	local health = math.clamp(humanoid.Health, 0, maxHealth)
	local fraction = health / maxHealth
	ui.HealthNumber.Text = tostring(math.ceil(health))
	ui.HealthMax.Text = "/" .. tostring(math.floor(maxHealth))
	ui.HealthFill.Size = UDim2.fromScale(fraction, 1)
	ui.HealthFill.BackgroundColor3 = if fraction < 0.35 then Colors.HealthLow else Colors.Health

	local shield = character:GetAttribute("Shield") or 0
	ui.ShieldBack.Visible = shield > 0
	ui.ShieldFill.Size = UDim2.fromScale(math.clamp(shield / maxHealth, 0, 1), 1)
	ui.ShieldText.Text = if shield > 0 then "+" .. tostring(math.ceil(shield)) .. " SHIELD" else ""

	local effects = character:GetAttribute("Effects") or ""
	ui.Effects.Text = string.upper((string.gsub(effects, ",", "  •  ")))
end

local function updateAbilities(character: Model, hero, profile: Folder?, now: number)
	local synergies = if profile then profile:GetAttribute("Synergies") or "" else ""
	ui.Synergy.Text = if synergies ~= "" then "◆ TEAM-UP: " .. string.upper(synergies) else ""

	for _, slot in Heroes.AbilitySlots do
		local refs = ui.Slots[slot]
		local ability = hero.Abilities[slot]
		refs.Name.Text = string.upper(ability.Name)
		local denied = (deniedFlash[slot] or 0) > os.clock()

		if slot == "Ultimate" then
			local charge = if profile then profile:GetAttribute("UltCharge") or 0 else 0
			local ready = charge >= 100
			refs.Fill.Size = UDim2.fromScale(1, math.clamp(charge / 100, 0, 1))
			refs.Fill.BackgroundColor3 = hero.AccentColor
			refs.Cover.Visible = false
			refs.Icon.Text = if ready then (ability.Icon or "✦") else tostring(math.floor(charge)) .. "%"
			refs.Icon.TextSize = if ready then 34 else 22
			refs.Stroke.Color = if denied then Colors.HealthLow elseif ready then hero.AccentColor else Colors.Stroke
			refs.Stroke.Thickness = if ready then 2.5 + math.sin(os.clock() * 6) else 2
		else
			local remaining = (character:GetAttribute("CD_" .. slot) or 0) - now
			local cooling = remaining > 0
			refs.Icon.Text = ability.Icon or "◆"
			refs.Icon.TextColor3 = hero.AccentColor
			refs.Fill.Size = UDim2.fromScale(1, 0)
			refs.Cover.Visible = cooling
			refs.Count.Text = if cooling then tostring(math.ceil(remaining)) else ""
			refs.Stroke.Color = if denied then Colors.HealthLow elseif cooling then Colors.Stroke else hero.AccentColor
			refs.Stroke.Thickness = 2
		end
	end
end

local function updateAmmo(character: Model, hero)
	local weapon = hero.Primary
	ui.WeaponName.Text = string.upper(weapon.Name)
	if weapon.MagazineSize then
		ui.AmmoCount.Text = if character:GetAttribute("InfiniteAmmo") then "∞" else tostring(character:GetAttribute("Ammo") or 0)
		ui.AmmoMax.Text = "/" .. tostring(weapon.MagazineSize)
	else
		ui.AmmoCount.Text = "∞"
		ui.AmmoMax.Text = ""
	end
	ui.Reloading.Visible = character:GetAttribute("Reloading") == true
end

local function updateObjective(phase: string, now: number)
	local state = ClientState.MatchState
	local myTeam = ClientState.GetMyTeam() or Config.Teams[1].Name
	local enemyTeam = Config.GetOtherTeam(myTeam) or Config.Teams[2].Name

	for _, side in { { ui.LeftTeam, myTeam, "YOU" }, { ui.RightTeam, enemyTeam, "ENEMY" } } do
		local refs, team, label = side[1], side[2], side[3]
		local score = state:GetAttribute("Score_" .. team) or 0
		local color = Config.GetTeamColor(team)
		refs.Fill.Size = UDim2.fromScale(math.clamp(score / 100, 0, 1), 1)
		refs.Fill.BackgroundColor3 = color
		refs.Label.Text = label .. "  " .. tostring(math.floor(score)) .. "%"
		refs.Label.TextColor3 = Colors.Text
		local wins = state:GetAttribute("RoundWins_" .. team) or 0
		for index, dot in refs.Dots do
			dot.BackgroundColor3 = if index <= wins then color else Colors.PanelLight
		end
	end

	local owner = state:GetAttribute("PointOwner") or ""
	local locked = state:GetAttribute("PointLocked") ~= false
	local contested = state:GetAttribute("Contested") == true
	local overtime = state:GetAttribute("Overtime") == true
	local battle = phase == "Battle"

	local badgeText = "POINT"
	if battle then
		if locked then
			badgeText = "LOCKED"
		elseif overtime then
			badgeText = "OVERTIME"
		elseif contested then
			badgeText = "CONTESTED"
		elseif owner == myTeam then
			badgeText = "HOLDING"
		elseif owner ~= "" then
			badgeText = "ENEMY HOLDS"
		else
			badgeText = "NEUTRAL"
		end
	end
	ui.PointText.Text = badgeText
	ui.PointBadge.BackgroundColor3 = if owner ~= "" then Config.GetTeamColor(owner):Lerp(Colors.Panel, 0.45) else Colors.Panel
	local flashing = battle and (contested or overtime) and math.sin(os.clock() * 10) > 0
	ui.PointStroke.Color = if flashing then Colors.Gold else Colors.Stroke

	local captureTeam = state:GetAttribute("CaptureTeam") or ""
	local progress = state:GetAttribute("CaptureProgress") or 0
	ui.CaptureBack.Visible = battle and progress > 0
	ui.CaptureFill.Size = UDim2.fromScale(math.clamp(progress / 100, 0, 1), 1)
	ui.CaptureFill.BackgroundColor3 = Config.GetTeamColor(captureTeam)

	local round = state:GetAttribute("Round") or 0
	local timeLeft = ClientState.TimeLeft()
	local text = ""
	if phase == "Waiting" then
		text = "WAITING FOR PLAYERS"
	elseif phase == "Intermission" then
		text = "MATCH STARTS IN " .. UIKit.FormatTime(timeLeft)
	elseif phase == "Setup" then
		text = "ROUND " .. round .. "  •  DOORS OPEN IN " .. UIKit.FormatTime(timeLeft)
	elseif phase == "Battle" then
		if locked then
			text = "POINT UNLOCKS IN " .. UIKit.FormatTime((state:GetAttribute("PointUnlockAt") or 0) - now)
		else
			text = "ROUND " .. round
		end
	elseif phase == "RoundEnd" then
		text = "ROUND OVER"
	elseif phase == "MatchEnd" then
		text = "MATCH OVER  •  NEW MATCH SOON"
	end
	ui.PhaseText.Text = text
end

local function updateDeathPanel(profile: Folder?, phase: string, now: number, alive: boolean)
	local inMatch = phase == "Setup" or phase == "Battle" or phase == "RoundEnd"
	local show = false
	if profile and inMatch and not alive and not ClientState.IsMenuOpen("HeroSelect") then
		show = true
		local hasHero = (profile:GetAttribute("Hero") or "") ~= ""
		local respawnAt = profile:GetAttribute("RespawnAt") or 0
		local hotkey = Config.KeyLabels.HeroSelect
		if not hasHero then
			ui.DeathTitle.Text = "CHOOSE A HERO"
			ui.DeathTitle.TextColor3 = Colors.Text
			ui.DeathBy.Text = ""
			ui.DeathTimer.Text = ""
			ui.DeathHint.Text = "Press " .. hotkey .. " to open hero select"
		elseif respawnAt > now then
			ui.DeathTitle.Text = "ELIMINATED"
			ui.DeathTitle.TextColor3 = Colors.HealthLow
			ui.DeathBy.Text = lastKiller
			ui.DeathTimer.Text = "RESPAWN IN " .. tostring(math.ceil(respawnAt - now))
			ui.DeathHint.Text = "Press " .. hotkey .. " to change hero"
		else
			ui.DeathTitle.Text = "DEPLOYING"
			ui.DeathTitle.TextColor3 = Colors.Text
			ui.DeathBy.Text = ""
			ui.DeathTimer.Text = if phase == "RoundEnd" then "NEXT ROUND SOON" else ""
			ui.DeathHint.Text = "Press " .. hotkey .. " to change hero"
		end
	end
	ui.DeathPanel.Visible = show
end

local function update()
	local profile = ClientState.GetProfile()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local alive = humanoid ~= nil and humanoid.Health > 0
	local hero = character and Heroes.Get(character:GetAttribute("Hero"))
	local phase = ClientState.GetPhase()
	local now = workspace:GetServerTimeNow()

	local showCombat = alive and hero ~= nil
	ui.Vitals.Visible = showCombat
	ui.Abilities.Visible = showCombat
	ui.Ammo.Visible = showCombat
	ui.Crosshair.Visible = showCombat and not ClientState.IsMenuOpen()

	if showCombat then
		updateVitals(character, humanoid, hero)
		updateAbilities(character, hero, profile, now)
		updateAmmo(character, hero)
	end
	updateObjective(phase, now)
	updateDeathPanel(profile, phase, now, alive)
end

--------------------------------------------------------------------------------

function HUDController.Init()
	local playerGui = player:WaitForChild("PlayerGui")
	buildOverlay(playerGui)

	local gui = UIKit.Create("ScreenGui", {
		Name = "HUD",
		ResetOnSpawn = false,
		DisplayOrder = 1,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	})
	buildVitals(gui)
	buildAbilities(gui)
	buildAmmo(gui)
	buildObjective(gui)
	buildKillFeed(gui)
	buildBanner(gui)
	buildDeathPanel(gui)

	RunService.RenderStepped:Connect(update)

	Remotes.Notify.OnClientEvent:Connect(onNotify)

	Remotes.HitConfirm.OnClientEvent:Connect(function(data)
		if typeof(data) ~= "table" then
			return
		end
		local amount = tostring(data.Amount or 0)
		if data.Heal then
			if data.Position then
				FXController.DamageNumber(data.Position, "+" .. amount, Colors.Heal, false)
			end
			return
		end
		local color = if data.Kill then Colors.HealthLow elseif data.Headshot then Colors.Gold else WHITE
		flashHitMarker(color)
		if data.Position then
			FXController.DamageNumber(data.Position, amount, if data.Headshot then Colors.Gold else WHITE, data.Headshot)
		end
		FXController.PlaySound(Config.Sounds.HitMarker, nil, 0.25, if data.Kill then 0.8 elseif data.Headshot then 1.6 else 1.25)
	end)

	Remotes.Damaged.OnClientEvent:Connect(function(data)
		local amount = if typeof(data) == "table" and typeof(data.Amount) == "number" then data.Amount else 10
		ui.DamageFlash.BackgroundTransparency = math.clamp(0.9 - amount / 150, 0.6, 0.9)
		TweenService:Create(ui.DamageFlash, TweenInfo.new(0.35), { BackgroundTransparency = 1 }):Play()
	end)

	Remotes.FX.OnClientEvent:Connect(function(kind, data)
		if kind ~= "UltActivated" or typeof(data) ~= "table" then
			return
		end
		local ally = data.Team == ClientState.GetMyTeam()
		local hero = Heroes.Get(data.Hero)
		ui.UltFeed.Text = string.format(
			"%s %s%s: %s!",
			if ally then "ALLY" else "ENEMY",
			tostring(data.Name),
			if hero then " (" .. hero.DisplayName .. ")" else "",
			string.upper(tostring(data.Ability))
		)
		ui.UltFeed.TextColor3 = Config.GetTeamColor(data.Team)
		ui.UltFeed.Visible = true
		ultFeedToken += 1
		local token = ultFeedToken
		task.delay(2.5, function()
			if ultFeedToken == token then
				ui.UltFeed.Visible = false
			end
		end)
	end)

	ClientState.AbilityDenied:Connect(function(slot)
		deniedFlash[slot] = os.clock() + 0.25
	end)
end

return HUDController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">HeroSelectController</string>
              <string name="Source"><![CDATA[--[[
	HeroSelectController
	====================
	The hero select screen. It opens by itself when you need a hero (start of a match, or joining
	mid-match), and any time you press H. Pick a card, read its kit, press LOCK IN.
	The server decides if the swap happens right away (setup phase, in your spawn room, or while
	dead) or tells you to go back to spawn.
]]

local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Heroes = require(Shared.Heroes)
local Synergies = require(Shared.Synergies)
local Remotes = require(Shared.Remotes)

local ClientState = require(script.Parent.ClientState)
local UIKit = require(script.Parent.UIKit)

local player = Players.LocalPlayer
local Colors = UIKit.Colors
local Fonts = UIKit.Fonts

local HeroSelectController = {}

local gui: ScreenGui
local cards = {}
local detail = {}
local selectedId = nil
local pendingHero = nil
local dismissedThisPhase = false
local teamLabel, timerLabel, lockButton

local function currentHero(): string
	local profile = ClientState.GetProfile()
	return if profile then profile:GetAttribute("Hero") or "" else ""
end

local function selectHero(heroId: string)
	local hero = Heroes.Get(heroId)
	if not hero then
		return
	end
	selectedId = heroId
	for id, refs in cards do
		local isSelected = id == heroId
		refs.Stroke.Color = if isSelected then Heroes.Get(id).AccentColor else Colors.Stroke
		refs.Stroke.Thickness = if isSelected then 3 else 1
	end

	local role = Heroes.Roles[hero.Role]
	detail.Name.Text = string.upper(hero.DisplayName)
	detail.Name.TextColor3 = hero.AccentColor
	detail.Role.Text = role.Icon .. "  " .. role.Name .. "   •   " .. hero.Tagline
	detail.Role.TextColor3 = role.Color
	detail.Description.Text = hero.Description
	detail.Stats.Text = string.format("HEALTH %d   •   SPEED %s", hero.MaxHealth, tostring(hero.WalkSpeed))

	local rows = {
		{ Config.KeyLabels.Fire, hero.Primary.Name, hero.Primary.Description },
		{ Config.KeyLabels.Ability1, hero.Abilities.Ability1.Name, hero.Abilities.Ability1.Description },
		{ Config.KeyLabels.Ability2, hero.Abilities.Ability2.Name, hero.Abilities.Ability2.Description },
		{ Config.KeyLabels.Ultimate, hero.Abilities.Ultimate.Name .. "  (ULTIMATE)", hero.Abilities.Ultimate.Description },
	}
	for index, row in rows do
		local refs = detail.Rows[index]
		refs.Key.Text = row[1]
		refs.Title.Text = row[2]
		refs.Title.TextColor3 = if index == 4 then hero.AccentColor else Colors.Text
		refs.Body.Text = row[3]
	end

	local synergyLines = {}
	for _, synergy in Synergies.ForHero(heroId) do
		local partners = {}
		for _, other in synergy.Heroes do
			if other ~= heroId then
				local otherHero = Heroes.Get(other)
				table.insert(partners, if otherHero then otherHero.DisplayName else other)
			end
		end
		table.insert(synergyLines, string.format("◆ %s (with %s): %s", synergy.Name, table.concat(partners, ", "), synergy.Description))
	end
	detail.Synergies.Text = table.concat(synergyLines, "\n")

	lockButton.BackgroundColor3 = hero.AccentColor
	lockButton.TextColor3 = Color3.fromRGB(14, 16, 24)
	lockButton.Text = if currentHero() == heroId then "PLAYING" else "LOCK IN"
end

local function refreshTeamList()
	local myTeam = ClientState.GetMyTeam()
	local lines = {}
	for _, folder in ClientState.Combatants:GetChildren() do
		if myTeam and folder:GetAttribute("Team") == myTeam then
			local hero = Heroes.Get(folder:GetAttribute("Hero"))
			local name = if folder == ClientState.GetProfile() then "You" else tostring(folder:GetAttribute("DisplayName"))
			table.insert(lines, name .. " — " .. (if hero then hero.DisplayName else "choosing…"))
		end
	end
	table.sort(lines)
	teamLabel.Text = "YOUR TEAM:   " .. table.concat(lines, "    •    ")
end

local function open()
	if gui.Enabled or not ClientState.GetMyTeam() then
		return
	end
	gui.Enabled = true
	ClientState.SetMenu("HeroSelect", true)
	local current = currentHero()
	selectHero(if current ~= "" then current else (selectedId or Heroes.Order[1]))
	refreshTeamList()
	if UserInputService.GamepadEnabled and selectedId and cards[selectedId] then
		GuiService.SelectedObject = cards[selectedId].Button
	end
end

local function close()
	if not gui.Enabled then
		return
	end
	gui.Enabled = false
	pendingHero = nil
	ClientState.SetMenu("HeroSelect", false)
	if GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(gui) then
		GuiService.SelectedObject = nil
	end
end

local function lockIn()
	if not selectedId then
		return
	end
	if currentHero() == selectedId then
		close()
		return
	end
	pendingHero = selectedId
	lockButton.Text = "LOCKING IN…"
	Remotes.SelectHero:FireServer(selectedId)
	local requested = selectedId
	task.delay(1.5, function()
		-- If the server said no (e.g. "return to spawn"), let the player try again.
		if pendingHero == requested and gui.Enabled then
			pendingHero = nil
			lockButton.Text = "LOCK IN"
		end
	end)
end

local function shouldAutoOpen(): boolean
	local profile = ClientState.GetProfile()
	local phase = ClientState.GetPhase()
	local inMatch = phase == "Setup" or phase == "Battle" or phase == "RoundEnd"
	return profile ~= nil and inMatch and currentHero() == "" and ClientState.GetMyTeam() ~= nil
end

local function evaluate()
	if shouldAutoOpen() and not dismissedThisPhase then
		open()
	end
	if gui.Enabled and pendingHero and currentHero() == pendingHero then
		close()
	end
end

--------------------------------------------------------------------------------
-- Building
--------------------------------------------------------------------------------

local function buildCard(parent: Instance, hero, order: number)
	local role = Heroes.Roles[hero.Role]
	local button = UIKit.Button({
		Name = hero.Id,
		Size = UDim2.fromOffset(196, 196),
		BackgroundColor3 = Colors.Panel,
		Text = "",
		LayoutOrder = order,
		Parent = parent,
	})
	UIKit.Corner(button, 12)
	local stroke = UIKit.Stroke(button, Colors.Stroke, 1)

	-- White background: a UIGradient multiplies with it, so the gradient shows the true hero colours.
	local band = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 100), BackgroundColor3 = Color3.new(1, 1, 1), Parent = button })
	UIKit.Corner(band, 12)
	UIKit.Create("UIGradient", {
		Color = ColorSequence.new(hero.Color, hero.AccentColor),
		Rotation = 35,
		Parent = band,
	})
	UIKit.Text({ Size = UDim2.fromScale(1, 1), Font = Fonts.Black, TextSize = 72, TextTransparency = 0.1, Text = string.sub(hero.DisplayName, 1, 1), Parent = band })
	UIKit.Text({
		Position = UDim2.fromOffset(10, 8),
		Size = UDim2.fromOffset(150, 14),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextSize = 11,
		Font = Fonts.Black,
		Text = role.Icon .. " " .. role.Name,
		Parent = band,
	})
	UIKit.Text({ Position = UDim2.fromOffset(0, 106), Size = UDim2.new(1, 0, 0, 26), Font = Fonts.Black, TextSize = 22, Text = string.upper(hero.DisplayName), Parent = button })
	UIKit.Text({
		Position = UDim2.fromOffset(10, 134),
		Size = UDim2.new(1, -20, 0, 30),
		TextSize = 12,
		TextColor3 = Colors.Muted,
		TextWrapped = true,
		Font = Fonts.Medium,
		Text = hero.Tagline,
		Parent = button,
	})
	UIKit.Text({ Position = UDim2.fromOffset(0, 168), Size = UDim2.new(1, 0, 0, 18), TextSize = 12, TextColor3 = role.Color, Text = hero.MaxHealth .. " HP", Parent = button })

	button.Activated:Connect(function()
		selectHero(hero.Id)
	end)
	cards[hero.Id] = { Button = button, Stroke = stroke }
end

local function build(playerGui: PlayerGui)
	gui = UIKit.Create("ScreenGui", {
		Name = "HeroSelect",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 10,
		Enabled = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	})
	UIKit.Frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(6, 8, 14), BackgroundTransparency = 0.18, Parent = gui })

	local root = UIKit.Frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(1100, 660),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	UIKit.AutoScale(root)

	UIKit.Text({ Size = UDim2.fromOffset(600, 18), TextXAlignment = Enum.TextXAlignment.Left, TextSize = 14, TextColor3 = Colors.Muted, Text = Config.GameName, Parent = root })
	UIKit.Text({ Position = UDim2.fromOffset(0, 18), Size = UDim2.fromOffset(700, 40), TextXAlignment = Enum.TextXAlignment.Left, Font = Fonts.Black, TextSize = 36, Text = "CHOOSE YOUR HERO", Parent = root })
	timerLabel = UIKit.Text({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -56, 0, 22), Size = UDim2.fromOffset(400, 32), TextXAlignment = Enum.TextXAlignment.Right, Font = Fonts.Black, TextSize = 22, TextColor3 = Colors.Gold, Parent = root })
	local closeButton = UIKit.Button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 18), Size = UDim2.fromOffset(44, 44), Text = "✕", TextSize = 22, Parent = root })
	UIKit.Corner(closeButton, 8)
	closeButton.Activated:Connect(function()
		dismissedThisPhase = true
		close()
	end)

	local row = UIKit.Frame({ Position = UDim2.fromOffset(0, 74), Size = UDim2.new(1, 0, 0, 196), BackgroundTransparency = 1, Parent = root })
	UIKit.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 14),
		Parent = row,
	})
	for index, hero in Heroes.GetOrdered() do
		buildCard(row, hero, index)
	end

	local panel = UIKit.Frame({ Position = UDim2.fromOffset(0, 284), Size = UDim2.new(1, 0, 0, 300), BackgroundColor3 = Colors.Panel, BackgroundTransparency = 0.12, Parent = root })
	UIKit.Corner(panel, 12)
	UIKit.Stroke(panel, Colors.Stroke, 1, 0.4)
	detail.Name = UIKit.Text({ Position = UDim2.fromOffset(24, 18), Size = UDim2.fromOffset(420, 40), TextXAlignment = Enum.TextXAlignment.Left, Font = Fonts.Black, TextSize = 38, Parent = panel })
	detail.Role = UIKit.Text({ Position = UDim2.fromOffset(24, 60), Size = UDim2.fromOffset(420, 18), TextXAlignment = Enum.TextXAlignment.Left, TextSize = 13, Parent = panel })
	detail.Description = UIKit.Text({
		Position = UDim2.fromOffset(24, 88),
		Size = UDim2.fromOffset(420, 64),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		Font = Fonts.Medium,
		TextSize = 15,
		Parent = panel,
	})
	detail.Stats = UIKit.Text({ Position = UDim2.fromOffset(24, 156), Size = UDim2.fromOffset(420, 18), TextXAlignment = Enum.TextXAlignment.Left, TextSize = 13, TextColor3 = Colors.Muted, Parent = panel })
	detail.Synergies = UIKit.Text({
		Position = UDim2.fromOffset(24, 184),
		Size = UDim2.fromOffset(420, 100),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		Font = Fonts.Medium,
		TextSize = 12,
		TextColor3 = Colors.Gold,
		Parent = panel,
	})

	detail.Rows = {}
	for index = 1, 4 do
		local y = 18 + (index - 1) * 68
		local key = UIKit.Text({
			Position = UDim2.fromOffset(470, y),
			Size = UDim2.fromOffset(64, 26),
			BackgroundTransparency = 0,
			BackgroundColor3 = Colors.PanelLight,
			Font = Fonts.Black,
			TextSize = 12,
			Parent = panel,
		})
		UIKit.Corner(key, 6)
		local title = UIKit.Text({ Position = UDim2.fromOffset(548, y), Size = UDim2.fromOffset(520, 22), TextXAlignment = Enum.TextXAlignment.Left, Font = Fonts.Black, TextSize = 17, Parent = panel })
		local body = UIKit.Text({
			Position = UDim2.fromOffset(548, y + 24),
			Size = UDim2.fromOffset(520, 36),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextWrapped = true,
			Font = Fonts.Medium,
			TextSize = 13,
			TextColor3 = Colors.Muted,
			Parent = panel,
		})
		detail.Rows[index] = { Key = key, Title = title, Body = body }
	end

	teamLabel = UIKit.Text({
		Position = UDim2.fromOffset(0, 600),
		Size = UDim2.new(1, -260, 0, 44),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		TextSize = 13,
		TextColor3 = Colors.Muted,
		Parent = root,
	})
	lockButton = UIKit.Button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 596),
		Size = UDim2.fromOffset(240, 56),
		TextSize = 24,
		Text = "LOCK IN",
		Parent = root,
	})
	UIKit.Corner(lockButton, 10)
	lockButton.Activated:Connect(lockIn)
end

--------------------------------------------------------------------------------

function HeroSelectController.Init()
	build(player:WaitForChild("PlayerGui"))

	-- H toggles the screen (phones and tablets get an on-screen "Hero" button).
	ContextActionService:BindAction("HS_HeroSelect", function(_, state)
		if state == Enum.UserInputState.Begin then
			if gui.Enabled then
				dismissedThisPhase = true
				close()
			else
				open()
			end
		end
		return Enum.ContextActionResult.Pass
	end, true, table.unpack(Config.Controls.HeroSelect))
	ContextActionService:SetTitle("HS_HeroSelect", "Hero")

	ClientState.MatchState:GetAttributeChangedSignal("Phase"):Connect(function()
		dismissedThisPhase = false
		evaluate()
	end)

	local function watchProfile(profile: Instance)
		if profile.Name ~= "P" .. player.UserId then
			return
		end
		profile:GetAttributeChangedSignal("Hero"):Connect(function()
			if not gui.Enabled then
				dismissedThisPhase = false
			end
			evaluate()
			if gui.Enabled and selectedId then
				selectHero(selectedId)
			end
		end)
		profile:GetAttributeChangedSignal("Team"):Connect(evaluate)
		evaluate()
	end
	ClientState.Combatants.ChildAdded:Connect(watchProfile)
	local existing = ClientState.GetProfile()
	if existing then
		watchProfile(existing)
	end

	local lastRefresh = 0
	RunService.RenderStepped:Connect(function()
		if not gui.Enabled then
			return
		end
		local phase = ClientState.GetPhase()
		local timeLeft = ClientState.TimeLeft()
		timerLabel.Text = if phase == "Setup" and timeLeft then "DOORS OPEN IN " .. UIKit.FormatTime(timeLeft) else ""
		if os.clock() - lastRefresh > 0.5 then
			lastRefresh = os.clock()
			refreshTeamList()
		end
	end)
end

return HeroSelectController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">NameplateController</string>
              <string name="Source"><![CDATA[--[[
	NameplateController
	===================
	Floating name + health bar over every other fighter, and a coloured outline:
	  allies   blue outline and nameplate visible through walls (so you can find your team)
	  enemies  red outline, only when you can actually see them
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Heroes = require(Shared.Heroes)
local CombatUtil = require(Shared.CombatUtil)

local ClientState = require(script.Parent.ClientState)
local UIKit = require(script.Parent.UIKit)

local player = Players.LocalPlayer

local NameplateController = {}

local plates = {} -- [character] = { Billboard, Highlight, Fill, Name }

local function displayName(character: Model): string
	local profile = ClientState.Combatants:FindFirstChild(tostring(character:GetAttribute("CombatantId")))
	local name = if profile then tostring(profile:GetAttribute("DisplayName")) else character.Name
	local hero = Heroes.Get(character:GetAttribute("Hero"))
	return if hero then string.upper(hero.DisplayName) .. "  " .. name else name
end

local function create(character: Model, playerGui: PlayerGui)
	local head = character:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then
		return nil
	end
	local billboard = UIKit.Create("BillboardGui", {
		Name = "Nameplate",
		Adornee = head,
		Size = UDim2.fromOffset(150, 34),
		StudsOffset = Vector3.new(0, 2.6, 0),
		LightInfluence = 0,
		MaxDistance = 220,
		ResetOnSpawn = false,
		Parent = playerGui,
	})
	local name = UIKit.Text({
		Size = UDim2.new(1, 0, 0, 18),
		TextSize = 13,
		Font = UIKit.Fonts.Black,
		TextStrokeTransparency = 0.4,
		Parent = billboard,
	})
	local back = UIKit.Frame({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 22),
		Size = UDim2.fromOffset(110, 7),
		BackgroundColor3 = Color3.fromRGB(15, 15, 20),
		BackgroundTransparency = 0.3,
		Parent = billboard,
	})
	UIKit.Corner(back, 3)
	local fill = UIKit.Frame({ Size = UDim2.fromScale(1, 1), Parent = back })
	UIKit.Corner(fill, 3)

	local highlight = UIKit.Create("Highlight", {
		Adornee = character,
		FillTransparency = 1,
		OutlineTransparency = 0.15,
		Parent = character,
	})
	return { Billboard = billboard, Highlight = highlight, Fill = fill, Name = name }
end

local function refresh(playerGui: PlayerGui)
	local myTeam = ClientState.GetMyTeam()
	local seen = {}
	for _, character in CombatUtil.GetAllCharacters() do
		if character ~= player.Character then
			seen[character] = true
			local plate = plates[character] or create(character, playerGui)
			plates[character] = plate
			if plate then
				local team = character:GetAttribute("Team")
				local ally = myTeam ~= nil and team == myTeam
				local color = Config.GetTeamColor(team)
				local humanoid = CombatUtil.GetHumanoid(character)
				local alive = humanoid ~= nil and humanoid.Health > 0

				plate.Billboard.Enabled = alive
				plate.Billboard.AlwaysOnTop = ally
				plate.Name.Text = displayName(character)
				plate.Name.TextColor3 = color
				if humanoid then
					plate.Fill.Size = UDim2.fromScale(math.clamp(humanoid.Health / math.max(1, humanoid.MaxHealth), 0, 1), 1)
				end
				plate.Fill.BackgroundColor3 = color
				plate.Highlight.Enabled = alive
				plate.Highlight.OutlineColor = color
				plate.Highlight.DepthMode = if ally then Enum.HighlightDepthMode.AlwaysOnTop else Enum.HighlightDepthMode.Occluded
			end
		end
	end
	for character, plate in plates do
		if not seen[character] then
			plate.Billboard:Destroy()
			plate.Highlight:Destroy()
			plates[character] = nil
		end
	end
end

function NameplateController.Init()
	local playerGui = player:WaitForChild("PlayerGui")
	task.spawn(function()
		while true do
			local ok, err = pcall(refresh, playerGui)
			if not ok then
				warn("[Nameplates] " .. tostring(err))
			end
			task.wait(0.1)
		end
	end)
end

return NameplateController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">ScoreboardController</string>
              <string name="Source"><![CDATA[--[[
	ScoreboardController
	====================
	Hold TAB (gamepad: press Select) to see both teams: hero, kills, deaths, assists, damage, healing.
	Reads the profile folders the server keeps in ReplicatedStorage.Combatants.
]]

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Heroes = require(Shared.Heroes)

local ClientState = require(script.Parent.ClientState)
local UIKit = require(script.Parent.UIKit)

local player = Players.LocalPlayer
local Colors = UIKit.Colors
local Fonts = UIKit.Fonts

local ScoreboardController = {}

local COLUMNS = {
	{ Title = "PLAYER", Width = 250, Align = Enum.TextXAlignment.Left },
	{ Title = "HERO", Width = 130, Align = Enum.TextXAlignment.Left },
	{ Title = "K", Width = 60 },
	{ Title = "D", Width = 60 },
	{ Title = "A", Width = 60 },
	{ Title = "DAMAGE", Width = 100 },
	{ Title = "HEALING", Width = 100 },
}
local ROW_HEIGHT = 30

local gui: ScreenGui
local title: TextLabel
local sections = {}
local refreshing = false

local function makeRow(parent: Instance, values, color: Color3, highlight: boolean, order: number)
	local row = UIKit.Frame({
		Size = UDim2.new(1, 0, 0, ROW_HEIGHT),
		BackgroundColor3 = if highlight then Colors.PanelLight else Colors.Panel,
		BackgroundTransparency = if highlight then 0.1 else 0.5,
		LayoutOrder = order,
		Parent = parent,
	})
	UIKit.Corner(row, 6)
	local x = 12
	for index, column in COLUMNS do
		UIKit.Text({
			Position = UDim2.fromOffset(x, 0),
			Size = UDim2.fromOffset(column.Width, ROW_HEIGHT),
			TextXAlignment = column.Align or Enum.TextXAlignment.Center,
			Text = values[index],
			TextColor3 = if index == 1 then color else Colors.Text,
			Font = if index == 1 then Fonts.Black else Fonts.Bold,
			TextSize = 14,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = row,
		})
		x += column.Width
	end
	return row
end

local function refresh()
	local myTeam = ClientState.GetMyTeam() or Config.Teams[1].Name
	local order = { myTeam, Config.GetOtherTeam(myTeam) or Config.Teams[2].Name }
	local round = ClientState.MatchState:GetAttribute("Round") or 0
	title.Text = Config.GameName .. (if round > 0 then "   •   ROUND " .. round else "")

	for index, team in order do
		local section = sections[index]
		local color = Config.GetTeamColor(team)
		section.Header.Text = (if team == myTeam then "YOUR TEAM" else "ENEMY TEAM") .. "  —  " .. (Config.GetTeam(team) or { DisplayName = team }).DisplayName
		section.Header.TextColor3 = color
		for _, child in section.List:GetChildren() do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end

		local members = {}
		for _, folder in ClientState.Combatants:GetChildren() do
			if folder:GetAttribute("Team") == team then
				table.insert(members, folder)
			end
		end
		table.sort(members, function(a, b)
			return (a:GetAttribute("Kills") or 0) > (b:GetAttribute("Kills") or 0)
		end)
		for position, folder in members do
			local hero = Heroes.Get(folder:GetAttribute("Hero"))
			makeRow(section.List, {
				tostring(folder:GetAttribute("DisplayName")),
				if hero then hero.DisplayName else "—",
				tostring(folder:GetAttribute("Kills") or 0),
				tostring(folder:GetAttribute("Deaths") or 0),
				tostring(folder:GetAttribute("Assists") or 0),
				tostring(math.floor(folder:GetAttribute("Damage") or 0)),
				tostring(math.floor(folder:GetAttribute("Healing") or 0)),
			}, color, folder == ClientState.GetProfile(), position)
		end
	end
end

-- Not a "menu": you can keep aiming and shooting while you peek at the scores.
local function setOpen(open: boolean)
	gui.Enabled = open
	if open and not refreshing then
		refreshing = true
		task.spawn(function()
			while gui.Enabled do
				refresh()
				task.wait(0.5)
			end
			refreshing = false
		end)
	end
end

local function build(playerGui: PlayerGui)
	gui = UIKit.Create("ScreenGui", { Name = "Scoreboard", ResetOnSpawn = false, DisplayOrder = 5, Enabled = false, Parent = playerGui })
	local panel = UIKit.Frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(800, 560),
		BackgroundColor3 = Colors.Panel,
		BackgroundTransparency = 0.08,
		Parent = gui,
	})
	UIKit.Corner(panel, 12)
	UIKit.Stroke(panel, Colors.Stroke, 1, 0.4)
	UIKit.AutoScale(panel)

	title = UIKit.Text({ Position = UDim2.fromOffset(20, 12), Size = UDim2.new(1, -40, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, Font = Fonts.Black, TextSize = 24, Parent = panel })

	local header = UIKit.Frame({ Position = UDim2.fromOffset(20, 48), Size = UDim2.new(1, -40, 0, 20), BackgroundTransparency = 1, Parent = panel })
	local x = 12
	for _, column in COLUMNS do
		UIKit.Text({
			Position = UDim2.fromOffset(x, 0),
			Size = UDim2.fromOffset(column.Width, 20),
			TextXAlignment = column.Align or Enum.TextXAlignment.Center,
			Text = column.Title,
			TextSize = 12,
			TextColor3 = Colors.Muted,
			Parent = header,
		})
		x += column.Width
	end

	for index = 1, 2 do
		local top = 74 + (index - 1) * 240
		local sectionHeader = UIKit.Text({ Position = UDim2.fromOffset(20, top), Size = UDim2.new(1, -40, 0, 22), TextXAlignment = Enum.TextXAlignment.Left, Font = Fonts.Black, TextSize = 15, Parent = panel })
		local list = UIKit.Frame({ Position = UDim2.fromOffset(20, top + 26), Size = UDim2.new(1, -40, 0, 206), BackgroundTransparency = 1, Parent = panel })
		UIKit.Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4), Parent = list })
		sections[index] = { Header = sectionHeader, List = list }
	end
end

function ScoreboardController.Init()
	build(player:WaitForChild("PlayerGui"))
	ContextActionService:BindAction("HS_Scoreboard", function(_, state, input)
		local isGamepad = input.KeyCode == Enum.KeyCode.ButtonSelect
		if state == Enum.UserInputState.Begin then
			setOpen(if isGamepad then not gui.Enabled else true)
		elseif state == Enum.UserInputState.End and not isGamepad then
			setOpen(false)
		end
		return Enum.ContextActionResult.Pass
	end, false, table.unpack(Config.Controls.Scoreboard))
end

return ScoreboardController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">UIKit</string>
              <string name="Source"><![CDATA[--[[
	UIKit
	=====
	Tiny helpers for building UI in code, plus automatic scaling: every panel is designed for a
	1280x720 screen and shrinks or grows to fit phones, tablets and large monitors.
]]

local UIKit = {}

UIKit.Colors = {
	Panel = Color3.fromRGB(12, 14, 22),
	PanelLight = Color3.fromRGB(30, 34, 48),
	Stroke = Color3.fromRGB(72, 80, 102),
	Text = Color3.fromRGB(242, 244, 250),
	Muted = Color3.fromRGB(160, 167, 186),
	Health = Color3.fromRGB(232, 238, 246),
	HealthLow = Color3.fromRGB(255, 86, 76),
	Shield = Color3.fromRGB(120, 220, 255),
	Gold = Color3.fromRGB(255, 206, 92),
	Heal = Color3.fromRGB(120, 255, 160),
}

UIKit.Fonts = {
	Black = Enum.Font.GothamBlack,
	Bold = Enum.Font.GothamBold,
	Medium = Enum.Font.GothamMedium,
	Regular = Enum.Font.Gotham,
}

-- Creates an instance, sets properties, then parents it (Parent is applied last).
function UIKit.Create(className: string, props)
	local instance = Instance.new(className)
	for key, value in props or {} do
		if key ~= "Parent" then
			instance[key] = value
		end
	end
	if props and props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

function UIKit.Frame(props)
	props.BorderSizePixel = 0
	return UIKit.Create("Frame", props)
end

function UIKit.Text(props)
	local merged = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = UIKit.Fonts.Bold,
		TextColor3 = UIKit.Colors.Text,
		TextSize = 16,
		Text = "",
	}
	for key, value in props do
		merged[key] = value
	end
	return UIKit.Create("TextLabel", merged)
end

function UIKit.Button(props)
	local merged = {
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Font = UIKit.Fonts.Black,
		TextColor3 = UIKit.Colors.Text,
		TextSize = 18,
		BackgroundColor3 = UIKit.Colors.PanelLight,
	}
	for key, value in props do
		merged[key] = value
	end
	return UIKit.Create("TextButton", merged)
end

function UIKit.Corner(parent: Instance, radius: number?)
	return UIKit.Create("UICorner", { CornerRadius = UDim.new(0, radius or 8), Parent = parent })
end

function UIKit.Stroke(parent: Instance, color: Color3?, thickness: number?, transparency: number?)
	return UIKit.Create("UIStroke", {
		Color = color or UIKit.Colors.Stroke,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function UIKit.FormatTime(seconds: number?): string
	local total = math.max(0, math.ceil(seconds or 0))
	return string.format("%d:%02d", math.floor(total / 60), total % 60)
end

--------------------------------------------------------------------------------
-- Auto scaling
--------------------------------------------------------------------------------
local scales = {}
local currentScale = 1

local function computeScale(): number
	local camera = workspace.CurrentCamera
	local size = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	if size.X < 2 or size.Y < 2 then
		return 1
	end
	return math.clamp(math.min(size.X / 1280, size.Y / 720), 0.55, 1.3)
end

local function rescale()
	currentScale = computeScale()
	for _, scale in scales do
		scale.Scale = currentScale
	end
end

-- Adds a UIScale that keeps `guiObject` sized for the current screen (scales around its AnchorPoint).
function UIKit.AutoScale(guiObject: GuiObject)
	local scale = Instance.new("UIScale")
	scale.Scale = currentScale
	scale.Parent = guiObject
	table.insert(scales, scale)
	return scale
end

local cameraConnection = nil
local function watchCamera()
	if cameraConnection then
		cameraConnection:Disconnect()
	end
	local camera = workspace.CurrentCamera
	if camera then
		cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	end
	rescale()
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
watchCamera()

return UIKit
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="57">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--[[
	Client entry point
	==================
	Hides the default Roblox UI we replace, then starts each controller in ./Controllers.
]]

local StarterGui = game:GetService("StarterGui")

local Controllers = script.Parent:WaitForChild("Controllers")

-- Our own scoreboard uses Tab, and our HUD shows health; heroes don't use the backpack.
for _, coreGui in { Enum.CoreGuiType.PlayerList, Enum.CoreGuiType.Health, Enum.CoreGuiType.Backpack } do
	pcall(function()
		StarterGui:SetCoreGuiEnabled(coreGui, false)
	end)
end

local FXController = require(Controllers.FXController)
local CameraController = require(Controllers.CameraController)
local CombatController = require(Controllers.CombatController)
local HUDController = require(Controllers.HUDController)
local HeroSelectController = require(Controllers.HeroSelectController)
local ScoreboardController = require(Controllers.ScoreboardController)
local NameplateController = require(Controllers.NameplateController)

FXController.Init()
CameraController.Init()
CombatController.Init()
HUDController.Init()
HeroSelectController.Init()
ScoreboardController.Init()
NameplateController.Init()
]]></string>
          </Properties>
